+                // sobrevive ao compilador não serve para o que ele existe:
+                // responder "este binário é o patchado?" depois de um
+                // `apt upgrade`. É a mesma disciplina dos marcadores
+                // `AURORA-*-PATCH-*` do cosmic-comp.
+                const MARCA: &str = "MEOW-FILES-WALLPAPER-PATCH-1";
+                let mut command = process::Command::new("meow");
+                command.arg("wallpaper").arg(arg);
+                match spawn_detached(&mut command) {
