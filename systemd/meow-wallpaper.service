# meow-wallpaper.service — reafirma o carrossel, e só ele.
#
# O QUE ELE FAZ: `scripts/wallpaper.sh aplicar`. Lê os arquivos de
# `com.system76.CosmicBackground/v1` e escreve quando a saída aponta para
# qualquer lugar que não seja o nosso acervo — a pasta de FÁBRICA ou qualquer
# outra —, dizendo no log qual caminho substituiu. A ÚNICA exceção é o caminho
# que ela autorizou em `WALLPAPER_FONTES_PERMITIDAS`: aí o script devolve 4 e
# não toca em nada. Até 11/08/2026 a exceção era "qualquer lugar que não fosse
# a fábrica", e o resultado foi este serviço devolvendo 4 a cada 15 minutos por
# dois dias enquanto o carrossel estava desligado (Sprint M).
#
# NÃO NOTIFICA, DE PROPÓSITO
#   O `meow-doctor.service` avisa quando conserta porque um reparo diário é
#   evento raro. Aqui o relógio bate a cada 15 minutos: pendurar um
#   `notify-send` no `ExecStopPost` transformaria uma correção silenciosa e
#   correta numa fonte de ruído — e o aviso que se aprende a ignorar é pior que
#   nenhum. O rastro fica no log do MeowSystem, que o `meow log` mostra.
#
# CÓDIGOS: 0 já estava certo · 1 consertou · 3 falta dependência (menos de duas
# imagens no acervo) · 4 escolha dela. Nenhum deles é falha, e por isso os
# quatro entram no `SuccessExitStatus` — sem isso a unidade apareceria como
# `failed` no `systemctl --user status` justamente quando fez o certo.
#
# `$R` SIM, `${R}` NÃO: o systemd expande `${NOME}` na linha de `Exec` mesmo
# dentro de aspas simples, e variável que ele não conhece vira string vazia.
#
# ConditionPathExists no ponteiro da raiz: se `/mnt/Apate` estiver desmontado, a
# unidade é PULADA com o motivo no journal, em vez de falhar de 15 em 15 minutos
# para sempre. O ponteiro mora em `/home`, que está sempre montado.

# AGORA ELE TEM DOIS GATILHOS (25/08/2026)
#   Além do `meow-wallpaper.timer` de 15 minutos, o `meow-fundo.path` acorda
#   este mesmo serviço no INSTANTE em que a config de fundo do COSMIC muda.
#   Motivo medido no cabeçalho daquele arquivo: abrir a janela de papel de
#   parede — só abrir, sem clicar — reseta a saída ativa para
#   `/usr/share/backgrounds` + `Alphanumeric`. O relógio já consertava isso, em
#   até 15 minutos; o gatilho conserta em segundos. O `StartLimit` abaixo existe
#   por causa dele: relógio nunca estoura burst, gatilho pode.

[Unit]
Description=MeowSystem — reafirma o carrossel de papéis de parede
Documentation=file:%h/.local/state/meowsystem/raiz
ConditionPathExists=%h/.local/state/meowsystem/raiz
# O serviço escreve no diretório que o `meow-fundo.path` vigia — a receita de
# laço. MEDIDO em 25/08/2026, com um reset de fábrica simulado na saída
# DESCONECTADA (`output.HDMI-A-1`, para não mexer na TV dela): UM start, não
# dois. O eco da escrita do próprio reparo chega enquanto a unidade ainda está
# em `activating` (por causa do `sleep 2` abaixo) e o systemd o funde no
# `JOB_START` que já está correndo, em vez de enfileirar outro.
#
# 20 em 5 min é folga larguíssima para esse teto de um; serve para uma sequência
# de trocas de monitor sem nunca desarmar o vigia, que é o que um burst
# estourado faria (unidade em `failed` e `.path` parado junto — o modo de falha
# calado que este projeto não aceita).
StartLimitIntervalSec=300s
StartLimitBurst=20

[Service]
Type=oneshot

# O LOCK, QUE ATÉ AQUI SÓ VALIA PARA A MÃO DELA
#   `meow_travar` (lib/comum.sh) existe e é chamado em dez pontos do
#   `bin/meow` — mas em NENHUM script de `scripts/`. Como esta unidade chama o
#   `wallpaper.sh` direto, o relógio de 15 em 15 minutos podia entrar no meio de
#   um `meow doctor --consertar` (que também chama `wallpaper.sh aplicar`, agora
#   sob o lock) sem nada para segurá-lo. O `flock(1)` do util-linux usa o mesmo
#   `flock(2)` do `meow_travar`, sobre o MESMO arquivo — os dois lados se veem.
#
#   `-E 0` E NÃO `SuccessExitStatus`: sem ele o `flock` sai 1 quando o lock está
#   ocupado, e 1 aqui é o código de "consertei". Neste serviço só sujaria o log;
#   no `meow-assets.service` irmão, cujo `ExecStopPost` dispara `notify-send`
#   exatamente em `EXIT_STATUS=1`, daria um aviso FALSO na tela dela. Com
#   `-E 0` ceder a vez sai 0 — silêncio, que é o certo: quem está com o lock vai
#   fazer o mesmo trabalho, e o relógio bate de novo em 15 minutos.
#
#   O `mkdir` é do mesmo motivo do `append:` do irmão: o `flock` cria o arquivo
#   de lock, mas não o diretório, e numa máquina onde o `install.sh` ainda não
#   passou ele não existe. Prefixo `-` para não falhar por causa disso.
ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
# A LISTA DE `export` ERA PARTE DA FRONTEIRA — E ERA TAMBÉM A ARMADILHA Nº 3
#   Havia aqui nove nomes `WALLPAPER_*` digitados à mão. O aviso que estava
#   escrito neste lugar continua valendo e é grave: uma chave de fora da lista
#   chega VAZIA no script, e o efeito não é "não funciona" — é este serviço
#   desfazendo a escolha que ela acabou de autorizar com
#   `meow wallpaper permitir`. Só que a defesa era a própria lista, e lista fixa
#   é o modo de falha nº 3 do idempotencia-armadilhas.md. Em 25/08/2026 ele
#   cobrou: seis chaves `FORMA_*` novas ficaram mortas no `bin/meow` por
#   exatamente isso, e o `doctor` dizia "já conforme" sem ter conferido nada.
#   `set -a` exporta TUDO o que o meow.conf definir, então chave nova nasce
#   valendo. É a mesma cura aplicada no `carregar_conf` do `bin/meow`.
#
#   `set -a` FUNCIONA MESMO NO `/bin/sh` DO SYSTEMD? Sim, e foi conferido, não
#   suposto: aqui o `/bin/sh` é o dash (`/bin/sh -> dash`), e o `set -a` do
#   POSIX marca para exportação toda atribuição FEITA DEPOIS dele — o que inclui
#   as do arquivo lido por `.`. Testado com um conf de duas chaves:
#       $ sh -c 'C=t.conf; set -a; . "$C"; set +a; R=x; env | grep -E "^(FOO_NOVA|R)="'
#       FOO_NOVA=valor-novo            <- chave que NÃO estava em lista nenhuma
#       (nada de R)                    <- atribuição depois do `set +a` não vaza
#   O `R=$(cat …/raiz)` fica de fora do `set -a` de propósito: é variável de
#   trabalho desta linha, não configuração dela.
#
#   O QUE `set -a` ALARGA, e é o preço a saber: agora TODA chave do meow.conf
#   vira variável de ambiente do `wallpaper.sh`, não só as `WALLPAPER_*`. É
#   seguro hoje porque o script fixa os próprios caminhos incondicionalmente
#   (`BG=`, `LUZ_TSV=` etc. não têm `${…:-}`), mas uma chave futura com nome de
#   variável interna do script passaria a mandar nela. Nome de chave nova
#   continua sendo decisão com consequência.
#
# O `sleep 2` É DEBOUNCE, E É POR ISSO QUE NÃO HÁ LAÇO (medido em 25/08/2026)
#   Ele mantém a unidade em `activating` por 2 s depois do disparo. A escrita do
#   próprio reparo cai dentro dessa janela, e o systemd funde o evento no
#   `JOB_START` que já está correndo em vez de agendar outra execução: o
#   experimento controlado deu UM start por evento, não dois. Ver o cabeçalho do
#   `meow-fundo.path`.
#
#   E ele NÃO atrapalha o relógio de 15 minutos: 2 s a mais num tique que só lê
#   cinco arquivos pequenos e quase sempre não escreve nada é invisível — o
#   journal mostra os tiques da manhã terminando no MESMO segundo em que
#   começavam, e os de hoje à tarde, com o `sleep`, em 2,1 s.
ExecStartPre=-/usr/bin/sleep 2
ExecStart=/usr/bin/flock -n -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'C=%h/.config/meow/meow.conf; set -a; [ -f "$C" ] && . "$C"; set +a; R=$(cat %h/.local/state/meowsystem/raiz 2>/dev/null); [ -x "$R/scripts/wallpaper.sh" ] || exit 0; exec "$R/scripts/wallpaper.sh" aplicar'

SuccessExitStatus=1 3 4

# `TimeoutStartSec=2min` — E ELE É OBRIGATÓRIO AQUI, NÃO ZELO
#   `Type=oneshot` NÃO herda o `DefaultTimeoutStartSec`: o padrão dele é
#   `infinity`. Medido em 31/08/2026 nesta máquina, com a unidade viva e SEM esta
#   linha — o mesmo par de comandos que provou o buraco no `meow-leitura.service`
#   hoje de manhã:
#       systemctl --user show -p DefaultTimeoutStartUSec  ->  1min 30s
#       systemctl --user show meow-wallpaper.service -p TimeoutStartUSec
#                                                    ->  TimeoutStartUSec=infinity
#   Um `wallpaper.sh` travado ficaria em `activating (start)` PARA SEMPRE, e o
#   systemd não redispara unidade cujo job ainda está correndo — nem pelo
#   relógio, nem pelo `meow-fundo.path`. Nada apareceria como `failed`: o
#   carrossel simplesmente pararia de girar, calado. É o modo de falha exato que
#   este arquivo passou dois dias sofrendo em 11/08/2026 (o `status=4` do
#   cabeçalho), e ali pelo menos havia linha no log.
#
# DE ONDE VEM O 2min
#   A RÉGUA É O PERÍODO DO RELÓGIO, E NÃO O MENOR INTERVALO ENTRE DOIS TIQUES.
#   Medido em 31/08/2026 sobre os 1015 tiques que o journal desta máquina ainda
#   guarda (18/08 00:09 → 31/08 01:24). Contando só pares dentro de um MESMO boot
#   — o monotônico reinicia a cada um —, são 996 intervalos entre `Starting…`
#   consecutivos:
#       987 de 900s para cima, o menor deles 901,104s
#         9 abaixo de 900s: 18,984 · 23,675 · 57,082 · 136,219 · 136,685 ·
#           197,978 · 434,124 · 818,097 · 898,706
#   Os nove pequenos não são relógio nervoso: `OnUnitActiveSec=15min` conta a
#   partir da última ATIVAÇÃO da unidade, então o relógio é INCAPAZ de produzir
#   intervalo abaixo de 900s. Os nove vieram do outro gatilho, o
#   `meow-fundo.path`. Nem suspensão nem acerto de NTP explicam nenhum deles: no
#   mesmo comando, o intervalo medido em `__MONOTONIC_TIMESTAMP` bate com o de
#   `__REALTIME_TIMESTAMP` até o microssegundo nos nove.
#
#   E POR QUE ESSES 18,984s NÃO SÃO A RÉGUA. Gatilho que chega com o job ainda em
#   `activating` NÃO enfileira um segundo job: o systemd funde o pedido naquele
#   que já está correndo — é a mesma medição do `sleep 2` aqui em cima, UM start
#   por evento. Teto grande, portanto, não empilha trabalho; ele ENGOLE os
#   gatilhos que caírem na janela. Engolir um evento do `.path` custa segundos de
#   atraso, e o `.path` existe para ser rápido, não para ser certo. Quem precisa
#   sobreviver a um job travado é o RELÓGIO — "gatilho para ser rápido, relógio
#   para ser certo", no cabeçalho do `meow-wallpaper.timer`. Com 120s < 900s um
#   job travado morre, vira `failed` VISÍVEL e devolve a unidade antes de o
#   relógio dar a volta: nenhum tique de cobertura é comido inteiro. Era isso que
#   a versão anterior deste bloco tentava dizer com "o teto cabe dentro do
#   período", e ela dizia com um piso de 903s que a medição não reproduz.
#
#   E TEM DE SER FOLGADO PARA O TRABALHO HONESTO. Os mesmos 1015 tiques,
#   `Starting…` -> `Finished…`, partidos em 25/08 13:22 — a hora em que o
#   `sleep 2` entrou na unidade INSTALADA, e a razão de a mediana dos dois grupos
#   juntos (0,139s) cair abaixo do próprio debounce:
#       546 sem debounce: min 0,000124s · mediana 0,037s · p95 0,209s · MAX 4,042s
#       469 com debounce: min 2,046s  · mediana 2,119s · p95 2,186s · MAX 2,896s
#   Os dois tiques de ~0,1ms são partidas que não chegaram a rodar o script: o
#   `flock -n` cedeu a vez, ou o guarda do `raiz`/`-x` saiu 0 antes de qualquer
#   trabalho. O pior trabalho HONESTO já visto é o MAX 4,042s da primeira faixa
#   (script sozinho); com o debounce de hoje o mesmo tique daria ~6,04s. 120s são
#   ~20x esse pior caso e ~55x o p95 da forma atual. E o `TimeoutStartSec` cobre a
#   partida INTEIRA, `ExecStartPre` junto — a lição do `meow-assets.service`.
#
#   O COMANDO (é o que produziu os números acima, e eles crescem ~4 por hora):
#       journalctl --user -u meow-wallpaper.service -o json \
#         --output-fields=MESSAGE_ID,__REALTIME_TIMESTAMP,__MONOTONIC_TIMESTAMP,_BOOT_ID
#   parear MESSAGE_ID 7d4958…dcc5 (`Starting`) com 39f534…1fbf (`Finished`).
#
#   POR QUE NÃO 5min, que é o dos irmãos `meow-doctor` e `meow-flatpak`: o
#   `meow-flatpak.service` espera o lock com `flock -w 60` na própria linha de
#   `Exec`, e 60s daquele teto são só a espera da vez. (O `meow-doctor.service`
#   NÃO — corrigido em 31/08/2026, este parágrafo dizia "os dois": o `ExecStart`
#   dele é `meow doctor --consertar` seco, e o `meow_travar` do `lib/comum.sh`
#   usa `flock -n`, que DESISTE em vez de esperar. Os 5min de lá são o orçamento
#   de um reparo completo, não espera de fila.) Aqui o `flock` é `-n -E 0` —
#   cede na hora, sem esperar nada —, então não há esse pedaço a orçar. E esta unidade tem um SEGUNDO gatilho, o `meow-fundo.path`,
#   que existe justamente para consertar em ~2s; um job travado segura esse
#   gatilho por exatamente um `TimeoutStartSec`. Escolher 5min triplicaria esse
#   refém sem nenhuma medição pedindo. O irmão com a mesma forma — `.path` mais
#   debounce — é o `meow-assets.service`, e ele usa 2min.
TimeoutStartSec=2min

StandardOutput=append:%h/.local/state/meowsystem/wallpaper.log
StandardError=inherit
