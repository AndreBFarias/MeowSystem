# meow-derivados.service — a passada do `scripts/derivados.sh`, disparada pelo
# `meow-derivados.path` irmão (P88, decisão 15).
#
# A ESPERA MORA NO SCRIPT: ele espera as pastas ficarem quietas antes de
#   comparar, e a `.path` não redispara enquanto este serviço está de pé — uma
#   rajada de salvamentos vira uma passada só. O que escapar (o PC desligado na
#   hora) o doctor das 5h refaz pela mesma tabela.
#
# NÃO ENTRA EM LAÇO: a passada escreve no tema e no estado, fora das pastas
#   vigiadas. A única escrita dentro delas é o `construir_convertidos.sh
#   --so-mao` (a cópia de um retoque), que é idempotente: o disparo seguinte não
#   acha nada a refazer. O `StartLimit*` é o disjuntor se isso um dia mudar.
#
# O MESMO LOCK DO `bin/meow`, como o `meow-assets.service`: espera a vez até um
#   minuto, e `-E 0` para ceder a vez não contar como falha.

[Unit]
Description=MeowSystem — refaz o que deriva dos desenhos que mudaram
ConditionPathExists=%h/.local/state/meowsystem/raiz
StartLimitIntervalSec=60s
StartLimitBurst=20

[Service]
Type=oneshot
ExecStartPre=-/bin/mkdir -p %h/.local/state/meowsystem
ExecStart=/usr/bin/flock -w 60 -E 0 %h/.local/state/meowsystem/lock /bin/sh -c 'R=$(cat %h/.local/state/meowsystem/raiz); [ -x "$R/scripts/derivados.sh" ] || exit 0; C=%h/.config/meow/meow.conf; set -a; [ -f "$C" ] && . "$C"; set +a; exec "$R/scripts/derivados.sh" --aplicar'
# 1 é "refiz o que mudou", o caso normal aqui; 3 é "nada a vigiar".
SuccessExitStatus=1 3
TimeoutStartSec=10min
StandardOutput=append:%h/.local/state/meowsystem/derivados.log
StandardError=inherit
SyslogIdentifier=meow-derivados
