#!/usr/bin/env bash
# bin/meow — a interface principal do MeowSystem.
#
# O `install.sh` é o bootstrap; ISTO é o que se usa todo dia. Um comando por
# pergunta que dá para fazer sobre o tema, e nenhuma flag além das que existem
# de verdade.
#
# ─────────────────────────────────────────────────────────────────────────────
# ONDE ESTE ARQUIVO RODA, E POR QUE PROCURA A RAIZ EM QUATRO LUGARES
# ─────────────────────────────────────────────────────────────────────────────
# Depois de instalado, este script vive em `~/.local/bin/meow` — FORA do repo.
# Ele não pode deduzir a raiz do próprio caminho como fazem os scripts de
# `scripts/`, que estão sempre um nível abaixo dela. A ordem de busca é:
#   1. `$MEOW_RAIZ`, se apontar para um repo de verdade (é o que os testes usam);
#   2. o diretório acima do próprio arquivo, resolvendo symlink — vale quando se
#      roda `./bin/meow` direto do clone, ou por um link simbólico;
#   3. o ponteiro `~/.local/state/meowsystem/raiz`, gravado pelo `install.sh`;
#   4. os lugares conhecidos, por último e sem promessa nenhuma.
# "Repo de verdade" é ter `lib/comum.sh` E `install.sh`. Testar só a existência
# do diretório aceitaria uma pasta vazia com o nome certo, e o erro apareceria
# três funções adiante, disfarçado de outra coisa.
#
# ─────────────────────────────────────────────────────────────────────────────
# O `doctor` NUNCA USA sudo, E NUNCA BAIXA NADA
# ─────────────────────────────────────────────────────────────────────────────
# Ele confere chamando os MESMOS scripts que o `install.sh` chama, só que com
# `MEOW_DRY_RUN=1`. Três consequências deliberadas:
#   - não existe aqui uma segunda lista de pacotes do apt. Pacote faltando
#     aparece na mensagem do próprio verificador, que já imprime o
#     `sudo apt install` exato. Uma lista duplicada é uma verdade que envelhece
#     em dois lugares — e a que ninguém atualiza é sempre a segunda;
#   - `--consertar` conserta o que é nosso: tema, modo, ícones, pastas, papel de
#     parede e apps. Instalar pacote e baixar upstream continua sendo trabalho
#     do `meow aplicar`, que anuncia o comando antes de pedir a senha;
#   - conferir é leitura. Nenhum caminho de `doctor` sem `--consertar` escreve
#     configuração.
#
# ─────────────────────────────────────────────────────────────────────────────
# O MENU SEM ARGUMENTO SEGUE O `conjurar.zsh` DO ANDROMEDA
# ─────────────────────────────────────────────────────────────────────────────
# Mesmas medidas de janela, mesmo cabeçalho ("ENTER executar | ESC sair"), mesma
# tabulação `comando<TAB>descrição` com `--with-nth=1` e preview à direita.
#
# E A PALETA TAMBÉM É A MESMA — conferido, não suposto. Aqui houve um comentário
# dizendo "lá é Dracula, aqui é Catppuccin"; era verdade quando o `conjurar.zsh`
# nasceu e não é mais: `~/.config/zsh/functions/conjurar.zsh` já pinta o fzf com
# `hl:#CBA6F7 pointer:#A6E3A1 header:#6C7086`, que são mauve, green e overlay0 do
# Catppuccin, e os `D_*` do `_helpers.zsh` guardam hex Catppuccin apesar do nome
# herdado do Dracula. A única divergência que sobra é o `bg+`: overlay-mais-claro
# lá (surface1, #45475A), um degrau mais escuro aqui (surface0, #313244).
#
# Sem `fzf`, cai num menu numerado. Nunca quebra, e nunca pendura: sem terminal
# interativo ele só imprime a lista e sai 0.
#
# ─────────────────────────────────────────────────────────────────────────────
# CÓDIGOS DE SAÍDA (os mesmos do resto do projeto)
#   0 = certo · 1 = divergente · 2 = erro de execução · 3 = falta dependência.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

# --- 1. achar a raiz do repo -----------------------------------------------
__raiz_valida() {
  [ -n "${1:-}" ] && [ -f "$1/lib/comum.sh" ] && [ -f "$1/install.sh" ]
}

__resolver_raiz() {
  local eu dir ponteiro cand
  if __raiz_valida "${MEOW_RAIZ:-}"; then printf '%s' "$MEOW_RAIZ"; return 0; fi

  eu="${BASH_SOURCE[0]}"
  # readlink -f resolve a cadeia inteira de symlinks; sem ele, um link em
  # ~/.local/bin apontando para o clone devolveria ~/.local/bin como "raiz".
  eu="$(readlink -f -- "$eu" 2>/dev/null || printf '%s' "$eu")"
  dir="$(cd "$(dirname -- "$eu")/.." 2>/dev/null && pwd)"
  if __raiz_valida "$dir"; then printf '%s' "$dir"; return 0; fi

  ponteiro="${XDG_STATE_HOME:-$HOME/.local/state}/meowsystem/raiz"
  if [ -f "$ponteiro" ]; then
    cand="$(head -n1 "$ponteiro" 2>/dev/null)"
    if __raiz_valida "$cand"; then printf '%s' "$cand"; return 0; fi
  fi

  # Os lugares onde um clone costuma estar. Este laço é a TERCEIRA tentativa: o
  # normal é resolver pelo próprio caminho do script (acima) ou pelo ponteiro em
  # ~/.local/state/meowsystem/raiz, que o instalador escreve.
  #
  # `MEOW_RAIZ_EXTRA` cobre um clone fora do home — aqui, um NVMe separado — sem
  # deixar o caminho de UMA máquina cravado no primeiro arquivo que quem chega
  # de fora abre para ler.
  #
  # O `~/Desenvolvimento/MeowSystem` SAIU DAQUI EM 24/09/2026 (P39), pelo mesmo
  # motivo: era a pasta de projetos DESTA casa, não um lugar onde um clone
  # "costuma estar". Numa máquina com o ponteiro (que o instalador escreve) ele
  # nunca era alcançado; numa sem o ponteiro, só servia a quem guarda projetos
  # exatamente com esse nome.
  for cand in "$HOME/MeowSystem" \
              "$HOME/.local/share/MeowSystem" \
              ${MEOW_RAIZ_EXTRA:+"$MEOW_RAIZ_EXTRA"}; do
    if __raiz_valida "$cand"; then printf '%s' "$cand"; return 0; fi
  done
  return 1
}

RAIZ="$(__resolver_raiz)" || {
  printf 'meow: não achei o repositório do MeowSystem.\n' >&2
  printf '      aponte com: MEOW_RAIZ=/caminho/do/clone meow %s\n' "${1:-status}" >&2
  exit 3
}
MEOW_RAIZ="$RAIZ"; export MEOW_RAIZ
# shellcheck source=../lib/comum.sh
. "$RAIZ/lib/comum.sh"

# Os dois caminhos DO CONF saem do `lib/comum.sh` desde 11/08/2026 — lá é onde
# mora agora a única rotina que escreve naquele arquivo (`meow_conf_definir`), e
# o `wallpaper.sh permitir` da Sprint M precisa dela também. Repetir o
# `${MEOW_CONF:-...}` aqui daria dois lugares para o override valer, e um dia
# eles discordariam.
#
# A RAIZ DO COSMIC entrou no mesmo bloco em 21/09/2026 (P19) pelo mesmo motivo:
# três linhas, uma regra só — quem resolve o caminho é o `lib/comum.sh`.
CONF="$MEOW_CONF_ARQUIVO"
CONF_PADRAO="$MEOW_CONF_PADRAO"
COSMIC="$(meow_cosmic_dir)"
IS_DARK="$COSMIC/com.system76.CosmicTheme.Mode/v1/is_dark"

# --- 2. configuração --------------------------------------------------------
# Ler o exemplo quando não há conf é o mesmo caminho que o `install.sh` toma no
# seco: sem FLAVOR e ACCENT nada aqui embaixo tem o que conferir, e morrer com
# "variável não associada" esconderia a causa de verdade.
CONF_LIDA=""
# AS CHAVES `FORMA_*` PRECISAM SER EXPORTADAS, E ISSO NÃO ERA VERDADE ATÉ 11/08
#   O `carregar_conf` faz `. "$fonte"`: as chaves ficam neste shell, não no
#   ambiente. O `forma.sh` roda como processo filho e lê tudo de
#   `${FORMA_...:-padrão}` — ou seja, até aqui ele SEMPRE via os padrões, e as
#   chaves do `meow.conf` não tinham efeito nenhum sobre a geometria.
#   Ninguém notou porque as chaves nem existiam no `meow.conf.exemplo`: só
#   apareceram quando `FORMA_DOCK_ILHA` precisou de fato ser trocada.
#   O `export` sem valor exporta a variável já definida; a que não existir sai
#   vazia, e o `${...:-padrão}` do outro lado a devolve ao padrão.
#   E A LISTA ESCRITA À MÃO CAIU NA ARMADILHA Nº 3 (25/08/2026)
#   Os doze nomes ficavam aqui, digitados. Quando o `forma.sh` ganhou as seis
#   chaves de tamanho por segmento (FORMA_CENTRO_*, FORMA_ALA_*), elas não
#   entraram nesta linha — e o efeito foi o MESMO bug de 11/08, de novo: o
#   meow.conf tinha o valor, o script não via, e o `doctor` dizia "forma já
#   conforme" com ar de quem conferiu.
#   Não há mais lista aqui, nem derivada: quem exporta é o `set -a` do
#   `carregar_conf`, uma vez, para TODAS as chaves e todos os scripts. Consertar
#   caso a caso deixaria o próximo caso para o próximo esquecimento.
rodar_painel() {
  "$1"/scripts/painel.sh "${2:-conferir}"
}

rodar_forma() {
  "$1"/scripts/forma.sh
}

carregar_conf() {
  # `--ponte-opcional`: A PALETA NÃO PODE TRANCAR A PORTA DE SAÍDA [22/09/2026]
  #   O `install.sh` põe a ponte DEPOIS do desinstalar e escreve o porquê no
  #   bloco "O LUGAR É ESTE, E É ORDEM, NÃO GOSTO", do `main()`: "quem está indo
  #   embora não deve nada à paleta" — citado por nome, e não por linha, porque
  #   número de linha em comentário apodrece sem cobrador. Pendurar a
  #   ponte no `carregar_conf` — que é o que o resto deste arquivo ganhou de
  #   graça — contradisse esse argumento sem querer: o `cmd_desfazer` chama o
  #   `carregar_conf`, então a ESCOTILHA DE EMERGÊNCIA passou a depender de um
  #   arquivo de cor. Medido no dia, com `MEOW_PALETA` torta: `meow status`
  #   rc=2, `meow doctor` rc=2, e o `desfazer` junto — três comandos que não
  #   escrevem tema nenhum, recusando por causa de uma paleta.
  #
  #   A cerca é estreita (só morde com `PALETA_ARQUIVO`/`MEOW_PALETA` apontando
  #   para o nada, porque pack ausente cai no embutido), e mesmo assim é do lado
  #   errado: o dia em que ela morde é exatamente o dia em que a pessoa quer
  #   desfazer. O `meow pack` já tinha se protegido com `carregar_conf
  #   2>/dev/null || true`; aqui o pedido é NOMEADO, e a mensagem da ponte
  #   continua na tela — quem lê fica sabendo do defeito sem ser impedido de
  #   sair.
  #
  #   QUEM PEDE ISTO SÃO TRÊS, e a conta é a mesma nos três: `cmd_desfazer`
  #   (remove), `cmd_status` e `cmd_doctor` (só leem e relatam). O `doctor`
  #   continua conferindo os geradores — e, sem paleta, eles aparecem como
  #   DIVERGENTES na lista dele, que é o lugar certo para esse recado. Toda
  #   ação que ESCREVE tema segue exigindo a ponte, sem argumento nenhum.
  local ponte_exigida=1
  [ "${1:-}" = "--ponte-opcional" ] && ponte_exigida=0
  local fonte="$CONF"
  [ -f "$fonte" ] || fonte="$CONF_PADRAO"
  [ -f "$fonte" ] || { meow_erro "não achei nem $CONF nem $CONF_PADRAO"; return "$MEOW_ERRO"; }
  # `set -a` É A CURA DA ARMADILHA Nº 3, E NÃO UM ATALHO (25/08/2026)
  #   O `.` deixa as chaves NESTE shell. Todo script de `scripts/` roda como
  #   processo filho e lê `${CHAVE:-padrão}` — então, sem exportar, o meow.conf
  #   não tem efeito nenhum sobre eles. A resposta até hoje era listar os nomes
  #   à mão, em cada `chk_*`/`fix_*` e dentro das unidades systemd. Essa lista
  #   cobrou duas vezes: em 11/08 as `FORMA_*` não valiam nada, e em 25/08 seis
  #   chaves novas (FORMA_CENTRO_*, FORMA_ALA_*) nasceram mortas do mesmo jeito
  #   — com o `doctor` dizendo "já conforme" sem ter conferido, que é o pior
  #   sintoma possível. É a armadilha nº 3 do idempotencia-armadilhas.md: toda
  #   lista fixa é uma lista que alguém vai esquecer.
  #
  #   `set -a` exporta o que o arquivo definir, seja o que for. Conferido: os 70
  #   nomes do meow.conf são todos do projeto (FLAVOR, ACCENT, FORMA_*,
  #   WALLPAPER_*, MIDIA_*, …) — nenhum colide com variável de ambiente do
  #   sistema, então exportar tudo não vaza para lugar nenhum que importe.
  #
  #   Os prefixos `VAR="${VAR:-padrão}"` que ainda existem nos `chk_*` NÃO saem:
  #   eles não estão lá para exportar, e sim para dar PADRÃO a chave que o
  #   meow.conf não tenha. Com o `set -a` eles viram redundância inofensiva; sem
  #   os padrões, um meow.conf enxuto mudaria de comportamento.
  # shellcheck disable=SC1090
  set -a
  . "$fonte" || { set +a; meow_erro "$fonte tem erro de sintaxe"; return "$MEOW_ERRO"; }
  set +a
  CONF_LIDA="$fonte"
  FLAVOR="${FLAVOR:-mocha}"; ACCENT="${ACCENT:-mauve}"
  MODO="${MODO:-escuro}";    LOGO="${LOGO:-$FLAVOR}"
  export FLAVOR ACCENT MODO LOGO
  # A PONTE SHELL -> PYTHON, AQUI PORQUE AQUI É ONDE PACK/FLAVOR NASCEM
  #   `meow gerar` chama `gerar_temas.py` e `gerar_tema_v1.py`; `meow doctor`
  #   chama os dois com `--conferir`. Nenhum deles enxergava o pack ativo, porque
  #   `MEOW_PALETA` não era exportada por ninguém (ver `meow_ponte_python`, em
  #   lib/comum.sh). Pendurar a ponte no `carregar_conf` é o que evita repeti-la
  #   nas quatorze ações que chamam esta função — e uma ação nova a ganha de
  #   graça, que é justamente o oposto da lista fixa que o comentário lá em cima
  #   passou 25/08 explicando por que não ter.
  #
  #   O `return` é PROPOSITAL: uma paleta que não existe faz a ação parar antes
  #   de escrever, e o código é o mesmo `MEOW_ERRO` que o resto do `carregar_conf`
  #   devolve. As três exceções estão no `--ponte-opcional`, lá em cima.
  if ! meow_ponte_python; then
    [ "$ponte_exigida" = "1" ] && return "$MEOW_ERRO"
    meow_aviso "sigo assim mesmo: esta ação não escreve tema nenhum"
  fi
  return 0
}

# AS DUAS ROTINAS QUE ESCREVEM NO MEOW.CONF MUDARAM DE ENDEREÇO EM 11/08/2026
#   `conf_texto_definir` e `conf_definir` moraram aqui até a Sprint M e agora são
#   `meow_conf_texto_definir` e `meow_conf_definir`, em `lib/comum.sh` — com o
#   texto e o cabeçalho inteiros, que explicam por que isto é bash e não `sed` e
#   por que troca TODAS as ocorrências da chave.
#
#   O motivo da mudança: o `scripts/wallpaper.sh permitir` precisa gravar a
#   `WALLPAPER_FONTES_DELA`, e ele roda como processo filho — não enxerga função
#   definida aqui dentro. Reimplementar lá seria a segunda rotina de escrita na
#   mesma chave, e é assim que duas versões da mesma regra passam a discordar.
#
#   Estes dois aliases existem para os pontos desta CLI que chamavam pelos nomes
#   antigos continuarem legíveis; quem lê `conf_definir MODO claro` não precisa
#   saber onde a função mora.
conf_texto_definir() { meow_conf_texto_definir "$@"; }
conf_definir()       { meow_conf_definir "$@"; }

# Log e notificação TAMBÉM são escrita. `MEOW_DRY_RUN=1` promete não escrever
# nada, e uma notificação na tela dela dizendo "o doctor consertou" no meio de
# uma auditoria não é só ruído: é falsa. Todo `meow_registrar`/`meow_notificar`
# desta CLI passa por aqui.
registrar() { meow_seco || meow_registrar "$@"; }
notificar() { meow_seco || meow_notificar "$@"; }

# --- 3. leituras de estado --------------------------------------------------
alvo_tema() { printf '%s-%s' "$FLAVOR" "$ACCENT"; }

# AS CAPTURAS MORAM DENTRO DO PACK DONO — 22/09/2026.
#   Esta função já mudou de casa duas vezes. Ela lia `state/tema/`, um caminho
#   que a reorganização de pastas deixou para trás: o diretório não existia
#   mais, o laço não achava nada, e `meow tema` imprimia "capturas disponíveis"
#   seguido de NADA, com quatro capturas no disco. Ninguém percebeu porque o
#   comando não errava — ele listava o vazio, calado. Quem pegou foi a validação
#   da página, que mostra a saída deste comando num cartão: "mostra ZERO
#   capturas e jura que nenhuma confere".
#   Em 02/09/2026 o conserto foi cravar `assets/temas/capturados/` aqui. Hoje a
#   captura mora no pack dono dela e a `original` ficou no motor — são duas
#   casas, e cravar uma delas repetiria o defeito de 02/09 com outra roupa. Quem
#   responde é o `meow_capturas` (lib/comum.sh), que pergunta ao `pack.py`.
capturas() {
  meow_capturas
}

# Qual captura está de fato aplicada agora. Devolve o nome, ou nada.
# O `--conferir` do aplicar_tema.sh já normaliza o alpha que a Aurora reescreve,
# então "confere" aqui quer dizer o que ela entende por confere — não uma
# segunda regra que discordaria da primeira em silêncio.
tema_ativo() {
  local n
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if MEOW_DRY_RUN=0 "$RAIZ/scripts/aplicar_tema.sh" "$n" --conferir >/dev/null 2>&1; then
      printf '%s' "$n"; return 0
    fi
  done < <(capturas)
  return 1
}

# Gêmeo da `etapa_modo` do install.sh: claro e escuro NÃO são dois temas, são o
# mesmo tema com um interruptor (docs/COSMIC-THEMING.md §2b). Se um dia a regra
# do "auto" mudar, mudam as duas — estão a um `grep MODO_AUTO` de distância.
modo_desejado() {
  local hora ini fim
  case "${MODO:-escuro}" in
    escuro) printf 'true' ;;
    claro)  printf 'false' ;;
    auto)
      hora="$(date +%-H)"
      ini="${MODO_AUTO_CLARO_DE:-7}"; fim="${MODO_AUTO_CLARO_ATE:-18}"
      if [ "$hora" -ge "$ini" ] && [ "$hora" -lt "$fim" ]; then printf 'false'; else printf 'true'; fi ;;
    *) return 1 ;;
  esac
}

is_dark_atual() { cat "$IS_DARK" 2>/dev/null || printf '?'; }

# O ACERVO É A LISTA — não há mais variante do gato do projeto.
# Até 08/08/2026 isto lia `assets/meow-*-painel.svg`, as variantes desenhadas por
# `scripts/gerar_gato.py`. Ela mandou excluir aqueles gatos e ficar só com os
# dela, então a única lista que existe é a pasta: soltou um `.svg` em
# `assets/gatos/`, ele aparece aqui, no menu e na completion, sem editar nada.
logos_disponiveis() {
  local f n
  for f in "$RAIZ"/assets/gatos/*.svg; do
    [ -f "$f" ] || continue
    n="$(basename "$f" .svg)"
    case "$n" in *-symbolic) continue ;; esac
    printf '%s\n' "$n"
  done
}

# --- 4. as conferências -----------------------------------------------------
# Cada uma devolve 0/1/2/3 e imprime detalhe em stdout (capturado pelo runner).
# Todas rodam em seco: `doctor` sem `--consertar` não escreve configuração.

chk_conf() {
  [ -f "$CONF" ] || { echo "meow.conf ainda não existe — o install.sh cria a partir do exemplo"; return "$MEOW_DIVERGENTE"; }
  local v
  for v in FLAVOR ACCENT MODO LOGO; do
    [ -n "${!v:-}" ] || { echo "$v não está definida em $CONF"; return "$MEOW_ERRO"; }
  done
  echo "flavor=$FLAVOR accent=$ACCENT modo=$MODO logo=$LOGO"
  return 0
}

# Só os temas: o gerador de gatos saiu em 08/08/2026, junto com os SVG do
# projeto. Enquanto ele estivesse aqui, o `--consertar` das 5h regeraria os gatos
# excluídos toda madrugada.
chk_gerar() {
  local rc=0 msg="" rc_ron=0
  # AUSENTE NÃO É DIVERGENTE, E A DIFERENÇA NASCEU COM A P14 — 22/09/2026
  #   Os `.ron` saíram do git (são produto de `gerar_temas.py`) e passaram a
  #   nascer em `$MEOW_ESTADO/temas/`. Numa máquina que ainda não rodou o
  #   instalador eles simplesmente NÃO EXISTEM — e chamar isso de "saiu da
  #   paleta" faria o doctor abrir amarelo, na primeira execução de todo mundo,
  #   por algo que ninguém fez de errado. O `gerar_temas.py --conferir` passou a
  #   separar os dois casos: 3 = falta gerar, 1 = existe e está diferente.
  #   Devolver 3 aqui faz a linha sair como "pulado", que é a verdade.
  python3 "$RAIZ/scripts/gerar_temas.py" --conferir >/dev/null 2>&1; rc_ron=$?
  case "$rc_ron" in
    0) ;;
    "$MEOW_SEM_DEPENDENCIA") ;;
    *) rc=1; msg="algum .ron saiu da paleta" ;;
  esac
  # Desde a P48 (24/09/2026) o `gerar_tema_v1.py` sem argumento também
  # confere a captura do acento do meow.conf, e sai 1 quando ela ainda não foi
  # derivada. A frase tem de dizer qual das duas coisas faltou.
  local v1_saida
  v1_saida="$(python3 "$RAIZ/scripts/gerar_tema_v1.py" --conferir 2>&1)" || {
    rc=1
    if [[ "$v1_saida" == *": derivaria de "* ]]; then
      msg="${msg:+$msg; }a captura de $(alvo_tema) ainda não foi derivada"
    fi
    if [[ "$v1_saida" == *"divergente  "* || "$v1_saida" != *": derivaria de "* ]]; then
      msg="${msg:+$msg; }a v1 das capturas saiu da paleta"
    fi
  }
  if [ "$rc" = "0" ] && [ "$rc_ron" = "$MEOW_SEM_DEPENDENCIA" ]; then
    echo "os .ron ainda não foram gerados nesta máquina — 'meow doctor --consertar' os escreve em $MEOW_ESTADO/temas/"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  # QUEM NOMEIA O ARQUIVO É O `meow_paleta_nome` — 22/09/2026
  #   Esta linha dizia "conferem com assets/paleta/", e a P13 esvaziou esse
  #   diretório: só o `cosmic-map.json`, que é do MOTOR, ficou lá. A paleta
  #   mora no pack agora. O irmão desta frase, no `install.sh`, passou pela
  #   porta no mesmo commit; este ficou para trás e saía em TODA rodada verde
  #   do doctor, apontando uma pasta onde a cor já não está.
  [ "$rc" = "0" ] && { echo "os temas e a v1 das capturas conferem com $(meow_paleta_nome)"; return 0; }
  echo "$msg — 'meow doctor --consertar' regenera"
  return "$MEOW_DIVERGENTE"
}

chk_tema() {
  local alvo; alvo="$(alvo_tema)"
  [ -n "$(meow_captura "$alvo")" ] || {
    # O ACENTO QUE SE DERIVA NÃO É PASSO MANUAL — 24/09/2026, sprint P48
    #   Esta linha mandava importar o `.ron` na GUI para QUALQUER par sem
    #   captura. O par que se deriva (`derivar_acento.py`) é divergência com
    #   conserto: o `fix_gerar`, que roda antes deste na mesma lista, o deriva,
    #   e o `fix_tema` o aplica — um `--consertar` só. A GUI fica para o flavor
    #   que nunca foi fotografado, que é o único caso sem outro caminho.
    local deriva
    deriva="$(python3 "$RAIZ/scripts/derivar_acento.py" --conferir "$alvo" 2>&1)"
    if [ "$?" = "1" ]; then
      echo "${deriva#  } — 'meow doctor --consertar' deriva e aplica"
      return "$MEOW_DIVERGENTE"
    fi
    echo "não há captura para '$alvo' (${deriva#*não se deriva — })"
    echo "importe $MEOW_ESTADO/temas/meowsystem-$alvo.ron uma vez pela GUI e rode: meow tema capturar $alvo"
    return "$MEOW_SEM_DEPENDENCIA"
  }
  # O doctor é MANUTENÇÃO: ele confere com `--respeitar-gui` e pode devolver 4,
  # "a captura está velha". Ver o tratamento do 4 no runner e no cabeçalho do
  # aplicar_tema.sh — 4 não é divergência, é decisão dela, e não notifica.
  MEOW_DRY_RUN=0 "$RAIZ/scripts/aplicar_tema.sh" "$alvo" --respeitar-gui --conferir 2>&1
}

chk_modo() {
  local desejado atual
  desejado="$(modo_desejado)" || { echo "MODO='$MODO' desconhecido — esperado escuro|claro|auto"; return "$MEOW_ERRO"; }
  atual="$(is_dark_atual)"
  [ "$atual" = "$desejado" ] && { echo "modo $MODO (is_dark=$atual)"; return 0; }
  echo "is_dark=$atual, mas MODO=$MODO pede $desejado"
  return "$MEOW_DIVERGENTE"
}

# OS ÍCONES QUE FALTAVAM — E O VIGIA QUE NÃO EXISTIA ATÉ 09/09/2026
#   `scripts/completar_icones.sh` tinha etapa no `install.sh` e **nenhum**
#   conferidor aqui. Um recurso com duas das quatro peças (script, etapa,
#   conferidor, auto-cura) não está entregue — e o preço apareceu: o
#   `128x128/apps/thunderbird.png` ficou um mês vencendo o traço do Arcticons na
#   tela dela, e o auto-reparo das 5h passava por cima todo dia sem olhar.
#
#   Ele confere pelo mesmo caminho de sempre: o próprio script, em seco. Duas
#   perguntas de uma vez — o que o `apps-hicolor.map` pede está instalado, e o
#   que SAIU dele já saiu do disco.
#
#   TEM conserto automático, e é seguro: a remoção do script é por CONTEÚDO
#   (byte a byte igual a um arquivo do `hicolor` do sistema, no mesmo tamanho),
#   nunca por nome. Um `.png` que ela puser ali à mão não passa nesse teste.
chk_completar() {
  MEOW_DRY_RUN=1 FLAVOR="$FLAVOR" ACCENT="$ACCENT" \
    NOME_TEMA_ICONES="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
    "$RAIZ/scripts/completar_icones.sh" 2>&1
}

chk_icones() {
  MEOW_DRY_RUN=1 FLAVOR="$FLAVOR" LOGO="$LOGO" \
    ICONES_BASE="${ICONES_BASE:-Papirus-Dark}" \
    NOME_TEMA_ICONES="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
    "$RAIZ/scripts/construir_icones.sh" 2>&1
}

# As pastas especiais pelo nome XDG (`folder-pictures`, `folder-music`…), do pack
# Catppuccin. Diretório próprio (`scalable/places`) e dono único; o
# `construir_pastas.sh` cede esses nomes, e só cede o que já está no disco — se
# este script sumir, o mauve volta sozinho na mesma passagem.
chk_pastasxdg() {
  PASTAS_XDG="${PASTAS_XDG:-nao}" ICONES_FLAVOR="${ICONES_FLAVOR:-}" \
    ICONES_TEMA="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
    "$RAIZ/scripts/icones_pastas.sh" --conferir 2>&1
}

chk_pastas() {
  MEOW_DRY_RUN=1 ICONES_BASE="${ICONES_BASE:-Papirus-Dark}" \
    ICONES_PASTAS="${ICONES_PASTAS:-cat-${FLAVOR}-${ACCENT}}" \
    NOME_TEMA_ICONES="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
    "$RAIZ/scripts/construir_pastas.sh" 2>&1
}

chk_wallpaper() {
  MEOW_DRY_RUN=1 WALLPAPER_BASE="${WALLPAPER_BASE:-}" WALLPAPER_INTERVALO="${WALLPAPER_INTERVALO:-5m}" \
    WALLPAPER_ORDEM="${WALLPAPER_ORDEM:-aleatoria}" \
    WALLPAPER_FONTES_DELA="${WALLPAPER_FONTES_DELA:-}" \
    WALLPAPER_AJUSTE="${WALLPAPER_AJUSTE:-preencher}" \
    WALLPAPER_NOITE="${WALLPAPER_NOITE:-}" WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" \
    WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" WALLPAPER_LIMIAR_LUZ="${WALLPAPER_LIMIAR_LUZ:-}" \
    "$RAIZ/scripts/wallpaper.sh" aplicar 2>&1
}

# O VIGIA DO FUNDO ENTRA NO DOCTOR PORQUE VIGIA QUE CAI NÃO AVISA (25/08/2026)
#   O `wallpaper` logo acima confere a CONFIG do carrossel; este confere o
#   GATILHO que a repõe em segundos. São perguntas diferentes, e sem esta a
#   segunda só seria feita no próximo `install.sh`: um `systemctl --user
#   disable` acidental, ou um `.path` que ficou `failed`, deixaria o conserto
#   voltando a demorar 15 minutos sem nada na tela dizendo por quê. É a mesma
#   razão pela qual `assets` e `flatpak` já estão nesta lista.
#
#   Não vale conferir só `is-enabled`: uma unidade pode estar habilitada e
#   morta (`failed`), e o `.path` não se rearma sozinho depois disso — daí a
#   checagem de `is-active` e o `reset-failed` no conserto.
#   SÃO TRÊS UNIDADES, E CONFERIR SÓ O `.path` DEIXAVA DOIS BURACOS (25/08/2026)
#   O `etapa_wallpaper` do install.sh instala TRÊS arquivos —
#   `meow-wallpaper.service`, `meow-wallpaper.timer` e `meow-fundo.path` — e liga
#   dois. A primeira versão desta conferência olhava um arquivo só, e por isso:
#     - o `.service` podia estar VELHO no disco dela. Ele é quem sabe carregar o
#       meow.conf; uma correção nele (a de hoje, o `set -a` no lugar da lista de
#       `export`) só chegaria por um `./install.sh` novo, e o doctor diria
#       "gatilho ligado" com o serviço antigo montado;
#     - o `.service` podia SUMIR e nada acusaria: o `.path` continua `enabled` e
#       `active` vigiando um serviço que não existe — gatilho morto parecendo
#       instalado, que é a armadilha nº 2 do idempotencia-armadilhas.md;
#     - o `.timer` de 15 min, que é a garantia de tempo quando o inotify não
#       sobrevive à sessão, não tinha verificador NENHUM em toda a lista.
#
#   A lista de arquivos mora numa linha só, e a de "quem se liga" é DERIVADA
#   dela pelo sufixo: `.service` é disparado, `.timer`/`.path` disparam. Uma
#   lista a menos para alguém esquecer de atualizar.
_FUNDO_DIR="$HOME/.config/systemd/user"
_FUNDO_UNIDADES=(meow-wallpaper.service meow-wallpaper.timer meow-fundo.path meow-ativos.path)
_fundo_ligaveis() {
  local u
  for u in "${_FUNDO_UNIDADES[@]}"; do
    case "$u" in *.service) ;; *) printf '%s\n' "$u" ;; esac
  done
}

# O `AUTO_REPARO="nao"` MANDA AQUI TAMBÉM, E ISTO É PARIDADE COM O install.sh
#   O `install.sh:1559-1592` DESLIGA e APAGA as três quando a chave não é "sim"
#   — "quem desliga o auto-reparo está dizendo 'não mexa sozinho'", e um `.path`
#   de inotify é o que mais mexe sozinho no projeto inteiro. Sem esta guarda o
#   doctor faria o contrário do instalador: acusaria "instalaria meow-fundo.path"
#   todo dia, e o `--consertar` religaria o que o `./install.sh` tinha acabado de
#   tirar. Dois donos com regras opostas sobre o mesmo arquivo é como se ganha um
#   ping-pong que ninguém entende de onde vem.
#   É a mesma forma do `chk_assets`/`chk_flatpak` com `ASSETS_VIGIA`/
#   `FLATPAK_VIGIA`, e do `chk_lancadorapt` com `LANCADOR_SISTEMA`: com a chave
#   desligada e nada instalado, 3 (pulado); com sobra no disco ou no systemd, 1.
chk_fundo() {
  local u texto sobrou=0
  meow_tem systemctl && [ -d "/run/user/$(id -u)/systemd" ] || {
    meow_pula "sem systemd de usuária — o gatilho do fundo não se aplica aqui"
    return "$MEOW_SEM_DEPENDENCIA"
  }

  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    for u in "${_FUNDO_UNIDADES[@]}"; do [ -f "$_FUNDO_DIR/$u" ] && sobrou=1; done
    # O systemd é perguntado além do disco porque uma unidade pode continuar
    # LIGADA com o arquivo já apagado à mão — o `is-enabled` responde pelo que
    # ele carregou, não pelo que está no diretório.
    while IFS= read -r u; do
      case "$(systemctl --user is-enabled "$u" 2>/dev/null)" in
        enabled|enabled-runtime) sobrou=1 ;;
      esac
      [ "$(systemctl --user is-active "$u" 2>/dev/null)" = "active" ] && sobrou=1
    done < <(_fundo_ligaveis)
    [ "$sobrou" = "1" ] && {
      meow_muda "AUTO_REPARO=\"${AUTO_REPARO:-}\" mas o relógio e o gatilho do carrossel continuam ligados"
      return "$MEOW_DIVERGENTE"
    }
    meow_pula "AUTO_REPARO=\"${AUTO_REPARO:-}\" — sem relógio nem gatilho do carrossel"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  # COMPARAR DO MESMO JEITO QUE SE ESCREVE — a armadilha está escrita no
  # cabeçalho do vigia_flatpak.sh e eu caí nela mesmo assim, em 25/08/2026: o
  # `meow_escrever` grava com `printf '%s'` e come o `\n` final, então `cmp` byte
  # a byte acusa divergência PARA SEMPRE num arquivo perfeito — o `--consertar`
  # reinstalava, o `doctor` seguinte reclamava de novo, e nada convergia. A
  # substituição de comando come o `\n` dos DOIS lados, que é o critério de quem
  # escreveu o arquivo. (Medido hoje: as unidades do repositório TERMINAM em
  # `\n` e as instaladas NÃO — um `cmp` reprovaria as três, sempre.)
  # E A SUBSTITUIÇÃO TEM DE ACONTECER DOS DOIS LADOS — pego em 01/09/2026, no
  # mesmo dia em que o `meow-ativos.path` nasceu. O modelo no repositório traz
  # `@ATIVOS@` e o instalador o troca pelo caminho real; comparar o modelo cru
  # contra o arquivo instalado dá divergência ETERNA — o `--consertar`
  # reinstalaria, o doctor das 5h reclamaria de novo, todo dia, para sempre. É
  # literalmente o defeito descrito no parágrafo acima, com outro nome, e a cura
  # é a mesma: comparar do mesmo jeito que se escreve.
  local _ativos="${WALLPAPER_BASE:-$HOME/.local/share/backgrounds/meowsystem}/ativos"
  for u in "${_FUNDO_UNIDADES[@]}"; do
    [ -f "$RAIZ/systemd/$u" ] || { meow_erro "falta systemd/$u"; return "$MEOW_ERRO"; }
    texto="$(cat "$RAIZ/systemd/$u")"
    [ "$u" = "meow-ativos.path" ] && texto="${texto//@ATIVOS@/$_ativos}"
    if [ ! -f "$_FUNDO_DIR/$u" ] || [ "$texto" != "$(cat "$_FUNDO_DIR/$u" 2>/dev/null)" ]; then
      meow_muda "instalaria/atualizaria $u"
      return "$MEOW_DIVERGENTE"
    fi
  done
  # Não vale conferir só `is-enabled`: uma unidade pode estar habilitada e morta
  # (`failed`), e nem `.path` nem `.timer` se rearmam sozinhos depois disso —
  # daí a checagem de `is-active` e o `reset-failed` no conserto.
  while IFS= read -r u; do
    if [ "$(systemctl --user is-failed "$u" 2>/dev/null)" = "failed" ]; then
      meow_muda "$u está em failed — religaria"
      return "$MEOW_DIVERGENTE"
    fi
    if [ "$(systemctl --user is-enabled "$u" 2>/dev/null)" != "enabled" ] ||
       [ "$(systemctl --user is-active  "$u" 2>/dev/null)" != "active" ]; then
      meow_muda "ligaria o $u"
      return "$MEOW_DIVERGENTE"
    fi
  done < <(_fundo_ligaveis)
  meow_ok "carrossel protegido: relógio de 15 min + gatilho na config + vigia de ativos/"
  return "$MEOW_OK"
}

fix_fundo() {
  local u
  meow_tem systemctl && [ -d "/run/user/$(id -u)/systemd" ] || return "$MEOW_SEM_DEPENDENCIA"

  # O SECO PARA AQUI, E A FALTA DESTA GUARDA FOI MEDIDA (25/08/2026)
  #   Todo `fix_*` acima chama um SCRIPT, e cada script já respeita o
  #   `MEOW_DRY_RUN` sozinho — é o que o cabeçalho da seção 5 promete. Este é o
  #   primeiro que executa comando na própria CLI, e por isso a promessa não
  #   valia para ele: com `MEOW_DRY_RUN=1 meow doctor --consertar`, medido com um
  #   HOME de mentira e um `systemctl` de mentira no PATH, ele criava
  #   `~/.config/systemd/user/` e disparava os TRÊS comandos —
  #   `daemon-reload`, `reset-failed` e `enable --now` —, terminando com um
  #   "gatilho do fundo ligado" na tela. Ou seja: o modo que existe para AUDITAR
  #   antes de deixar rodar mexia no systemd dela e ainda mentia sobre o feito.
  #
  #   O `tests/seco.sh` não pega isto: ele audita o `install.sh`, não o doctor.
  #
  #   Sai 1 (e não 0) de propósito: "havia o que consertar" continua sendo
  #   verdade, e é o código que o runner lê para dizer "é isto que o conserto
  #   FARIA". Parar aqui é a mesma forma do `meow_seco && CONFERIR=1` que os
  #   vigias de assets e de flatpak usam no topo deles.
  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    meow_seco && { meow_muda "removeria o relógio e o gatilho do carrossel"; return "$MEOW_DIVERGENTE"; }
    while IFS= read -r u; do
      systemctl --user disable --now "$u" >/dev/null 2>&1
    done < <(_fundo_ligaveis)
    for u in "${_FUNDO_UNIDADES[@]}"; do rm -f "$_FUNDO_DIR/$u"; done
    systemctl --user daemon-reload >/dev/null 2>&1
    meow_ok "AUTO_REPARO=\"${AUTO_REPARO:-}\" — relógio e gatilho do carrossel desligados e removidos"
    return "$MEOW_DIVERGENTE"
  fi

  if meow_seco; then
    meow_muda "instalaria e ligaria o relógio (15 min) e o gatilho do carrossel"
    return "$MEOW_DIVERGENTE"
  fi
  mkdir -p "$_FUNDO_DIR"
  for u in "${_FUNDO_UNIDADES[@]}"; do
    meow_escrever "$_FUNDO_DIR/$u" "$(cat "$RAIZ/systemd/$u")" 644
    case $? in 2) meow_erro "não consegui instalar $u"; return "$MEOW_ERRO" ;; esac
  done
  systemctl --user daemon-reload >/dev/null 2>&1
  # O `reset-failed` cobre as TRÊS: o `.service` disparado é justamente o que
  # falha primeiro, e enquanto ele estiver em `failed` o `.path` que o chama
  # dispara para o vazio.
  systemctl --user reset-failed "${_FUNDO_UNIDADES[@]}" >/dev/null 2>&1
  while IFS= read -r u; do
    systemctl --user enable --now "$u" >/dev/null 2>&1 \
      || { meow_erro "não consegui ligar o $u"; return "$MEOW_ERRO"; }
  done < <(_fundo_ligaveis)
  meow_ok "carrossel protegido: relógio de 15 min + gatilho no instante da mudança"
  return "$MEOW_DIVERGENTE"
}

# O VIGIA DO Qt — A QUARTA UNIDADE `.path` DO PROJETO (09/09/2026)
#
#   A linha `apps` logo abaixo confere o VALOR (`icon_theme` dos dois `.conf`);
#   esta confere o GATILHO que o repõe em segundos. São perguntas diferentes,
#   pela mesma razão que separa `wallpaper` de `fundo`: sem esta, um `disable`
#   acidental faria a `apps` voltar a acusar divergência todo dia às 5h e nada
#   na tela diria que o vigia tinha caído.
#
#   POR QUE ELE PRECISOU EXISTIR, EM UMA FRASE: o cosmic-settings-daemon
#   reescreve `qt5ct.conf`/`qt6ct.conf` na exportação de PARTIDA da sessão e
#   devolve o `icon_theme` ao `breeze-dark` que está hardcoded nele — 29 vezes
#   entre 04/08 e 06/09, uma por pasta de backup datada. A medição inteira, com
#   os milissegundos, está no cabeçalho de `systemd/meow-qt.path`.
#
#   A lista de arquivos mora numa linha só e a de "quem se liga" é DERIVADA dela
#   pelo sufixo, igual ao `_FUNDO_UNIDADES`: uma lista a menos para envelhecer.
_QT_DIR="$HOME/.config/systemd/user"
_QT_UNIDADES=(meow-qt.service meow-qt.path)
_qt_ligaveis() {
  local u
  for u in "${_QT_UNIDADES[@]}"; do
    case "$u" in *.service) ;; *) printf '%s\n' "$u" ;; esac
  done
}

# A CERCA É A MESMA DO `chk_fundo`, E PELO MESMO MOTIVO: paridade com o
# instalador. O `etapa_vigia_qt` DESLIGA e APAGA as duas quando `AUTO_REPARO`
# não é "sim"; sem esta guarda o doctor acusaria "instalaria meow-qt.path" todo
# dia e o `--consertar` religaria o que o `./install.sh` acabou de tirar.
#
# A SEGUNDA CERCA É O `APPS_ATIVOS`, e ela não tem irmã nas outras três: quem
# tirou `qt5ct` da lista pediu para o módulo dos toolkits não rodar, e um vigia
# que o chamasse assim mesmo seria a CLI desobedecendo a conf dela. É a mesma
# condição que o `ExecCondition=` da unidade avalia — se divergissem, o doctor
# diria "ligado" sobre um gatilho que o systemd pula em silêncio.
chk_qtvigia() {
  local u texto sobrou=0 lista
  meow_tem systemctl && [ -d "/run/user/$(id -u)/systemd" ] || {
    meow_pula "sem systemd de usuária — o gatilho do Qt não se aplica aqui"
    return "$MEOW_SEM_DEPENDENCIA"
  }

  lista=",$(printf '%s' "${APPS_ATIVOS:-}" | tr -d ' '),"
  case "$lista" in
    *,qt5ct,*|*,qt,*|*,gtk,*) ;;
    *)
      for u in "${_QT_UNIDADES[@]}"; do [ -f "$_QT_DIR/$u" ] && sobrou=1; done
      [ "$sobrou" = "1" ] && {
        meow_muda "qt5ct fora do APPS_ATIVOS mas o vigia do Qt continua instalado"
        return "$MEOW_DIVERGENTE"
      }
      meow_pula "qt5ct fora do APPS_ATIVOS — sem vigia do Qt"
      return "$MEOW_SEM_DEPENDENCIA" ;;
  esac

  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    for u in "${_QT_UNIDADES[@]}"; do [ -f "$_QT_DIR/$u" ] && sobrou=1; done
    while IFS= read -r u; do
      case "$(systemctl --user is-enabled "$u" 2>/dev/null)" in
        enabled|enabled-runtime) sobrou=1 ;;
      esac
      [ "$(systemctl --user is-active "$u" 2>/dev/null)" = "active" ] && sobrou=1
    done < <(_qt_ligaveis)
    [ "$sobrou" = "1" ] && {
      meow_muda "AUTO_REPARO=\"${AUTO_REPARO:-}\" mas o vigia do Qt continua ligado"
      return "$MEOW_DIVERGENTE"
    }
    meow_pula "AUTO_REPARO=\"${AUTO_REPARO:-}\" — sem vigia do Qt"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  # COMPARAR DO MESMO JEITO QUE SE ESCREVE — a armadilha do `\n` final está
  # explicada no `chk_fundo` aqui em cima. `"$(cat …)"` dos DOIS lados.
  for u in "${_QT_UNIDADES[@]}"; do
    [ -f "$RAIZ/systemd/$u" ] || { meow_erro "falta systemd/$u"; return "$MEOW_ERRO"; }
    texto="$(cat "$RAIZ/systemd/$u")"
    if [ ! -f "$_QT_DIR/$u" ] || [ "$texto" != "$(cat "$_QT_DIR/$u" 2>/dev/null)" ]; then
      meow_muda "instalaria/atualizaria $u"
      return "$MEOW_DIVERGENTE"
    fi
  done
  while IFS= read -r u; do
    if [ "$(systemctl --user is-failed "$u" 2>/dev/null)" = "failed" ]; then
      meow_muda "$u está em failed — religaria"
      return "$MEOW_DIVERGENTE"
    fi
    if [ "$(systemctl --user is-enabled "$u" 2>/dev/null)" != "enabled" ] ||
       [ "$(systemctl --user is-active  "$u" 2>/dev/null)" != "active" ]; then
      meow_muda "ligaria o $u"
      return "$MEOW_DIVERGENTE"
    fi
  done < <(_qt_ligaveis)
  meow_ok "vigiando qt5ct/qt6ct — o ícone do Qt volta sozinho depois do login"
  return "$MEOW_OK"
}

# O SECO PARA ANTES DE QUALQUER `systemctl` QUE ESCREVA — é a guarda que o
# `fix_fundo` ganhou em 25/08/2026 depois de ser medido mexendo no systemd dela
# durante um `MEOW_DRY_RUN=1 meow doctor --consertar`. `is-enabled`/`is-active`/
# `is-failed` são leitura pura e podem ficar de fora dela; `daemon-reload`,
# `reset-failed`, `enable` e `disable` não.
fix_qtvigia() {
  local u lista
  meow_tem systemctl && [ -d "/run/user/$(id -u)/systemd" ] || return "$MEOW_SEM_DEPENDENCIA"

  lista=",$(printf '%s' "${APPS_ATIVOS:-}" | tr -d ' '),"
  case "$lista" in
    *,qt5ct,*|*,qt,*|*,gtk,*) ;;
    *)
      # Só se chega aqui vindo de um `chk_qtvigia` que devolveu 1 — ou seja,
      # com sobra no disco ou no systemd. Quando não há sobra o `chk` devolve 3
      # e o `--consertar` nem chama esta função.
      meow_seco && { meow_muda "removeria o vigia do Qt (qt5ct fora do APPS_ATIVOS)"; return "$MEOW_DIVERGENTE"; }
      while IFS= read -r u; do systemctl --user disable --now "$u" >/dev/null 2>&1; done < <(_qt_ligaveis)
      for u in "${_QT_UNIDADES[@]}"; do rm -f "$_QT_DIR/$u"; done
      systemctl --user daemon-reload >/dev/null 2>&1
      meow_ok "qt5ct fora do APPS_ATIVOS — vigia do Qt desligado e removido"
      return "$MEOW_DIVERGENTE" ;;
  esac

  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    meow_seco && { meow_muda "removeria o vigia do Qt"; return "$MEOW_DIVERGENTE"; }
    while IFS= read -r u; do systemctl --user disable --now "$u" >/dev/null 2>&1; done < <(_qt_ligaveis)
    for u in "${_QT_UNIDADES[@]}"; do rm -f "$_QT_DIR/$u"; done
    systemctl --user daemon-reload >/dev/null 2>&1
    meow_ok "AUTO_REPARO=\"${AUTO_REPARO:-}\" — vigia do Qt desligado e removido"
    return "$MEOW_DIVERGENTE"
  fi

  if meow_seco; then
    meow_muda "instalaria e ligaria o vigia do Qt (qt5ct/qt6ct)"
    return "$MEOW_DIVERGENTE"
  fi
  mkdir -p "$_QT_DIR"
  for u in "${_QT_UNIDADES[@]}"; do
    meow_escrever "$_QT_DIR/$u" "$(cat "$RAIZ/systemd/$u")" 644
    case $? in 2) meow_erro "não consegui instalar $u"; return "$MEOW_ERRO" ;; esac
  done
  systemctl --user daemon-reload >/dev/null 2>&1
  # O `reset-failed` cobre as duas: o `.service` é o que falha primeiro, e
  # enquanto ele estiver em `failed` o `.path` dispara para o vazio.
  systemctl --user reset-failed "${_QT_UNIDADES[@]}" >/dev/null 2>&1
  while IFS= read -r u; do
    systemctl --user enable --now "$u" >/dev/null 2>&1 \
      || { meow_erro "não consegui ligar o $u"; return "$MEOW_ERRO"; }
  done < <(_qt_ligaveis)
  meow_ok "vigia do Qt ligado — o ícone volta em segundos, não às 5h da manhã"
  return "$MEOW_DIVERGENTE"
}

# O SECO ENTROU AQUI EM 24/09/2026 (P44), E O QUE ELE TIRA É A PENDÊNCIA
#   O `conferir` dos módulos chama o `detectar`, e o `detectar` do qBittorrent
#   e o do Spotify registram e apagam pendência — arquivo em `$MEOW_ESTADO`.
#   Medido com a casa dela montada SOMENTE-LEITURA (bwrap) e o doctor sem
#   `--consertar`: sete tentativas de escrita em `pendencias.tsv`, todas daqui.
#   O `aplicar_apps.sh tabela` já tinha tapado o mesmo vazamento para o painel,
#   mandando o estado para um descartável; aqui o caminho é o das irmãs, o
#   `MEOW_DRY_RUN=1`, que faz o `meow_pendencia_*` devolver antes de tocar o
#   arquivo. A saída e o código conferem byte a byte com e sem ele (medido no
#   mesmo dia, na mesma casa).
#   O PREÇO, DITO: a pendência dos aplicativos deixa de ser renovada pela
#   leitura do doctor e passa a ser só pelo `aplicar` — o `install.sh`, o
#   `meow apps aplicar` e o `fix_apps`. É o lugar dela: registrar é escrever.
chk_apps() {
  MEOW_DRY_RUN=1 APPS_ATIVOS="${APPS_ATIVOS:-}" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
    SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" conferir 2>&1
}

# O ÚNICO VERIFICADOR QUE LÊ O CÓDIGO DE OUTRO PROGRAMA — E POR QUE ELE EXISTE
#   O módulo do Heroic (`assets/temas-de-apps/heroic/manifesto.sh`) grava em
#   `store/config.json` o NOME DO ARQUIVO do tema, com a extensão. Isso não é
#   convenção: é a forma exata do handler do Heroic 2.22.1, lido no `app.asar`,
#   que faz `path.join(customThemesPath, theme)` sem acrescentar nada. Escrever
#   sem o `.css` deixa a tela DE FÁBRICA sem um erro, sem um aviso e sem uma
#   linha de log — foi o defeito de 08/09/2026, e ele passou por "medido de
#   ponta a ponta" porque a medição olhou os arquivos e não a janela.
#
#   Este verificador relê o handler a cada passagem. Se um Heroic futuro passar
#   a juntar o ".css" ele mesmo, o nosso valor vira `…css.css`, o arquivo não é
#   achado, e a tela apaga de novo em silêncio — só que desta vez o doctor diz o
#   nome do defeito. NÃO tem conserto automático de propósito: não dá para
#   adivinhar a forma nova a partir da ausência da antiga, e um `--consertar`
#   chutando às 5h da manhã é pior que um aviso. Por isso está em SEM_CONSERTO.
#
#   Devolve 3 (e não 1) quando o Heroic não está instalado, quando não é flatpak
#   ou quando o `app.asar` não está onde se espera: numa máquina sem Heroic isto
#   não é divergência, e 3 é o código que faz o auto-reparo ficar quieto.
#
#   O caminho vem dos symlinks `current/active` do flatpak, e NÃO de
#   `flatpak info --show-location`: `flatpak info` deixa um repo ostree inteiro
#   em ~/.local/share/flatpak/repo só por ter sido perguntado (medido em HOME
#   virgem, 10/08/2026 — está no `meow_flatpak_tem`), e conferir não pode
#   escrever. Custo medido do `grep -a` nos 107 MB do asar: 0,02 s no pior caso,
#   porque o `-q` para no primeiro casamento.
chk_heroictema() {
  local id="com.heroicgameslauncher.hgl" raiz asar=""
  meow_flatpak_tem "$id" || {
    echo "Heroic não está instalado — nada a conferir"
    return "$MEOW_SEM_DEPENDENCIA"
  }
  for raiz in "$HOME/.local/share/flatpak" "/var/lib/flatpak"; do
    [ -f "$raiz/app/$id/current/active/files/bin/heroic/resources/app.asar" ] || continue
    asar="$raiz/app/$id/current/active/files/bin/heroic/resources/app.asar"
    break
  done
  [ -n "$asar" ] || {
    echo "Heroic presente, mas sem app.asar de flatpak ao alcance — nada a conferir"
    return "$MEOW_SEM_DEPENDENCIA"
  }
  if grep -aq -- 'join(customThemesPath, theme)' "$asar"; then
    echo "o Heroic abre o tema pelo nome do arquivo — o módulo grava com o .css, e está certo"
    return 0
  fi
  echo "o getThemeCSS do Heroic mudou de forma: não achei 'join(customThemesPath, theme)' no app.asar"
  echo "o módulo grava 'theme' COM o .css por causa dessa linha; confira o handler antes de confiar na tela"
  echo "arquivo: $asar"
  return "$MEOW_DIVERGENTE"
}

# O APPLET DE MÍDIA ENTRA COM DOIS NOMES, E ISSO NÃO É ARRUMAÇÃO — É O LAÇO
#   `midiabin` é o binário compilado (scripts/midia_build.sh); `midia` é a sombra
#   `.desktop` e as chaves (scripts/midia.sh). São dois porque o laço de conserto
#   decide pelo NOME, e decide ANTES de olhar o código de saída:
#   `case "$SEM_CONSERTO" in *" $nome "*)` dá `continue` na linha seguinte.
#
#   Compilar não é do doctor — o caminho do `cargo` é inalcançável sem
#   `MIDIA_COMPILAR=1`, e quem exporta essa chave é o `install.sh` — então o
#   nome do build TEM de estar em `SEM_CONSERTO`. Com um nome só para as duas
#   metades, esse `continue` mataria junto o conserto das partes que o doctor
#   SABE fazer, e que são `rm`/escrita no home dela, sem sudo e sem rede: a
#   sombra, as chaves, e o fail-safe da sombra órfã — o estado em que a dock
#   fica SEM applet nenhum, porque o painel casa pelo basename e consome o slot
#   antes de chegar ao export do flatpak. Separados, `midia` conserta e
#   `midiabin` acusa com o comando na tela.
#
#   Também NÃO é caso de rc=4: o 4 é escolha dela (o tema mexido na GUI, a
#   opacidade do vidro) e imprime "é escolha sua, não divergência". Precisar
#   recompilar não é gosto dela, e essa frase mandaria procurar no lugar errado.
#
# Nenhum padrão é repetido aqui: as chaves vazias caem no `${...:-}` do próprio
# script, que é o único lugar onde o padrão de mídia está escrito.
chk_midia() {
  MIDIA="${MIDIA:-}" MIDIA_LARGURA="${MIDIA_LARGURA:-}" \
    MIDIA_COR_ALBUM="${MIDIA_COR_ALBUM:-}" MIDIA_CAPA="${MIDIA_CAPA:-}" \
    MIDIA_FONTE="${MIDIA_FONTE:-}" MIDIA_COR_TITULO="${MIDIA_COR_TITULO:-}" \
    MIDIA_COR_ARTISTA="${MIDIA_COR_ARTISTA:-}" \
    MIDIA_CONTROLES="${MIDIA_CONTROLES:-}" FLAVOR="${FLAVOR:-}" \
    "$RAIZ/scripts/midia.sh" --conferir 2>&1
}

# Só confere — não existe `fix_midiabin`, e a ausência é a metade que faz o
# comentário acima valer. Ver `SEM_CONSERTO`.
chk_midiabin() {
  MIDIA="${MIDIA:-}" "$RAIZ/scripts/midia_build.sh" --conferir 2>&1
}

# As três que existem PORQUE se perderam caladas. Nenhuma delas era conferida por
# ninguém, e foi assim que o vidro ao maximizar voltou ao padrão de fábrica e a
# tela de login ficou azul sem que nada acusasse. Conferir é o que transforma
# "sumiu de novo" em "o doctor avisou".
#
# AS TRÊS CHAVES, E NÃO SÓ UMA (17/08/2026) — A PONTE QUE FALTAVA
#   Este `chk_` passava só `VIDRO_AO_MAXIMIZAR`. As `VIDRO_OPACIDADE_*` do
#   meow.conf eram sourceadas por este arquivo e morriam aqui, sem exportar: o
#   `vidro.sh` nunca as via. Enquanto o script tinha padrão embutido, o efeito
#   era só o conf não valer nada. Desde que o padrão virou VAZIO ("a opacidade é
#   da GUI"), a ponte passou a ser obrigatória — sem ela, escrever um valor no
#   conf não teria efeito nenhum e o silêncio seria pior que o atropelo.
chk_vidro() {
  MEOW_DRY_RUN=1 VIDRO_AO_MAXIMIZAR="${VIDRO_AO_MAXIMIZAR:-sim}" \
    VIDRO_OPACIDADE="${VIDRO_OPACIDADE:-}" \
    VIDRO_OPACIDADE_PAINEL="${VIDRO_OPACIDADE_PAINEL:-}" \
    VIDRO_OPACIDADE_DOCK="${VIDRO_OPACIDADE_DOCK:-}" \
    "$RAIZ/scripts/vidro.sh" 2>&1
}

# A geometria das barras entra aqui pela MESMA razão das três acima, e com a
# lição já paga uma vez: o `forma.sh` passou a existir sem que o `install.sh`
# nem o `doctor` o chamassem, de modo que a única cópia da geometria era a que
# estava no disco dela. Config do COSMIC é reescrita pela GUI — basta ela mexer
# num controle de painel para o `expand_to_edges` voltar, e sem esta linha
# ninguém acusaria.
chk_forma() {
  MEOW_DRY_RUN=1 rodar_forma "$RAIZ" 2>&1
}

# O `painel` confere DUAS coisas que a `forma` não vê: se o raio no disco cabe
# na altura real da barra, e se o supervisor do Meow está de pé. As duas juntas
# são o que separa "a barra some do nada" de "a barra volta sozinha".
chk_painel() {
  MEOW_DRY_RUN=1 rodar_painel "$RAIZ" conferir 2>&1
  local rc=$?
  if [ -d "/run/user/$(id -u)/systemd" ] \
     && [ "$(systemctl --user is-active meow-painel.service 2>/dev/null)" != "active" ] \
     && [ -f "$HOME/.config/systemd/user/meow-painel.service" ]; then
    printf 'o supervisor do painel está parado — a barra não volta sozinha se cair\n'
    return "$MEOW_DIVERGENTE"
  fi
  return "$rc"
}

