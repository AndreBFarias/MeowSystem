fix_painel()    {
  rodar_painel "$RAIZ" conferir 2>&1
  local rc=$?
  # Religar o supervisor é conserto, e é barato: ele não escreve config nenhuma
  # e não pisca a tela — só passa a repor o painel se ele cair.
  [ -f "$HOME/.config/systemd/user/meow-painel.service" ] \
    && systemctl --user start meow-painel.service >/dev/null 2>&1
  return "$rc"
}
