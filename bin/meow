# OS TRÊS QUE A PONTE DESTRAVOU — 08/09/2026
#   Eles não existiam: estavam em `SEM_CONSERTO` porque o conserto precisava de
#   sudo e o doctor não pede senha. Com a ponte root no ar isso deixou de ser
#   verdade, e o `SEM_CONSERTO` lá em cima já os tira da lista sozinho quando ela
#   responde. Sem ponte, estas funções continuam existindo e simplesmente nunca
#   são chamadas — é o `SEM_CONSERTO` que decide, num lugar só.
#
#   O `ocultar` roda INTEIRO (ele já sabe pular o que não consegue) e o
#   `absolutos` idem; o `lancadorapt` chama a ponte direto, porque instalar o
#   hook é um verbo dela e não tem script intermediário.
fix_ocultar()   { LANCADOR_SISTEMA="${LANCADOR_SISTEMA:-nao}" \
                    "$RAIZ/scripts/ocultar_apps.sh" 2>&1; }
fix_absolutos() { LANCADOR_SISTEMA="${LANCADOR_SISTEMA:-nao}" \
                    "$RAIZ/scripts/icones_absolutos.sh" 2>&1; }
fix_lancadorapt() {
  if [ "${LANCADOR_SISTEMA:-nao}" != "sim" ]; then
    # A MESMA CERCA DA ETAPA DO INSTALADOR: remover arquivo de /etc pede decisão
    # ESCRITA, nunca chave ausente. Ver `meow_conf_diz` no `lib/comum.sh` — foi
    # este caminho, com a ponte no ar, que apagou o hook da máquina em 08/09.
    if ! meow_conf_diz LANCADOR_SISTEMA nao; then
      meow_aviso "o meow.conf não diz LANCADOR_SISTEMA=\"nao\" — não removo o hook"
      return "$MEOW_SEM_DEPENDENCIA"
    fi
    meow_ponte apt-hook-remover 2>&1 && meow_ok "hook de apt removido pela ponte"
    return $?
  fi
  if meow_ponte apt-hook-instalar 2>&1; then
    meow_ok "hook de apt reposto pela ponte"
    return "$MEOW_DIVERGENTE"
  fi
  meow_aviso "a ponte não repôs o hook de apt"
  return "$MEOW_ERRO"
}
fix_assets()    { ASSETS_VIGIA="${ASSETS_VIGIA:-sim}" \
                    "$RAIZ/scripts/vigia_assets.sh" --aplicar 2>&1; }
fix_atalho()    { "$RAIZ/scripts/atalho.sh" --aplicar 2>&1; }
# Conserta o que é aritmética (o `transform-origin` achatado) e continua
# devolvendo 1 pelo que não é — uma peça fora da tela por outra razão fica
# apontada pelo nome, porque adivinhar a intenção de um desenho é o único jeito
# de estragar o desenho dela.
fix_svg()       { local pastas=() p
                  meow_tem python3 || return 0
                  for p in assets/gatos assets/icones/autorais assets/icones/overrides; do
                    [ -d "$RAIZ/$p" ] && pastas+=("$RAIZ/$p")
                  done
                  # Os autorais de cada pack, como no `chk_svg` — o conserto
                  # tem de alcançar tudo o que a conferência alcança, ou o
                  # doctor aponta um defeito que o `--consertar` não conserta.
                  for p in "$RAIZ"/packs/*/icones/autorais; do
                    [ -d "$p" ] && pastas+=("$p")
                  done
                  [ "${#pastas[@]}" -gt 0 ] || return 0
                  python3 "$RAIZ/scripts/normalizar_svg.py" "${pastas[@]}" 2>&1; }
fix_greeter()   { FLAVOR="$FLAVOR" ACCENT="$ACCENT" "$RAIZ/scripts/greeter.sh" 2>&1; }
