# O cursor tem DUAS alavancas (gsettings para as janelas GTK, o
# ~/.icons/default/index.theme para o compositor), e o `conferir` do script olha
# as duas — meia divergência já acusa, que é o certo: metade da tela com cursor
# velho é o defeito, não o meio-termo.
chk_cursor() {
  MEOW_DRY_RUN=1 CURSOR="${CURSOR:-}" CURSOR_VERSAO="${CURSOR_VERSAO:-v2.0.0}" \
    "$RAIZ/scripts/cursor.sh" conferir 2>&1
}

# O PROMPT DO ZSH: O DOCTOR CONFERE A METADE QUE É NOSSA, E SÓ ELA.
#   O `conferir` olha o `~/.config/starship.toml` e o binário do starship, e
#   devolve 0, 1 ou 3. A linha que LIGA o starship é do arquivo de
#   inicialização do shell de quem usa: o MeowSystem não a lê nem a escreve, e
#   o `prompt.sh` só a DIZ, no `aplicar` e no `mostrar`.
#   ATÉ 24/09/2026 (P39) ELE DEVOLVIA 4 quando o toml estava conforme e o
#   `env.zsh` do Spellbook ainda não tinha recebido o patch — o 4 impedia o
#   ping-pong de um `--consertar` incapaz de consertar uma linha que a TRAVA 1
#   proibia escrever. A leitura do `env.zsh` saiu, o patch saiu, e o 4 com
#   eles; o cabeçalho do `scripts/prompt.sh` conta por quê.
#   O `fix_prompt` escreve um arquivo só, e ele é nosso.
#
# O `MEOW_DRY_RUN=1` FALTAVA AQUI TAMBÉM — 24/09/2026 (P44, revisão)
#   Sem starship, o `conferir` passa pelo `_prompt_dizer_falta_starship`, que
#   chama o `meow_pendencia_acionavel` e grava a linha `starship-ausente` em
#   `pendencias.tsv`. Medido pela revisão: o `tests/doctor-so-le.sh` com o
#   `~/.cargo/bin` fora do PATH achou esse arquivo na casa de brinquedo, e era a
#   única escrita que sobrava num bwrap que imita o CI. Aqui ele passava só
#   porque esta máquina tem o starship; o runner do GitHub e um Pop!_OS limpo
#   não têm. Com o seco, o `meow_pendencia_acionavel` diz a frase na tela e
#   devolve antes de tocar o arquivo — a saída e o código são os mesmos.
#   O PREÇO, O MESMO DO `chk_apps`: a pendência deixa de ser renovada pela
#   leitura do doctor. Quem a registra é o `aplicar` (o `install.sh`); o 3 não
#   entra no laço de conserto, então o `fix_prompt` não a registra no doctor.
chk_prompt() {
  MEOW_DRY_RUN=1 PROMPT_STARSHIP="${PROMPT_STARSHIP:-sim}" \
    "$RAIZ/scripts/prompt.sh" conferir 2>&1
}

# AS CORES DO FZF — a etapa nasceu na P44 (24/09/2026), e com as quatro peças
# de uma vez (script, etapa, conferidor, auto-cura): um recurso com duas não
# está entregue, é a lição do `chk_completar`. Confere o arquivo que é NOSSO,
# `~/.config/meowsystem/fzf.sh`, contra a paleta do pack no ar; a linha do
# shell que o carrega é de quem usa e não entra na conta, pelo mesmo motivo do
# `chk_prompt` logo acima. O conserto reescreve um arquivo só, e ele é nosso.
chk_fzf() {
  MEOW_DRY_RUN=1 FLAVOR="$FLAVOR" ACCENT="$ACCENT" "$RAIZ/scripts/fzf.sh" conferir 2>&1
}

# O terminal. Usa `conferir`, que compara pelo MESMO critério do escritor e não
# byte a byte: o RON que gravamos não tem o `\n` final que o cosmic-term põe, e
# um `cmp` acusaria divergência eterna num arquivo perfeito.
chk_terminal() {
  FLAVOR="$FLAVOR" ACCENT="$ACCENT" \
    TERMINAL_ESQUEMA="${TERMINAL_ESQUEMA:-sim}" \
    TERMINAL_CURSOR="${TERMINAL_CURSOR:-accent}" \
    "$RAIZ/scripts/terminal.sh" conferir 2>&1
}

# O logo ANSI do fastfetch. Pode devolver 4, e isso é o DESENHO DA FRONTEIRA,
# não falha: o `.ansi` é nosso, a chave `logo.source` é da Aurora. O runner já
# trata 4 como "é escolha sua" — sem isso o timer das 5h penduraria "o
# auto-reparo corrigiu" na tela dela toda madrugada, sem ter corrigido nada.
chk_fastfetch() {
  # O `MEOW_DRY_RUN=1` é o mesmo de todas as `chk_*` irmãs, e faltava só nesta:
  # o `conferir` do fastfetch chega a escrever o `~/.local/bin/meow-fetch` sem
  # ele. "Conferir é leitura" (linha 35) só é verdade com o seco na frente.
  MEOW_DRY_RUN=1 \
    FASTFETCH_LOGO="${FASTFETCH_LOGO:-sim}" \
    FASTFETCH_LOGO_GATO="${FASTFETCH_LOGO_GATO:-coquinha}" \
    FASTFETCH_LOGO_COLUNAS="${FASTFETCH_LOGO_COLUNAS:-40}" \
    FASTFETCH_LOGO_MODO="${FASTFETCH_LOGO_MODO:-hora}" FASTFETCH_LOGO_DIA="${FASTFETCH_LOGO_DIA:-}" FASTFETCH_LOGO_NOITE="${FASTFETCH_LOGO_NOITE:-}" FASTFETCH_LOGO_CONF="${FASTFETCH_LOGO_CONF:-sim}" LOGO_DIA="${LOGO_DIA:-}" LOGO_NOITE="${LOGO_NOITE:-}" NOITE_INICIO="${NOITE_INICIO:-}" NOITE_FIM="${NOITE_FIM:-}" WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" \
    "$RAIZ/scripts/fastfetch_logo.sh" conferir 2>&1
}

# O MENU DE CONTEXTO DA ÁREA DE TRABALHO — os dois itens de papel de parede.
# Ele NUNCA compila aqui: `--conferir` do files_menu.sh é instantâneo (um `grep`
# de marcador em dois binários). Quando falta o build para a versão instalada,
# ele dispara o auto-build em background e devolve 1 — que é a verdade: está
# divergente agora, e alguém já está cuidando.
chk_files_menu() {
  FILES_MENU="${FILES_MENU:-sim}" FILES_MENU_AUTOBUILD="${FILES_MENU_AUTOBUILD:-sim}" \
    "$RAIZ/scripts/files_menu.sh" --conferir 2>&1
}

# O relógio entra no doctor pela mesma razão do `forma`: config do COSMIC é
# reescrita pela GUI, e sem esta linha uma volta ao padrão de fábrica passaria
# despercebida. A diferença é que aqui a chave TEM botão na GUI — por isso ela
# nasce no conf com o contrato "vazio = não toca". Com a chave vazia este
# verificador devolve 0 sem olhar nada, que é o certo: quando ela não pediu,
# não há divergência a apontar.
chk_relogio() {
  RELOGIO_SEGUNDOS="${RELOGIO_SEGUNDOS:-}" "$RAIZ/scripts/relogio.sh" conferir 2>&1
}

# O lado a lado. Mesmo contrato do relógio — vazio = não toca —, e pela mesma
# razão, agravada: aqui a chave nem precisa da GUI para mudar sozinha, basta um
# `Super+Y` encostado. E há um detalhe que só este verificador enxerga: com
# escopo `PerWorkspace` o atalho NÃO escreve nada em disco (só memória, ver
# `input/actions.rs:1008-1013`), então uma divergência que aparece aqui é sempre
# de escrita — GUI, Tweaks ou mão — e nunca do atalho.
chk_janelas() {
  JANELAS_TILING="${JANELAS_TILING:-}" JANELAS_TILING_ESCOPO="${JANELAS_TILING_ESCOPO:-}" \
    "$RAIZ/scripts/janelas.sh" conferir 2>&1
}

# OS PATCHES DO COMPOSITOR — E É O ÚNICO VERIFICADOR QUE PERGUNTA SOBRE UM
# PROCESSO, NÃO SOBRE UM ARQUIVO (30/08/2026, Sprint U)
#   Todo `apt upgrade` reescreve `/usr/bin/cosmic-comp` e leva junto os patches
#   da Aurora, calado — `/var/lib/aurora` guarda SEIS versões entre 13/07 e
#   26/08, quase semanal. O sintoma chega dias depois (um workspace vazio a mais
#   no painel; a tela azul de novo à noite) e sem causa aparente. Esta linha é
#   onde isso passa a ter nome no mesmo lugar onde ela já olha todo dia.
#
#   Não vai por `notify-send` de propósito: o Não Perturbe dela engoliu 22
#   avisos entre 27 e 28/08/2026.
#
#   Nenhuma chave do meow.conf: não há nada a configurar. Os dois caminhos que
#   ele lê — o `.estado` em `/var/lib/meowsystem/cosmic-comp/` e a `series` em
#   `patches/` — são do sistema e do repositório, não do gosto dela; o script
#   aceita override por variável só para poder ser testado. Até 24/09/2026 este
#   parágrafo os dava ao "lado da Aurora": a P39 trouxe os dois para cá, junto
#   com o build (`meow compositor`), e a frase ficou para trás até a P44.
chk_patches() {
  "$RAIZ/scripts/compositor_patches.sh" conferir 2>&1
}

# O MODO DE LEITURA (30/08/2026, etapa 2 do plano de 29/08)
#   Mesmo contrato do relógio e do lado a lado: `LEITURA_AGENDA` vazio e este
#   verificador devolve 0 SEM OLHAR NADA. É a única resposta honesta quando ela
#   não pediu — e é o que faz esta linha nascer verde numa máquina que ainda não
#   tem a chave no meow.conf.
#
#   E ele pode devolver 4, que o `rotulo_rc` pinta `--`: o applet da topbar tem
#   um interruptor "Agendar", e com ele desligado o degrau da tela é o que ela
#   arrastou no slider, não o que o relógio pede. Chamar isso de divergência
#   mandaria o `--consertar` desfazer a escolha dela às 5h da manhã.
#
#   SEM LISTA DE `export` AQUI, de propósito: o `set -a` do `carregar_conf` já
#   exporta toda chave do meow.conf, e lista fixa é a armadilha nº 3 — foi ela
#   que matou seis chaves `FORMA_*` em 25/08 com o doctor dizendo "já conforme".
chk_leitura() {
  "$RAIZ/scripts/leitura.sh" conferir 2>&1
}

# O APPLET DO MODO DE LEITURA ENTRA COM UM NOME SÓ, E ISSO É UMA ESCOLHA
# DIFERENTE DA DO APPLET DE MÍDIA (30/08/2026)
#   Lá são dois — `midiabin` compila, `midia` planta a sombra —, porque o laço
#   de conserto dá `continue` pelo NOME antes de olhar o código de saída: com um
#   nome só em SEM_CONSERTO, o doctor perderia junto o conserto da sombra órfã,
#   que ele SABE fazer (é um `rm` no home dela). E lá isso custa caro: sombra sem
#   binário MASCARA o applet do flatpak e deixa a dock com um buraco onde havia
#   um applet que funcionava.
#
#   Aqui não existe applet de fábrica por trás. O nosso é o único que responde
#   por `com.meowsystem.AppletLeitura`; se o binário sumir, o pior caso é um
#   espaço vazio na topbar, e o `leitura_build.sh --conferir` diz numa linha qual
#   comando o fecha. Um segundo verificável para essa diferença seria mais
#   superfície do que conserto — e superfície que envelhece sozinha.
#
#   Compilar continua não sendo trabalho do doctor: o caminho do `cargo` é
#   inalcançável sem `LEITURA_COMPILAR=1`, e quem exporta essa chave é o
#   `install.sh`. Por isso `leiturabin` está em SEM_CONSERTO.
#
#   Sem lista de `export` aqui, pelo mesmo motivo do `chk_leitura`: o `set -a` do
#   `carregar_conf` já exporta toda chave do meow.conf, e lista fixa é a
#   armadilha que matou seis chaves `FORMA_*` em 25/08 com o doctor dizendo "já
#   conforme".
chk_leiturabin() {
  "$RAIZ/scripts/leitura_build.sh" --conferir 2>&1
}

# O autostart bloqueado. Devolve 3 (e não 1) quando não há systemd de usuário ao
# alcance, então o doctor fica quieto em vez de gritar todo dia numa máquina
# onde o assunto não se aplica.
chk_autostart() {
  AUTOSTART_BLOQUEADOS="${AUTOSTART_BLOQUEADOS:-}" "$RAIZ/scripts/autostart.sh" conferir 2>&1
}


# ===========================================================================
# AS SETE ETAPAS QUE O INSTALADOR TINHA E O DOCTOR NÃO — 21/09/2026
# ===========================================================================
# A auditoria de pontas soltas contou sete etapas do `install.sh` sem uma linha
# nesta tabela: `cli`, `pacotes`, `escala`, `upstream`, `fontes`, `logo` e
# `autoreparo`. Uma etapa sem conferência é uma etapa que só se sabe torta
# quando alguém reinstala tudo — e três delas (`pacotes`, `upstream`, `fontes`)
# são as ÚNICAS do projeto que tocam rede ou `apt`, ou seja, as que mais têm
# motivo de estar diferentes numa máquina que não é a de ontem.
#
# `autoreparo` VEM PRIMEIRO, E NÃO É ORDEM ALFABÉTICA
#   É ele que põe o `meow-doctor.timer` de pé, e é o timer que faz o resto desta
#   tabela convergir sozinho às 5h. Sem esta linha, a única conferência que o
#   projeto não fazia era a do mecanismo que faz todas as outras acontecerem: o
#   auto-reparo podia estar desarmado há semanas e o doctor diria "nada a
#   consertar" na cara de quem o rodasse na mão.
#
# TODAS LEEM E NENHUMA ESCREVE, como o resto desta seção. As três que tocariam
# rede ou `apt` não ganham conserto automático — ver `SEM_CONSERTO` mais abaixo,
# com o motivo de cada uma escrito por nome.

chk_autoreparo() {
  local destino="$HOME/.config/systemd/user" u faltam=() difere=()

  # Desligado por escolha dela é 3, não 1: o doctor não briga com o meow.conf.
  # Mas desligado NO CONF e ligado NO DISCO é divergência de verdade — é o caso
  # que o `etapa_autoreparo` chama de "desligar tem de DESLIGAR".
  if [ "${AUTO_REPARO:-sim}" != "sim" ]; then
    if [ -f "$destino/meow-doctor.timer" ] || [ -f "$destino/meow-doctor.service" ]; then
      echo "AUTO_REPARO=\"${AUTO_REPARO:-}\" no meow.conf, mas o meow-doctor continua em $destino"
      return "$MEOW_DIVERGENTE"
    fi
    echo "AUTO_REPARO=\"${AUTO_REPARO:-}\" — sem reparo automático, por escolha sua"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  if ! meow_tem systemctl || [ ! -d "/run/user/$(id -u)/systemd" ]; then
    echo "não há systemd --user nesta sessão — rode 'meow doctor --consertar' na mão"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  for u in meow-doctor.service meow-doctor.timer; do
    [ -f "$RAIZ/systemd/$u" ] || { echo "falta $RAIZ/systemd/$u — repositório incompleto"; return "$MEOW_ERRO"; }
    if [ ! -f "$destino/$u" ]; then faltam+=("$u"); continue; fi
    meow_mesmo_conteudo "$RAIZ/systemd/$u" "$destino/$u" || difere+=("$u")   # a régua de quem as grava
  done

  # INSTALADO NÃO É LIGADO, e o seco do instalador já aprendeu isso em 31/08:
  # com as duas unidades iguais às do repositório e o timer DESARMADO, olhar só
  # o arquivo daria um `ok` verde numa máquina onde o reparo não dispara nunca.
  # `is-enabled`/`is-active` são leitura pura — cabem numa conferência.
  local armado=1
  [ "$(systemctl --user is-enabled meow-doctor.timer 2>/dev/null)" = "enabled" ] || armado=0
  [ "$(systemctl --user is-active  meow-doctor.timer 2>/dev/null)" = "active"  ] || armado=0

  if [ "${#faltam[@]}" -gt 0 ] || [ "${#difere[@]}" -gt 0 ] || [ "$armado" = "0" ]; then
    [ "${#faltam[@]}" -gt 0 ] && echo "não estão instaladas: ${faltam[*]}"
    [ "${#difere[@]}" -gt 0 ] && echo "diferentes das do repositório: ${difere[*]}"
    [ "$armado" = "0" ] && echo "o meow-doctor.timer não está armado — o reparo das 5h não dispara"
    return "$MEOW_DIVERGENTE"
  fi
  echo "auto-reparo ligado (meow-doctor.timer, todo dia às 5h, com até 20min de folga)"
  return 0
}

# A CLI COPIADA CONTRA A DO CLONE. A cópia é de propósito (ver `etapa_cli`): um
# symlink para o Ápate deixaria a CLI inútil justamente no dia em que o disco não
# montasse. O preço da cópia é este: ela ENVELHECE, e nada avisava. Um `git pull`
# no clone deixava a pessoa rodando a CLI da semana passada, com o doctor da
# semana passada, sem uma linha na tela dizendo isso.
#
# O ponteiro da raiz entra junto porque é a outra metade da mesma etapa: sem ele
# a CLI e a completion não acham o clone, e o sintoma ("não achei o repositório")
# não diz qual dos dois arquivos está faltando.
#
# O `$PATH` sai como AVISO e não como divergência: ele é do shell dela, não do
# disco, e nenhum conserto nosso o altera — é linha de `.zshrc`, que é dela.
chk_cli() {
  local alvo="$HOME/.local/bin/meow" ponteiro="$MEOW_ESTADO/raiz" ruins=() extra="" aponta
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) extra="aviso: ~/.local/bin não está no \$PATH — o comando 'meow' não vai ser achado" ;;
  esac

  if [ ! -f "$alvo" ]; then
    echo "~/.local/bin/meow não existe — quem instala a CLI é o ./install.sh"
    [ -n "$extra" ] && echo "$extra"
    return "$MEOW_DIVERGENTE"
  fi
  # A régua do `meow_escrever`, que é quem instala a CLI (ver meow_mesmo_conteudo).
  meow_mesmo_conteudo "$alvo" "$RAIZ/bin/meow" || ruins+=("a CLI em ~/.local/bin/meow está diferente do bin/meow deste clone")
  [ -x "$alvo" ] || ruins+=("~/.local/bin/meow está sem bit de execução — seria um 'command not found' inexplicável")
  if [ ! -f "$ponteiro" ]; then
    ruins+=("$ponteiro não existe — a CLI e a completion não acham o clone")
  else
    aponta="$(cat "$ponteiro" 2>/dev/null)"
    [ "$aponta" = "$RAIZ" ] || ruins+=("$ponteiro aponta para '$aponta', e este clone é '$RAIZ'")
  fi

  if [ "${#ruins[@]}" -gt 0 ]; then
    printf '%s\n' "${ruins[@]}"
    [ -n "$extra" ] && echo "$extra"
    return "$MEOW_DIVERGENTE"
  fi
  echo "a CLI instalada é byte a byte o bin/meow, e o ponteiro da raiz confere"
  [ -n "$extra" ] && echo "$extra"
  return 0
}

# OS PACOTES, E A LISTA VEM DO `install.sh` — NUNCA COPIADA PARA CÁ
#   Copiar os sete pares `binário -> pacote` daria duas listas para a mesma
#   verdade, e a segunda envelheceria no primeiro pacote novo: é a armadilha nº 3
#   do projeto, que já custou seis chaves `FORMA_*` em 25/08. Aqui a lista é
#   DERIVADA do `local -A NECESSARIOS=(…)` do `etapa_pacotes`, que continua sendo
#   o dono único. Se o `sed` não achar nada, isto devolve erro em vez de dizer
#   "está tudo certo" sem ter conferido — que é o pior jeito de errar.
#
#   AS DUAS QUE NÃO CABEM NO ARRAY estão repetidas aqui de propósito, e o motivo
#   é que elas não têm binário para testar: o Papirus se confere pelo diretório
#   do tema, e o numpy, por um `import` no `python3` do PATH (esta máquina tem
#   pyenv, e quem roda os scripts é o `/usr/bin/python3`, não o do shell). São as
#   duas únicas linhas duplicadas desta conferência, e se uma terceira nascer no
#   `etapa_pacotes` fora do array, ela NÃO vai aparecer aqui — está dito.
#
#   Não tem conserto automático: instalar pacote é `sudo apt-get`, e o doctor
#   nunca usa sudo nem baixa nada (ver o cabeçalho deste arquivo).
chk_pacotes() {
  local faltam=() par bin pac
  while IFS= read -r par; do
    [ -n "$par" ] || continue
    bin="${par%%=*}"; bin="${bin#[}"; bin="${bin%]}"
    pac="${par#*=}"
    meow_tem "$bin" || faltam+=("$pac")
  done < <(sed -n '/^etapa_pacotes()/,/^}/p' "$RAIZ/install.sh" \
           | grep -oE '^[[:space:]]*\[[a-zA-Z0-9_.+-]+\]=[a-zA-Z0-9_.+-]+' \
           | tr -d '[:blank:]')
  [ "${#faltam[@]}" -gt 0 ] || {
    # Zero faltando pode ser "está tudo instalado" ou "não li lista nenhuma", e
    # os dois casos são indistinguíveis daqui sem esta pergunta.
    local lidos
    lidos="$(sed -n '/^etapa_pacotes()/,/^}/p' "$RAIZ/install.sh" \
             | grep -cE '^[[:space:]]*\[[a-zA-Z0-9_.+-]+\]=[a-zA-Z0-9_.+-]+')"
    [ "${lidos:-0}" -gt 0 ] || { echo "não consegui ler a lista de pacotes do install.sh"; return "$MEOW_ERRO"; }
  }
  [ -d /usr/share/icons/Papirus-Dark ] || faltam+=(papirus-icon-theme)
  python3 -c 'import numpy' 2>/dev/null || faltam+=(python3-numpy)

  [ "${#faltam[@]}" -eq 0 ] && { echo "todos os pacotes necessários já estão instalados"; return 0; }
  echo "faltam: ${faltam[*]}"
  echo "  sudo apt-get install -y --no-install-recommends ${faltam[*]}"
  return "$MEOW_DIVERGENTE"
}

# A escala da tela. O `--conferir` do próprio script, que só lê as saídas ligadas
# — mesmo caminho do `chk_pastasxdg` e do `chk_atalho`. `ESCALA_TELA` vazio é
# resposta legítima: "a escala é da GUI, não mexo".
chk_escala() {
  ESCALA_TELA="${ESCALA_TELA:-}" "$RAIZ/scripts/escala.sh" --conferir 2>&1
}

# O upstream pinado, EM SECO, e é o seco que mantém o doctor offline: o
# `baixar_upstream.sh` sob `MEOW_DRY_RUN=1` só pergunta ao `git -C … rev-parse`
# em que commit cada clone está, e diz "baixaria" se estiver fora do SHA pinado.
# Nenhum `git clone` acontece nesse caminho — conferido linha a linha em 21/09.
chk_upstream() {
  MEOW_DRY_RUN=1 "$RAIZ/scripts/baixar_upstream.sh" 2>&1
}

# As fontes. `--conferir` liga o `MEOW_SECO` do próprio script, e o `curl` da
# release pinada mora do outro lado de um `elif meow_seco` — o conferidor para
# em "baixaria o JetBrainsMono.tar.xz e instalaria as 16 faces". O doctor nunca
# baixa, e por isso `fontes` também não tem conserto automático aqui.
#
#   E A SAÍDA PERDE AS LINHAS EM BRANCO DA FRENTE, que não é capricho: o
#   `instalar_fontes.sh` abre com um `meow_passo`, e `meow_passo` começa por uma
#   linha vazia. A coluna da direita desta tabela é a PRIMEIRA linha da saída —
#   medido em 21/09/2026, a linha do `fontes` saía com a célula em branco, que é
#   o mesmo buraco descrito no cabeçalho do `rodar_checks`. O `rc` é guardado
#   antes do cano, senão quem responderia seria o `sed`.
chk_fontes() {
  local saida rc
  saida="$("$RAIZ/scripts/instalar_fontes.sh" --conferir 2>&1)"; rc=$?
  printf '%s\n' "$saida" | sed '/./,$!d'
  return "$rc"
}

# O gato do painel. O `--conferir` do `logo.sh` responde pelo gato que está no ar
# e pelo acervo — que é o que muda todo dia.
#
# O QUE ESTA LINHA NÃO CONFERE, e é melhor dizer do que prometer: a unidade
# `meow-logo.service` da rotação por encerramento de sessão continua sendo
# assunto do `etapa_logo`, porque o conserto dela é instalar e ligar unidade do
# systemd, e o `logo.sh` não tem esse verbo. Acusá-la aqui daria uma divergência
# que o `fix_logo` não sabe consertar — alarme diário que ninguém pode calar, que
# é o defeito que o `SEM_CONSERTO` existe para evitar.
#
# O `MEOW_DRY_RUN=1` FALTAVA AQUI, E ERA O DOCTOR MATANDO O PAINEL — 24/09/2026 (P44)
#   O `--conferir` do `logo.sh` liga só o `CONFERIR=1` dele, e esse nome não é
#   lido por linha nenhuma daquele arquivo: quem segura cada escrita lá dentro
#   é o `meow_seco`, e o seco só nasce do `MEOW_DRY_RUN`. Sem ele, "conferir"
#   era o `aplicar` inteiro. Medido com `HOME=$(mktemp -d) meow doctor`, pkill
#   e kill trocados por registradores: 13 arquivos gravados na casa de
#   brinquedo (os cinco gatos, os dois botões do dock, o `.ansi`, o
#   `meow-fetch`, estado e manifesto) e um `pkill -x cosmic-panel` — o
#   `painel.sh reciclar` via "gato do dock trocado" e mirava o painel de
#   VERDADE, que não é daquela casa. Na casa de verdade, pelo mesmo código, o
#   caminho abre sempre que o dock está atrás da hora — entre a virada da fase
#   e o tique seguinte do `meow-gato.timer`: um doctor sem `--consertar` nessa
#   janela trocava o gato e piscava a barra.
#   Com o seco, o `logo.sh` diz "mudaria" e sai 1; quem escreve e recicla é o
#   `fix_logo`, que é o lugar disso.
chk_logo() {
  MEOW_DRY_RUN=1 FLAVOR="$FLAVOR" LOGO="$LOGO" "$RAIZ/scripts/logo.sh" --conferir 2>&1
}

# --- 5. os consertos --------------------------------------------------------
# NENHUM deles força `MEOW_DRY_RUN=0`. Forçar seria transformar
# `MEOW_DRY_RUN=1 meow doctor --consertar` — o jeito de auditar antes de deixar
# rodar — num comando que escreve de verdade. Aqui a variável é herdada, e cada
# script chamado já sabe respeitá-la.
fix_gerar() {
  # O `gerar_temas.py` NÃO CONHECE `MEOW_DRY_RUN` — 22/09/2026
  #   A frase do bloco acima ("cada script chamado já sabe respeitá-la") não
  #   vale para ele: `grep MEOW_DRY_RUN scripts/gerar_temas.py` não casa nada, e
  #   ele escreve os três `.ron` de verdade. O irmão dele, o `gerar_tema_v1.py`,
  #   sabe (`conferir = args.conferir or seco`) — por isso só este lado precisa
  #   da recusa. MEDIDO em 22/09/2026, com um `.ron` adulterado de propósito e
  #   `MEOW_DRY_RUN=1 meow doctor --consertar`: o md5 do arquivo MUDOU. O
  #   defeito é anterior a hoje, pelo caminho do rc=1; a linha logo abaixo, que
  #   passa a chamar o `fix_gerar` também quando os `.ron` ainda não nasceram,
  #   o poria no caminho de TODA máquina recém-clonada — e `MEOW_DRY_RUN=1` é
  #   justamente o jeito de auditar antes de deixar rodar.
  #   É a mesma recusa do `meow tema capturar` no seco (`cmd_tema`), pelo mesmo
  #   motivo e com a mesma frase: a promessa "no seco não se escreve nada" é do
  #   `meow`, e quem a mantém é quem chama, quando o chamado não sabe.
  #   A outra metade — o `gerar_tema_v1.py` — não é chamada aqui no seco porque
  #   no seco ela vira `--conferir`, e o `chk_gerar` já a conferiu uma linha
  #   antes: chamá-la de novo só repetiria a mesma frase na tela.
  meow_seco && {
    meow_muda "geraria os .ron da paleta em $MEOW_ESTADO/temas/ e a v1 das capturas"
    return "$MEOW_DIVERGENTE"
  }
  python3 "$RAIZ/scripts/gerar_temas.py" 2>&1 || return "$MEOW_ERRO"
  python3 "$RAIZ/scripts/gerar_tema_v1.py" 2>&1 || return "$MEOW_ERRO"
  return "$MEOW_DIVERGENTE"
}
