# estado que o instalador desfaz na passagem seguinte — o pingue-pongue silencioso
# que o `fix_resgatados` logo abaixo já documenta do outro lado.
# O SOM ENTROU NO DOCTOR EM 18/09/2026 — antes disso ele era o único subsistema
# do projeto que ninguém conferia. O `meow doctor` dizia "está tudo no lugar"
# sem nunca olhar para o som, então um `apt upgrade` que repusesse o arquivo de
# fábrica passava despercebido até alguém notar o bipe diferente.
# A chave `SOM` viaja junto: sem ela o `som.sh conferir` responderia sobre um
# estado diferente do que o `aplicar` produziria.
chk_som() { SOM="${SOM:-sim}" "$RAIZ/scripts/som.sh" conferir 2>&1; }
fix_som() { SOM="${SOM:-sim}" "$RAIZ/scripts/som.sh" aplicar 2>&1; }

