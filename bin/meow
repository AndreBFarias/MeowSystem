# O par do `chk_autoreparo`, e o único desta leva de 21/09 que mexe em systemd.
# Ele faz as DUAS coisas que a conferência sabe separar: põe as unidades no disco
# e ARMA o timer. Uma só delas deixaria a máquina naquele estado de 31/08 em que
# o arquivo está certo e o reparo não dispara nunca.
#
# `MEOW_DRY_RUN=1 meow doctor --consertar` continua sendo auditoria: o seco sai
# antes de qualquer escrita, dizendo o que faria. O `mkdir` do estado vem junto
# porque é ele que o `StandardOutput=append:` da unidade exige ANTES do primeiro
# disparo — sem o diretório, a unidade morre em "Failed to set up standard
# output", medido em 04/08/2026 e registrado no `etapa_autoreparo`.
fix_autoreparo() {
  local destino="$HOME/.config/systemd/user" u rc
  if meow_seco; then
    meow_muda "instalaria as unidades do auto-reparo e armaria o meow-doctor.timer"
    return "$MEOW_DIVERGENTE"
  fi
  mkdir -p "$destino" "$MEOW_ESTADO" || { meow_erro "não consegui criar $destino"; return "$MEOW_ERRO"; }
  for u in meow-doctor.service meow-doctor.timer; do
    [ -f "$RAIZ/systemd/$u" ] || { meow_erro "falta systemd/$u — repositório incompleto"; return "$MEOW_ERRO"; }
    meow_escrever "$destino/$u" "$(cat "$RAIZ/systemd/$u")" 644
    rc=$?
    [ "$rc" -ge 2 ] && { meow_erro "não consegui instalar $u"; return "$MEOW_ERRO"; }
  done
  systemctl --user daemon-reload >/dev/null 2>&1
  if ! systemctl --user enable --now meow-doctor.timer >/dev/null 2>&1; then
    meow_erro "não consegui armar o meow-doctor.timer"
    return "$MEOW_ERRO"
  fi
  meow_ok "auto-reparo ligado (meow-doctor.timer, todo dia às 5h, com até 20min de folga)"
  return "$MEOW_DIVERGENTE"
}

# `conf` não tem conserto próprio de propósito: quem cria o meow.conf é o
# `install.sh`, que sabe o que fazer quando ele não existe. Duas criações do
# mesmo arquivo em lugares diferentes é como se ganha um arquivo pela metade.
VERIFICAVEIS=(conf ponte gerar tema modo vidro forma painel janelas patches relogio leitura leiturabin greeter cursor prompt fzf terminal som fastfetch files_menu icones completar hicolor mimetypes iconesapps resgatados arcticons dracula convertidos sistema bandeja traysteam trayzapzap jogos jogosheroic ocultar absolutos nomes lancadorapt pastasxdg pastas wallpaper fundo apps heroictema midiabin midia assets svg flatpak steamvigia heroicvigia qtvigia autostart atalho autoreparo cli pacotes escala upstream fontes logo)
# A PONTE MOVE TRÊS ITENS DAQUI — 08/09/2026
#   `ocultar`, `absolutos` e `lancadorapt` recusavam conserto pela MESMA razão:
#   "o conserto usa sudo, e o doctor não usa". Com a ponte root instalada isso
#   deixa de ser verdade — ela é um programa de root de verbos fechados, liberado
#   sem senha em `/etc/sudoers.d`, e o doctor pode chamá-la sem pedir nada a
#   ninguém. Sem ponte, a lista volta inteira e a frase volta a valer.
#
#   `ponte` fica SEMPRE aqui: instalar a ponte é a única coisa do projeto que
#   escreve em `/etc/sudoers.d`, e um auto-reparo por relógio não escreve em
#   `/etc/sudoers.d` — essa continua sendo uma decisão que passa por ela, no
#   `./install.sh`, com a senha na mão.
SEM_CONSERTO=" conf ponte convertidos heroictema midiabin leiturabin cursor patches cli pacotes upstream fontes "
if ! meow_ponte_viva; then
  SEM_CONSERTO=" conf ponte ocultar absolutos convertidos lancadorapt heroictema midiabin leiturabin cursor patches cli pacotes upstream fontes "
fi

# A razão é POR NOME. Enquanto `conf` era o único item sem conserto, a frase
# fixa "é o install.sh que cria" servia; com o `ocultar` ela passaria a mentir —
# o motivo dele é outro (sudo), e um motivo errado na tela é pior que nenhum,
# porque manda a pessoa procurar no lugar errado.
#
# `cursor` E `fontes` DEIXARAM DE BAIXAR SEMPRE — 23/09/2026, revisão da P12.
#   Desde a P12 o pack pode trazer o ponteiro e as fontes dentro dele, e o
#   conserto de parte das divergências (o "difere do que o pack traz", a fonte
#   que mora dentro do pack) é uma cópia local, sem rede. A frase dizia "o
#   conserto BAIXA", e com o ponteiro do pack ela mandava a pessoa rodar o
#   comando pelo motivo errado. O que continua verdade é mais estreito: o
#   conserto PODE baixar — e o doctor, que não sabe de antemão qual dos casos
#   é, não roda o que pode baixar.
declare -A SEM_CONSERTO_RAZAO=(
  [conf]="é o install.sh que cria"
  [ponte]="escrever em /etc/sudoers.d é decisão sua, com a senha na mão — rode: ./install.sh"
  [ocultar]="o conserto usa sudo, e o doctor não usa — rode: meow ativar"
  [absolutos]="o conserto usa sudo, e o doctor não usa — rode: meow ativar"
  [convertidos]="reconverter trocaria arte que você aprovou por arte que ninguém viu — rode: ./scripts/construir_convertidos.sh"
  [heroictema]="não dá para adivinhar a forma nova do handler — leia o app.asar e ajuste assets/temas-de-apps/heroic/manifesto.sh"
  [lancadorapt]="instalar em /etc e /usr/local/sbin usa sudo, e o doctor não usa — rode: meow ativar"
  [midiabin]="o conserto compila com o cargo, e o doctor não compila nem baixa — rode: MIDIA_COMPILAR=1 ./scripts/midia_build.sh"
  [leiturabin]="o conserto compila com o cargo, e o doctor não compila nem baixa — rode: LEITURA_COMPILAR=1 ./scripts/leitura_build.sh"
  [cursor]="o conserto pode BAIXAR o ponteiro que nem o disco nem o pack trazem, e o doctor não roda o que pode baixar — rode: ./scripts/cursor.sh aplicar"
  [patches]="o conserto RECOMPILA o cosmic-comp (~4 min) e instala com sudo, e o doctor não compila nem usa sudo — rode: meow compositor"
  [cli]="quem copia a CLI para ~/.local/bin é o instalador, e uma CLI que se reescreve no meio da própria execução é decisão sua — rode: ./install.sh"
  [pacotes]="instalar pacote é sudo apt-get, e o doctor não usa sudo — rode a linha que ele imprime, ou ./install.sh"
  [upstream]="o conserto CLONA da rede, e o doctor não baixa — rode: ./scripts/baixar_upstream.sh"
  [fontes]="o conserto pode BAIXAR a Nerd Font pinada, ou uma fonte que o pack pina por URL, e o doctor não roda o que pode baixar — rode: ./scripts/instalar_fontes.sh"
)

# O 3 QUE É NOSSO — 22/09/2026
#   `3` quer dizer "falta uma dependência", e o laço do `--consertar` pula todo
#   `3` com "o conserto não é nosso". A frase era verdadeira enquanto 3 fosse
#   sempre papirus, systemd, rede ou cargo. A P14 criou a exceção: os `.ron`
#   saíram do git e passaram a NASCER em `$MEOW_ESTADO/temas/`, então numa
#   máquina que ainda não os gerou o `chk_gerar` devolve 3 — e ali a coisa que
#   falta é PRODUTO NOSSO, o `fix_gerar` existe, funciona, e é exatamente o que
#   a mensagem do check manda rodar.
#
#   MEDIDO ANTES DESTA LINHA, na mesma rodada de `meow doctor --consertar`:
#     --   gerar       os .ron ainda não foram gerados nesta máquina — 'meow
#                      doctor --consertar' os escreve em .../temas/
#     --   gerar: falta dependência — o conserto não é nosso
#   A tela mandava rodar um comando que respondia que não ia fazer nada. Numa
#   máquina recém-clonada essa é a PRIMEIRA linha do doctor, e a saída oferecida
#   era uma porta fechada.
#
#   É LISTA, E NÃO UM `if` NO LAÇO, pelo mesmo motivo do `SEM_CONSERTO` logo
#   acima: a decisão "este check tem conserto automático" mora num lugar só, por
#   nome, onde se lê de cima a baixo quem está de fora e por quê.
FALTA_NOSSA=" gerar "

# --- 6. o runner das conferências -------------------------------------------
declare -a CHK_NOME=() CHK_RC=() CHK_SAIDA=()

# A TABELA É A SAÍDA, ENTÃO O VERIFICADOR TEM DE FALAR — E DESDE HOJE ELE PODE
# NÃO FALAR (25/08/2026)
#   O `LOG_NIVEL` do meow.conf era inerte: o `lib/comum.sh` grava
#   `MEOW_LOG_NIVEL` no momento do `source`, que aqui acontece ANTES do
#   `carregar_conf`, e as chaves não saíam deste shell. O `set -a` mudou a
#   segunda metade — agora a chave chega a TODO script filho, e lá ela é lida no
#   source, valendo de verdade.
#
#   Medido: `LOG_NIVEL=silencioso ./scripts/relogio.sh conferir` sai com 0 e
#   imprime NADA — `meow_ok` é a primeira coisa que o silêncio cala. A linha da
#   tabela é `primeira_linha` da saída do verificador, então cada linha `ok`
#   ficaria com a coluna da direita em branco: uma tabela de 37 buracos, com o
#   `meow doctor` desta CLI ainda falando (o `MEOW_LOG_NIVEL` daqui é sempre
#   `info`). E `LOG_NIVEL=debug` é o defeito espelhado: medido, o
#   `icones_tray_steam.sh --conferir` imprime `.. alvo: 5405 bytes, mtime …`
#   ANTES do `ok`, e a tabela mostraria o debug no lugar do estado.
#
#   Uma linha de estado não é PROGRESSO, que é o que o `silencioso` promete
#   calar — ela é a resposta que a pessoa pediu. Então os verificadores rodam em
#   `info`, e só eles: o `local` devolve a chave dela ao sair daqui, e o laço de
#   conserto (que imprime a saída crua) continua obedecendo o meow.conf.
rodar_checks() {
  CHK_NOME=(); CHK_RC=(); CHK_SAIDA=()
  local nome saida rc
  local LOG_NIVEL=info; export LOG_NIVEL
  for nome in "${VERIFICAVEIS[@]}"; do
    saida="$("chk_$nome" 2>&1)"; rc=$?
    CHK_NOME+=("$nome"); CHK_RC+=("$rc"); CHK_SAIDA+=("$saida")
  done
}

# Preenche até <largura> CARACTERES. O `%-12s` do printf conta BYTES, e em UTF-8
# "diretório" ocupa 10 bytes para 9 caracteres — toda coluna com acento saía uma
# casa à esquerda das outras. O `${#var}` do bash conta caractere quando a locale
# é UTF-8, e conta byte quando não é (caso em que empata com o printf, nunca pior).
pad() {
  local t="$1" n=$(( ${2:-0} - ${#1} ))
  [ "$n" -lt 0 ] && n=0
  printf '%s%*s' "$t" "$n" ""
}

# 4 = "divergente por escolha dela" (hoje: a captura de tema está velha porque ela
# mexeu em Aparência). Sai com o mesmo `--` do 3 porque a leitura é a mesma para
# quem olha: não há nada que o auto-reparo deva fazer aqui.
rotulo_rc() {
  case "$1" in
    0) printf '%sok%s  ' "$C_VERDE" "$C_ZERO" ;;
    1) printf '%s~~%s  ' "$C_AMARELO" "$C_ZERO" ;;
    3|4) printf '%s--%s  ' "$C_DIM" "$C_ZERO" ;;
    *) printf '%serro%s' "$C_VERM" "$C_ZERO" ;;
  esac
}

# Primeira linha da saída do verificador: é ela que cabe na tabela.
# Tira o recuo e o glifo de status que o script chamado já imprimiu. Os scripts
# de `scripts/` formatam para a tela DELES — o `meow_muda` começa com dois
# espaços e um `~~` — e esse par, dentro de uma coluna que já tem glifo próprio,
# entorta a tabela e ainda faz parecer erro duplo.
sem_glifo() {
  local l="$1"
  l="${l#"${l%%[![:space:]]*}"}"
  case "$l" in
    'ok '*|'~~ '*|'-- '*|'!! '*|'>> '*|'erro '*)
      l="${l#* }"; l="${l#"${l%%[![:space:]]*}"}" ;;
  esac
  printf '%s' "$l"
}

# Primeira linha da saída do verificador: é ela que cabe na tabela.
primeira_linha() { sem_glifo "${1%%$'\n'*}"; }

# Junta uma lista de uma-por-linha em "a, b, c". O `paste -sd', '` NÃO faz isso:
# ele trata a string como uma LISTA CÍCLICA de delimitadores e alterna vírgula e
# espaço, saindo "a,b c,d".
em_linha() { paste -sd, - | sed 's/,/, /g'; }

imprimir_check() {
  local i="$1" detalhar="${2:-0}" linha
  linha="$(primeira_linha "${CHK_SAIDA[$i]}")"
  # 11, e não 10, desde 11/08/2026: `convertidos` é o primeiro nome de
  # verificador com 11 caracteres, e com 10 a coluna da direita saía uma casa
  # fora do prumo só naquela linha.
  printf '  %s %s %s\n' "$(rotulo_rc "${CHK_RC[$i]}")" "$(pad "${CHK_NOME[$i]}" 11)" "$linha"
  if [ "$detalhar" = "1" ] && [ "${CHK_RC[$i]}" != "0" ]; then
    printf '%s\n' "${CHK_SAIDA[$i]}" | tail -n +2 | while IFS= read -r l; do
      l="$(sem_glifo "$l")"
      [ -n "$l" ] || continue
      printf '       %s%s%s\n' "$C_DIM" "$l" "$C_ZERO"
    done
  fi
}

pior_rc() {
  local pior=0 rc
  for rc in "${CHK_RC[@]}"; do
    # 2 (erro) manda em tudo; depois 1 (divergente). 3 (pulado) não é falha.
    [ "$rc" = "2" ] && { printf '2'; return; }
    [ "$rc" = "1" ] && pior=1
  done
  printf '%s' "$pior"
}

# O pior veredito de uma lista de códigos SOLTOS, na ordem 2 > 1 > 3 > 0.
#
# POR QUE O 3 NÃO PODE VIRAR 1 NEM 2 NO MEIO DO CAMINHO
#   `[ "$rc" -ge 2 ]` lê como "erro" e casa com o 3 também. Onde isso apareceu,
#   "falta o papirus-icon-theme" era relatado como erro de execução — MEDIDO com
#   um meow.conf apontando ICONES_BASE para um tema inexistente: o
#   `meow icones reconstruir` saía 2 e o `meow icones` saía 1, quando o contrato
#   manda 3 nos dois casos. A diferença importa: 3 é o código que faz o
#   auto-reparo ficar quieto em vez de tentar consertar o que não é dele.
#
#   Qualquer código fora de {0,1,3} vira 2 de propósito: um script que morre com
#   127 ("comando não encontrado") é erro, e cair no `else` como se fosse 0 seria
#   a CLI dizendo "está tudo certo" sobre uma etapa que nem rodou.
pior_de() {
  local rc pior=0
  for rc in "$@"; do
    case "$rc" in
      0) ;;
      1) [ "$pior" = "2" ] || pior=1 ;;
      3) [ "$pior" = "0" ] && pior=3 ;;
      *) pior=2 ;;
    esac
  done
  printf '%s' "$pior"
}

# --- 7. comandos ------------------------------------------------------------
campo() { printf '    %s%s%s %s\n' "$C_DIM" "$(pad "$1" 12)" "$C_ZERO" "$2"; }

cmd_status() {
  carregar_conf --ponte-opcional || return "$MEOW_ERRO"
  meow_titulo "MeowSystem — estado"

  meow_passo "Configuração"
  campo "arquivo"  "$CONF_LIDA"
  campo "flavor"   "$FLAVOR"
  campo "accent"   "$ACCENT"
  campo "modo"     "$MODO (is_dark=$(is_dark_atual))"

  meow_passo "Tema"
  local alvo ativo
  alvo="$(alvo_tema)"
  campo "alvo"     "$alvo"
  if ativo="$(tema_ativo)"; then
    if [ "$ativo" = "$alvo" ]; then
      campo "ativo"  "$(printf '%s%s%s' "$C_VERDE" "$ativo" "$C_ZERO")"
    else
      campo "ativo"  "$(printf '%s%s%s  (o alvo é %s)' "$C_AMARELO" "$ativo" "$C_ZERO" "$alvo")"
    fi
  else
    campo "ativo"    "$(printf '%snenhum tema pronto confere%s' "$C_AMARELO" "$C_ZERO")"
  fi
  campo "capturas"  "$(capturas | em_linha)"

  meow_passo "Ícones e logo"
  local tema_icones logo_path n_icones
  tema_icones="$(cat "$COSMIC/com.system76.CosmicTk/v1/icon_theme" 2>/dev/null || printf '(nenhum)')"
  logo_path="$(cat "$COSMIC/dev.cappsy.CosmicExtAppletLogoMenu/v1/custom_logo_path" 2>/dev/null || printf '(nenhuma)')"
  n_icones="$(find "$HOME/.local/share/icons/${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
                \( -type f -o -type l \) 2>/dev/null | wc -l)"
  campo "tema"     "$tema_icones"
  campo "arquivos" "$n_icones em ~/.local/share/icons/${NOME_TEMA_ICONES:-MeowSystem-Icons}"
  campo "logo"     "$LOGO  ->  $logo_path"

  meow_passo "Papéis de parede"
  local l
  while IFS= read -r l; do
    campo "${l%%:*}" "$(printf '%s' "${l#*:}" | sed 's/^ *//')"
  done < <(MEOW_DRY_RUN=1 WALLPAPER_BASE="${WALLPAPER_BASE:-}" WALLPAPER_INTERVALO="${WALLPAPER_INTERVALO:-5m}" \
             WALLPAPER_ORDEM="${WALLPAPER_ORDEM:-aleatoria}" \
             WALLPAPER_FONTES_DELA="${WALLPAPER_FONTES_DELA:-}" \
             WALLPAPER_AJUSTE="${WALLPAPER_AJUSTE:-preencher}" \
             WALLPAPER_NOITE="${WALLPAPER_NOITE:-}" WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" \
             WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" WALLPAPER_LIMIAR_LUZ="${WALLPAPER_LIMIAR_LUZ:-}" \
             "$RAIZ/scripts/wallpaper.sh" estado 2>/dev/null)

  meow_passo "Divergências"
  rodar_checks
  local i qtd=0
  for i in "${!CHK_NOME[@]}"; do
    [ "${CHK_RC[$i]}" = "0" ] && continue
    imprimir_check "$i" 0
    qtd=$((qtd+1))
  done
  if [ "$qtd" = "0" ]; then
    meow_ok "nada divergente — tudo no lugar"
  else
    meow_info "detalhes e conserto: meow doctor --consertar"
  fi
  printf '\n'
  return "$(pior_rc)"
}

cmd_doctor() {
  local consertar=0
  # TODOS os argumentos são lidos, não só o primeiro. A versão anterior olhava
  # apenas `$1`, e por isso `meow doctor --consertar --qualquer-coisa` engolia o
  # resto em silêncio — inclusive um erro de digitação numa unidade do systemd,
  # que passaria despercebido até alguém reparar que a opção nunca fez nada.
  while [ $# -gt 0 ]; do
    case "$1" in
      --consertar|-c) consertar=1 ;;
      "") ;;
      *) meow_erro "opção desconhecida: $1"; meow_info "use: meow doctor [--consertar]"; return "$MEOW_ERRO" ;;
    esac
    shift
  done
  carregar_conf --ponte-opcional || return "$MEOW_ERRO"

  meow_titulo "MeowSystem — doctor"
  meow_seco && meow_aviso "MEOW_DRY_RUN=1 — nada será escrito"
  printf '\n'
  rodar_checks
  local i
  for i in "${!CHK_NOME[@]}"; do imprimir_check "$i" 1; done

  # O AVISO DO VIZINHO SEM PROTEÇÃO SAIU EM 24/09/2026 (P39). Ele perguntava
  # se o `~/.config/zsh` era um repositório git fora do `vizinhos.conf` — o
  # repositório de UMA casa, pelo nome, que é a leitura que a regra de 23/09
  # tira do projeto sem terceira via. A lista de vizinhos continua sendo lida
  # (lib/comum.sh) e continua valendo para o que a pessoa escrever nela; o que
  # saiu foi o projeto adivinhar QUEM é vizinho. Nesta casa o arquivo existe
  # desde 11/09 e já protege aquele caminho.

  # O `NOPASSWD: ALL` DA MÁQUINA, QUE ESVAZIA A PONTE — 21/09/2026
  #   Medido ao investigar um resíduo de sessão: `/etc/sudoers.d/<usuário>`,
  #   de 14/04/2026, tem `<usuário> ALL=(ALL) NOPASSWD: ALL`. Com essa linha
  #   no ar, a ponte root do `chk_ponte` não protege nada: a regra estreita que
  #   ela instala — caminho absoluto, nove verbos nomeados, nenhum curinga — é
  #   um subconjunto de uma regra que já libera tudo. E a frase que o projeto
  #   diz na tela, "consertos de sistema sem pedir senha", passa a descrever a
  #   máquina inteira em vez de descrever o projeto.
  #
  #   ELE AVISA E NÃO CONSERTA, e isso é decisão, não preguiça. Apagar a regra
  #   de sudo de alguém sem perguntar é o tipo de ato que este projeto não faz
  #   — e seria o auto-reparo das 5h tirando, todo dia, um acesso que a pessoa
  #   pôs de propósito para outra coisa. O que cabe aqui é dizer que ela está
  #   lá, porque quem lê o `ok` da ponte acima merece saber o que ele vale.
  #
  #   NÃO É UM CHECK, E POR ISSO NÃO ENTRA EM `VERIFICAVEIS`: não há divergência
  #   a relatar (a máquina está como a dona a deixou) nem conserto a oferecer.
  #   É um aviso ao lado da tabela, no mesmo molde do repositório desprotegido
  #   logo acima.
  #
  #   `sudo -n -l` NÃO PEDE SENHA — é o que o doctor das 5h exige de qualquer
  #   coisa que ele rode. Numa máquina onde o sudo pede senha o comando falha
  #   calado, nada casa, e o aviso simplesmente não aparece: o certo, porque ali
  #   não há `NOPASSWD: ALL` nenhum a denunciar. O padrão casa a regra que
  #   termina em `ALL` e não a da ponte, que termina no nome de um verbo.
  if sudo -n -l 2>/dev/null | grep -Eq 'NOPASSWD:[[:space:]]*ALL[[:space:]]*$'; then
    meow_aviso "o sudo desta máquina libera TUDO sem senha para você (NOPASSWD: ALL)"
    meow_info "  enquanto essa regra existir, a ponte root não restringe nada —"
    meow_info "  ela é que permitirá tirá-la, e não o contrário"
    meow_info "  veja de onde vem:  sudo -l   e   ls /etc/sudoers.d"
    meow_info "  o MeowSystem não mexe nela: regra de sudo é sua, não nossa"
  fi

  # A ARTE COPIADA QUE DIVERGIU DA ORIGEM — regra 8 da P28, 23/09/2026
  #   O pack ativo pode trazer arte de terceiro copiada, com a origem no
  #   `PROCEDENCIA.md`. Quando a cópia e a origem se separam, o doctor diz — e
  #   pelo mesmo molde do aviso do sudo logo acima: NÃO É UM CHECK, não entra
  #   em `VERIFICAVEIS` e não passa pelo `--consertar`. Não há conserto
  #   automático possível: escolher entre o retoque daqui e o upstream de lá é
  #   decisão de autor, e um auto-reparo das 5h que escolhesse sozinho
  #   apagaria, um dia, o retoque de alguém.
  #
  #   Silêncio quando está em dia e quando a origem não está nesta máquina — a
  #   dela não tem o `Dracula_OS-Theme`, e "não há com o que comparar" não é
  #   notícia. Só o código 1 (algum lado andou) vira linha.
  #
  #   E ESTA LINHA NÃO LÊ MAIS A CASA DE NINGUÉM — 24/09/2026, P43. Até aqui,
  #   com o Dracula no ar, ela relia a cada passada 364 arquivos do
  #   `Dracula_OS-Theme`, na pasta pessoal de quem escreveu o tema (a coluna
  #   `lido de` do PROCEDENCIA.md dele): a última leitura, em execução, de um
  #   caminho da máquina de alguém. A decisão de 23/09 foi "aposentar tudo". A coluna ficou
  #   vazia nessas linhas, e o `sincronizar` conta linha vazia como só registro,
  #   sem abrir nada fora do pack. O chamado daqui não mudou: ele continua
  #   servindo ao pack de terceiro que declare origem, e à linha do Dracula cuja
  #   origem é o próprio motor. O `tests/sem-dracula-os-theme.sh` cobra isso
  #   abrindo este mesmo `sincronizar` sob um gancho de auditoria.
  local pack_proc; pack_proc="$(meow_pack_dir)"
  if [ -n "$pack_proc" ] && [ -f "$pack_proc/PROCEDENCIA.md" ]; then
    python3 "$RAIZ/scripts/pack.py" sincronizar "$pack_proc" >/dev/null 2>&1
    if [ "$?" = "1" ]; then
      meow_info "o pack $(basename "$pack_proc") tem arte copiada que se separou da origem"
      meow_info "  é informação, não conserto — qual versão fica é decisão sua"
      meow_info "  veja o par lado a lado:  meow pack sincronizar $(basename "$pack_proc")"
    fi
  fi

  local pior; pior="$(pior_rc)"
  if [ "$consertar" = "0" ]; then
    printf '\n'
    case "$pior" in
      0) meow_ok "nada a consertar" ;;
      1) meow_muda "há divergências — rode: meow doctor --consertar" ;;
      *) meow_erro "algo falhou ao conferir; veja os detalhes acima" ;;
    esac
    printf '\n'
    return "$pior"
  fi

  # --- conserto ------------------------------------------------------------
  # O lock é daqui para baixo: até agora só se leu, e ler junto com o timer é
  # inofensivo. Escrever junto não é (regra 10 do contrato).
  meow_travar || return "$MEOW_ERRO"
  meow_passo "Consertando o que falhou"
  local nome rc saida mexeu=0 falhou=0
  for i in "${!CHK_NOME[@]}"; do
    nome="${CHK_NOME[$i]}"
    [ "${CHK_RC[$i]}" = "0" ] && continue
    case "$SEM_CONSERTO" in *" $nome "*)
      meow_pula "$nome: sem conserto automático (${SEM_CONSERTO_RAZAO[$nome]:-é o install.sh que cria})"
      continue ;;
    esac
    # O `FALTA_NOSSA` abre a única porta: ver o bloco dele, ao lado do
    # SEM_CONSERTO. Sem essa linha o `gerar` era pulado por "o conserto não é
    # nosso" — e ali ele é.
    if [ "${CHK_RC[$i]}" = "3" ]; then
      case "$FALTA_NOSSA" in
        *" $nome "*) ;;
        *) meow_pula "$nome: falta dependência — o conserto não é nosso"
           continue ;;
      esac
    fi
    # 4: divergente POR ESCOLHA DELA. Consertar aqui seria desfazer o ajuste que
    # ela acabou de fazer na GUI — e, como o timer roda todo dia, seria desfazer
    # todo dia. É por isso que o 4 existe em vez de reusar o 1: ele sai do laço de
    # conserto sem sair do relatório.
    if [ "${CHK_RC[$i]}" = "4" ]; then
      meow_pula "$nome: é escolha sua, não divergência — o auto-reparo não mexe"
      continue
    fi
    saida="$("fix_$nome" 2>&1)"; rc=$?
    printf '%s\n' "$saida" | sed 's/^/  /'
    case "$rc" in
      0|1) mexeu=1 ;;
      3)   ;;
      *)   falhou=1 ;;
    esac
  done

  registrar "doctor --consertar mexeu=$mexeu falhou=$falhou"
  printf '\n'
  if [ "$falhou" = "1" ]; then
    meow_erro "alguma etapa falhou — nada ficou pela metade, cada uma é independente"
    printf '\n'; return "$MEOW_ERRO"
  fi
  # O CÓDIGO DE SAÍDA É A INTERFACE — 1 SIGNIFICA "DIVERGIA E EU CONSERTEI"
  #   É a mesma regra do `meow_escrever` (lib/comum.sh) e a que o
  #   `meow-doctor.service` lê para decidir se avisa: `SuccessExitStatus=1 3` e a
  #   notificação pendurada no `ExecStopPost` só quando `EXIT_STATUS` é 1. Enquanto
  #   isto aqui devolvia 0 mesmo tendo consertado, aquele aviso NUNCA disparava, e
  #   quem falava era o `meow_notificar` abaixo — que não conhece o
  #   `AUTO_REPARO_NOTIFICAR="nao"` do meow.conf e portanto avisava mesmo quando ela
  #   tinha pedido silêncio.
  #
  #   E POR ISSO O `meow_notificar` SAIU DAQUI
  #   Com o código certo, quem avisa é a unidade — uma vez, e respeitando a
  #   configuração. Mantê-lo aqui daria DUAS notificações para o mesmo conserto.
  #   Rodando na mão não se perde nada: a mensagem já está na tela, logo abaixo.
  if [ "$mexeu" = "1" ]; then
    # No seco os `fix_*` devolvem 1 sem ter escrito nada. Dizer "consertado" aí
    # seria a CLI mentindo justamente no modo que existe para auditar antes de
    # deixar rodar. O código de saída continua 1 — "havia o que consertar".
    if meow_seco; then
      meow_muda "é isto que o conserto FARIA — com MEOW_DRY_RUN=1 nada foi escrito"
    else
      meow_ok "consertado. Confira com: meow doctor"
    fi
    printf '\n'
    return "$MEOW_DIVERGENTE"
  fi
  meow_ok "nada a consertar"
  printf '\n'
  return 0
}

cmd_tema() {
  carregar_conf || return "$MEOW_ERRO"
  local arg="${1:-}"
  case "$arg" in
    "")
      meow_titulo "Tema"
      local ativo
      campo "alvo" "$(alvo_tema)"
      if ativo="$(tema_ativo)"; then campo "ativo" "$ativo"
      else campo "ativo" "nenhuma captura confere"; fi
      campo "modo" "$MODO (is_dark=$(is_dark_atual))"
      printf '\n  %stemas prontos%s\n' "$C_DIM" "$C_ZERO"
      capturas | sed 's/^/    /'
      printf '\n  %smeow tema <nome> aplica · meow tema claro|escuro|auto troca o modo%s\n\n' \
             "$C_DIM" "$C_ZERO"
      return 0 ;;

    claro|escuro|auto)
      MODO="$arg"
      conf_definir MODO "$arg"; local rc_conf=$?
      [ "$rc_conf" -ge 2 ] && { meow_erro "não consegui gravar MODO em $CONF"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      fix_modo; local rc=$?
      case "$rc" in
        0) meow_ok "modo $arg já estava ativo (is_dark=$(is_dark_atual))" ;;
        # No seco a meow_escrever devolve 1 sem ter escrito nada, e já imprimiu
        # o "mudaria". Dizer "aplicado" aqui seria a CLI mentindo sobre o próprio
        # modo de auditoria — o mesmo erro que o --conferir do tema evita.
        1) if meow_seco; then
             meow_muda "modo $arg ficaria valendo (is_dark=$(is_dark_atual) hoje)"
           else
             meow_ok "modo $arg aplicado (is_dark=$(is_dark_atual))"
             registrar "tema modo=$arg"
             notificar "MeowSystem" "Modo $arg."
           fi ;;
        *) meow_erro "não consegui escrever $IS_DARK"; return "$MEOW_ERRO" ;;
      esac
      return "$rc" ;;

    capturar)
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow tema capturar <nome>"; return "$MEOW_ERRO"; }
      # O capturar_tema.sh não conhece MEOW_DRY_RUN — ele escreve em state/ do
      # repo, não na configuração dela. Recusar no seco é o que mantém a promessa
      # "MEOW_DRY_RUN=1 não escreve nada" verdadeira também aqui.
      meow_seco && { meow_muda "capturaria $(python3 "$RAIZ/scripts/pack.py" captura-destino "$1" 2>/dev/null || printf '%s' "$1")"; return "$MEOW_DIVERGENTE"; }
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/capturar_tema.sh" "$1"; local rc=$?
      [ "$rc" = "0" ] && registrar "tema capturar $1"
      return "$rc" ;;

    desfazer) cmd_desfazer ;;

    -h|--help)
      printf 'uso: meow tema [<tema>|claro|escuro|auto|capturar <nome>|desfazer]\n'; return 0 ;;

    *)
      if [ "$arg" = "original" ]; then
        guarda_original "meow tema original" \
          "o tema de antes DESTA máquina é o que o 'meow desfazer' devolve." \
          || return "$MEOW_SEM_DEPENDENCIA"
      fi
      # O ACENTO QUE NÃO FOI FOTOGRAFADO SE DERIVA — 24/09/2026, sprint P48
      #   `meow tema dracula-pink` respondia "não existe captura" com o par
      #   escolhido no meow.conf, e o caminho era o passo manual da GUI. O
      #   `derivar_acento.py` escreve a captura a partir da do mesmo flavor
      #   (ver o cabeçalho dele), e aqui ela nasce na hora, antes de aplicar.
      #   No seco ele só diz o que faria, como o resto deste comando.
      if [ -z "$(meow_captura "$arg")" ]; then
        local deriva rc_d
        deriva="$(python3 "$RAIZ/scripts/derivar_acento.py" --conferir "$arg" 2>&1)"; rc_d=$?
        if [ "$rc_d" != "1" ]; then
          meow_erro "não existe captura '$arg'"
          [ -n "$deriva" ] && meow_info "${deriva#  }"
          meow_info "disponíveis: $(capturas | em_linha)"
          return "$MEOW_SEM_DEPENDENCIA"
        fi
        if meow_seco; then
          meow_muda "${deriva#  }, e aplicaria"
          return "$MEOW_DIVERGENTE"
        fi
      fi
      # UM `meow_travar` SÓ: o `flock` é por descritor aberto, e um segundo
      # `meow_travar` neste mesmo shell abriria outro e se trancaria do lado de
      # fora do próprio lock. A derivação escreve, então ela vem depois dele.
      meow_travar || return "$MEOW_ERRO"
      if [ -z "$(meow_captura "$arg")" ]; then
        python3 "$RAIZ/scripts/derivar_acento.py" "$arg"
        [ -n "$(meow_captura "$arg")" ] || { meow_erro "a derivação de '$arg' não deixou captura"; return "$MEOW_ERRO"; }
      fi
      "$RAIZ/scripts/aplicar_tema.sh" "$arg"; local rc=$?
      # No seco o aplicar_tema.sh vira --conferir e devolve 0 quando o tema JÁ
      # está aplicado. Notificar aí anunciaria uma troca que não houve.
      if [ "$rc" = "0" ] && ! meow_seco; then
        registrar "tema $arg"
        notificar "MeowSystem" "Tema $arg aplicado."
      fi
      return "$rc" ;;
  esac
}

cmd_logo() {
  carregar_conf || return "$MEOW_ERRO"
  local arg="${1:-}"

  # `girar` e `listar` são do ACERVO (assets/gatos/ + o gato do flavor), não das
  # variantes de `assets/meow-*-painel.svg` que o resto deste comando conhece.
  # São coisas diferentes de propósito: a variante é o DESENHO do gato do
  # projeto; o acervo é a coleção dela, e girar troca só a chave — o único
  # caminho que vale na hora, sem reiniciar o painel (§3 do COSMIC-THEMING).
  case "$arg" in
    girar|listar)
      meow_travar || return "$MEOW_ERRO"
      # AS CHAVES DO MODO `hora` TÊM DE ATRAVESSAR, senão o `listar` responde a
      # pergunta errada: sem `WALLPAPER_NOITE_*` ele cai no padrão 18:00-07:00 e
      # imprime "fonte: padrão" numa máquina que tem a janela no conf. Uma tela
      # de diagnóstico que mente sobre a própria fonte é pior que nenhuma.
      FLAVOR="$FLAVOR" LOGO="$LOGO" \
        LOGO_MODO="${LOGO_MODO:-}" LOGO_DIA="${LOGO_DIA:-}" LOGO_NOITE="${LOGO_NOITE:-}" \
        LOGO_RECICLAR="${LOGO_RECICLAR:-}" LOGO_ROTACAO="${LOGO_ROTACAO:-}" \
        LOGO_INTERVALO="${LOGO_INTERVALO:-}" NOME_TEMA_ICONES="${NOME_TEMA_ICONES:-}" \
        NOITE_INICIO="${NOITE_INICIO:-}" NOITE_FIM="${NOITE_FIM:-}" \
        WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" \
        WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" \
        "$RAIZ/scripts/logo.sh" "$arg"; local rc=$?
      [ "$rc" = "1" ] && [ "$arg" = "girar" ] && registrar "logo girou"
      return "$rc" ;;
  esac

  if [ -z "$arg" ]; then
    meow_titulo "Logo do painel"
    campo "em uso" "$LOGO"
    campo "arquivo" "$(cat "$COSMIC/dev.cappsy.CosmicExtAppletLogoMenu/v1/custom_logo_path" 2>/dev/null || printf '(nenhuma)')"
    printf '\n  %sgatos do acervo (assets/gatos/)%s\n' "$C_DIM" "$C_ZERO"
    logos_disponiveis | sed 's/^/    /'
    printf '\n  %ssolte um .svg em assets/gatos/ e ele entra na hora — a pasta é a lista%s\n' \
           "$C_DIM" "$C_ZERO"
    printf '  %smeow logo listar diz qual gato está no ar, e POR QUÊ (a fase e a janela)%s\n' "$C_DIM" "$C_ZERO"
    printf '  %sno modo hora quem manda é o relógio: LOGO_DIA / LOGO_NOITE no meow.conf%s\n\n' "$C_DIM" "$C_ZERO"
    return 0
  fi

  # Mesma armadilha do conf_definir: `logos_disponiveis | grep -qx` devolveria
  # 141 por SIGPIPE justamente quando ENCONTRASSE a variante, e o comando
  # recusaria um nome que ele mesmo acabou de listar como disponível.
  local disponiveis; disponiveis="$(logos_disponiveis)"
  if ! grep -qx -- "$arg" <<< "$disponiveis"; then
    meow_erro "não existe o gato '$arg' em assets/gatos/"
    meow_info "disponíveis: $(logos_disponiveis | em_linha)"
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  LOGO="$arg"
  conf_definir LOGO "$arg"; local rc_conf=$?
  [ "$rc_conf" -ge 2 ] && { meow_erro "não consegui gravar LOGO em $CONF"; return "$MEOW_ERRO"; }
  meow_travar || return "$MEOW_ERRO"
  # A LOGO NOVA SÓ APARECE NO PRÓXIMO LOGIN, E ISSO PRECISA SER DITO
  #   O applet LogoMenu troca de gato NA HORA quando a CHAVE `custom_logo_path`
  #   aponta para outro arquivo — mas não quando o CONTEÚDO do arquivo apontado
  #   muda, porque ele cacheou a imagem no carregamento (docs/COSMIC-THEMING.md
  #   §3). E o destino que o construir_icones.sh escreve tem o nome do FLAVOR,
  #   não o da variante: trocar só a LOGO reescreve o MESMO caminho.
  #   O construir_icones.sh, desde 04/08/2026, não derruba mais o painel por
  #   isso — derrubar custou a tela dela duas vezes. Então o certo é avisar.
  meow_info "a logo nova aparece no próximo login (o applet cacheia a imagem)"
  # QUEM APLICA É O logo.sh, NÃO O fix_icones — e a diferença passou a importar
  # em 08/08/2026. Enquanto a logo era variante do gato gerado, quem a escrevia
  # era o `construir_icones.sh`, e chamar a reconstrução dos ícones fazia
  # sentido. Agora o gato sai do acervo e o dono único da chave, dos arquivos em
  # `~/.config/cosmic/logos/` e dos dois botões do dock é o `logo.sh`. Chamar o
  # `fix_icones` aqui não trocaria gato nenhum — só reconstruiria o índice.
  FLAVOR="$FLAVOR" LOGO="$arg" "$RAIZ/scripts/logo.sh" aplicar; local rc=$?
  [ "$rc" = "1" ] && { registrar "logo $arg"; notificar "MeowSystem" "Logo $arg."; }
  return "$rc"
}

cmd_icones() {
  carregar_conf || return "$MEOW_ERRO"
  case "${1:-}" in
    reconstruir)
      meow_travar || return "$MEOW_ERRO"
      local rc_i rc_p pior
      fix_icones; rc_i=$?
      fix_pastas; rc_p=$?
      pior="$(pior_de "$rc_i" "$rc_p")"
      [ "$pior" = "2" ] && return "$MEOW_ERRO"
      # O log só registra o que de fato mudou: um "icones reconstruir" gravado a
      # cada rodada do timer encheria o `meow log` de linhas que não aconteceram.
      [ "$pior" = "1" ] && registrar "icones reconstruir"
      return "$pior" ;;
    ""|estado)
      local dir n_apps n_pastas base resp
      dir="$HOME/.local/share/icons/${NOME_TEMA_ICONES:-MeowSystem-Icons}"
      # A BASE É A QUE VALE, E NÃO A CHAVE — 24/09/2026, sprint P45
      #   Esta linha imprimia `${ICONES_BASE:-Papirus-Dark}` cru. Desde a P41 o
      #   pack pode trazer a própria base, e o de fábrica cede a ela: medido numa
      #   casa de brinquedo com o Dracula no ar, a tela dizia "Papirus-Dark"
      #   enquanto o `construir_icones.sh`, logo abaixo, dizia que baixaria a
      #   base do pack. Quem decide é o `_base_escolhida` do `scripts/pack.py`,
      #   uma vez; aqui se pergunta ao mesmo verbo que o construtor pergunta, com
      #   os mesmos três valores. Sem python, fica a chave, como antes.
      resp="$(ICONES_BASE="${ICONES_BASE:-Papirus-Dark}" \
              NOME_TEMA_ICONES="${NOME_TEMA_ICONES:-MeowSystem-Icons}" \
              python3 "$RAIZ/scripts/pack.py" base-icones "$(meow_pack_dir)" 2>/dev/null)"
      case "$(printf '%s\n' "$resp" | sed -n 's/^quem=//p')" in
        pack) base="${NOME_TEMA_ICONES:-MeowSystem-Icons}-Base, a do pack $(printf '%s\n' "$resp" | sed -n 's/^pack=//p')" ;;
        conf) base="$(printf '%s\n' "$resp" | sed -n 's/^tema=//p'), do meow.conf" ;;
        motor) base="$(printf '%s\n' "$resp" | sed -n 's/^tema=//p')" ;;
        *) base="${ICONES_BASE:-Papirus-Dark}" ;;
      esac
      meow_titulo "Ícones"
      campo "tema"      "$(cat "$COSMIC/com.system76.CosmicTk/v1/icon_theme" 2>/dev/null || printf '(nenhum)')"
      campo "diretório" "$dir"
      campo "base"      "$base"
      campo "pastas"    "${ICONES_PASTAS:-cat-${FLAVOR}-${ACCENT}}"
      n_apps="$(find "$dir/scalable/apps" -type f 2>/dev/null | wc -l)"
      n_pastas="$(find "$dir" -path '*/places/*' \( -type f -o -type l \) 2>/dev/null | wc -l)"
      campo "aplicativos" "$n_apps"
      campo "lugares"     "$n_pastas"
      printf '\n'
      # Mesma tabela, mesma razão do `rodar_checks`: sem isto um
      # `LOG_NIVEL="silencioso"` no meow.conf deixaria estas duas linhas com a
      # coluna da direita vazia, e um `debug` mostraria a linha de depuração no
      # lugar do estado.
      local saida rc
      local LOG_NIVEL=info; export LOG_NIVEL
      saida="$(chk_icones)"; rc=$?
      printf '  %s %s %s\n' "$(rotulo_rc "$rc")" "$(pad "ícones" 10)" "$(primeira_linha "$saida")"
      saida="$(chk_pastas)"; local rc2=$?
      printf '  %s %s %s\n\n' "$(rotulo_rc "$rc2")" "$(pad "pastas" 10)" "$(primeira_linha "$saida")"
      return "$(pior_de "$rc" "$rc2")" ;;
    importar)
      # A página de curadoria manda ela rodar `meow icones importar` no fim, e
      # até 10/08/2026 esse comando não existia: o `importar_icones.sh` só era
      # alcançável pelo caminho completo. Quem escreve o texto da página não é
      # quem escreve o `meow`, e o preço da distância foi ela ficar com um
      # `.json` na mão e um comando que responde "uso:".
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow icones importar <meow-icones-escolhas.json>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      # O lock é pego aqui, e não lá dentro, pela mesma razão dos outros
      # comandos: o script pode ser rodado sozinho durante um `install.sh`.
      "$RAIZ/scripts/importar_icones.sh" "$1"; local rc=$?
      [ "$rc" = "2" ] && return "$MEOW_ERRO"
      # Arte nova em `assets/icones/curadoria/` só aparece na tela depois que o tema é
      # remontado — importar sem reconstruir deixaria a escolha dela no repo e
      # o ícone velho no dock.
      if [ "$rc" = "1" ]; then
        local rc_i; fix_icones; rc_i=$?
        [ "$rc_i" = "2" ] && return "$MEOW_ERRO"
        registrar "icones importar"
        notificar "MeowSystem" "Ícones escolhidos por você aplicados."
      fi
      return "$rc" ;;
    resgatados)
      # OS DESENHOS DELA QUE VOLTARAM DO PNG — 11/09/2026
      #   `meow icones resgatados` mostra quantos estão no lugar e qual é a
      #   escolha dela; `sim`/`nao` trocam a chave e aplicam na hora.
      #
      #   TROCAR A CHAVE E APLICAR SÃO UMA COISA SÓ, e não duas, porque o efeito
      #   é visível: ela liga para VER o ícone mudar. Um comando que gravasse a
      #   chave e dissesse "rode `meow aplicar`" seria a ida e volta que este
      #   projeto existe para acabar — a mesma razão registrada no `icones
      #   importar`, que reconstrói sozinho depois de importar.
      shift
      case "${1:-}" in
        ""|estado)
          local par postos total
          par="$("$RAIZ/scripts/icones_resgatados.sh" estado)"
          postos="${par%% *}"; total="${par##* }"
          meow_titulo "Ícones resgatados"
          campo "escolha"   "${ICONES_RESGATADOS:-sim}"
          campo "no tema"   "$postos de $total"
          campo "acervo"    "$RAIZ/assets/icones/resgatados"
          campo "mapa"      "$RAIZ/assets/icones/apps-resgatados.map"
          printf '\n'
          local saida rc
          local LOG_NIVEL=info; export LOG_NIVEL
          saida="$(chk_resgatados)"; rc=$?
          printf '  %s %s %s\n\n' "$(rotulo_rc "$rc")" "$(pad "resgatados" 10)" "$(primeira_linha "$saida")"
          return "$rc" ;;
        folha)
          # A folha mora no repo, junto do acervo: ela é a prova do trabalho, e
          # quem abre `assets/icones/resgatados/` encontra os desenhos e o
          # antes-e-depois no mesmo lugar. Regerar é barato e idempotente.
          "$RAIZ/scripts/resgatados_folha.sh"; return $? ;;
        sim|nao)
          meow_travar || return "$MEOW_ERRO"
          local rc_conf
          conf_definir ICONES_RESGATADOS "$1"; rc_conf=$?
          [ "$rc_conf" -ge 2 ] && { meow_erro "não consegui gravar ICONES_RESGATADOS em $CONF"; return "$MEOW_ERRO"; }
          ICONES_RESGATADOS="$1"
          local rc; fix_resgatados; rc=$?
          [ "$rc" = "2" ] && return "$MEOW_ERRO"
          [ "$rc" = "1" ] && registrar "icones resgatados $1"
          return "$rc" ;;
        *) meow_erro "uso: meow icones resgatados [estado|folha|sim|nao]"; return "$MEOW_ERRO" ;;
      esac ;;
    fonte)
      # DE ONDE SAI UM ÍCONE, E O QUE SAI DELE — 23/09/2026, P28 (regra 7)
      #   Antes disto, "de onde vem o ícone do Waterfox?" pedia ler três mapas e
      #   dois scripts: o `apps.map` do pack, o `apps-resgatados.map` do motor, e
      #   os dois instaladores que escrevem no mesmo `scalable/apps`. A resposta
      #   agora vem de quem já sabe: o `pack.py fonte` diz o arquivo (é ele que
      #   lê os mapas e recusa o empate), e o `meow_icones_derivados` diz o que
      #   sai dele — a MESMA função que os dois instaladores chamam para
      #   escrever. Esta tela não calcula nada por conta própria, e é por isso
      #   que ela não pode prometer um derivado que o instalador não faz.
      #
      #   As duas primeiras linhas saem sem enfeite, `fonte: …` e `deriva: …`,
      #   porque são as que se conferem de olho e com `grep` depois de um
      #   `meow doctor --consertar`: a fonte vem do repositório, e o conserto
      #   não tem como mudá-la.
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow icones fonte <nome-do-ícone>"; return "$MEOW_ERRO"; }
      # shellcheck source=../lib/icones.sh
      . "$RAIZ/lib/icones.sh"
      local nome_f="$1" linhas rc_f tema_f
      tema_f="$HOME/.local/share/icons/${NOME_TEMA_ICONES:-MeowSystem-Icons}"
      linhas="$(MEOW_PACK_DIR="$(meow_pack_dir)" python3 "$RAIZ/scripts/pack.py" fonte "$nome_f")"; rc_f=$?
      [ -n "$linhas" ] || return "$MEOW_DIVERGENTE"
      local n_f fonte_f camada_f abs_f tipo destino chave valor estado tipos
      while IFS=$'\t' read -r n_f fonte_f camada_f; do
        abs_f="$fonte_f"; case "$abs_f" in /*) ;; *) abs_f="$RAIZ/$abs_f" ;; esac
        tipos="$(meow_icones_derivados "$abs_f" "$nome_f" "$tema_f" 2>/dev/null | cut -f1 | paste -sd, - | sed 's/,/, /g')"
        printf 'fonte: %s\n' "$fonte_f"
        printf 'deriva: %s\n' "${tipos:-nada (a fonte não é SVG)}"
        # QUEM LIGA E DESLIGA ESTA CAMADA. O `pack:` é instalado pelo
        # `icones_apps_dracula.sh`, que lê o mapa do pack ATIVO e obedece ao
        # `ICONES_DRACULA` (o nome é de antes de o mapa virar do pack); os
        # resgatados, pelo `icones_resgatados.sh` e o `ICONES_RESGATADOS`. Os
        # padrões são os mesmos dos scripts — um padrão diferente aqui diria
        # "ligado" para o que o instalador deixa desligado.
        case "$camada_f" in
          resgatados) chave=ICONES_RESGATADOS; valor="${ICONES_RESGATADOS:-sim}" ;;
          *)          chave=ICONES_DRACULA;    valor="${ICONES_DRACULA:-nao}" ;;
        esac
        printf '       %-9s %s  (%s="%s")\n' "camada" "$camada_f" "$chave" "$valor"
        while IFS=$'\t' read -r tipo destino; do
          [ -n "$destino" ] || continue
          if [ ! -f "$destino" ]; then estado="ausente no tema"
          elif [ "$(cat "$abs_f")" = "$(cat "$destino")" ]; then estado="igual à fonte"
          else estado="DIFERE da fonte"; fi
          printf '       %-9s %s — %s\n' "$tipo" "${destino/#$HOME/\~}" "$estado"
        done < <(meow_icones_derivados "$abs_f" "$nome_f" "$tema_f" 2>/dev/null)
      done <<< "$linhas"
      return "$rc_f" ;;
    adicionar|remover)
      # UM TEMA DE ÍCONES DE FORA, PELO PAINEL — 06/09/2026
      #   Pedido dela: "na pasta dos ícones não aparece a opção de adicionar
      #   pasta nova de ícones". Ela podia trocar a chave `ICONES_BASE` para
      #   qualquer tema, mas não tinha como pôr um tema novo na máquina sem
      #   sair do painel e abrir um gerenciador de arquivos — o que é
      #   exatamente o tipo de ida e volta que este projeto existe para acabar.
      #
      #   Passa pelo `meow` e não pelo caminho do script porque o painel só
      #   chama comando da CLI: a página nunca move nem apaga arquivo por conta
      #   própria, e um botão que fosse a única porta para uma capacidade
      #   deixaria quem usa o terminal sem ela.
      local sub="$1"; shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow icones $sub <pasta-ou-zip>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/construir_icones.sh" "$sub" "$1"; return $? ;;
    *) meow_erro "uso: meow icones [estado|reconstruir|resgatados [sim|nao]|fonte <nome>|importar <json>|adicionar <pasta-ou-zip>|remover <nome>]"; return "$MEOW_ERRO" ;;
  esac
}

cmd_areas() {
  # AS ÁREAS DE TRABALHO SÃO BOTÃO, NÃO MANUTENÇÃO — 07/09/2026
  #   Pedido dela: "não temos a seção pra setar os dois ambientes de trabalho
  #   tipo o Meow e o OS". Por isso `areas` NÃO entra no `VERIFICAVEIS`: com
  #   `AREAS_NOMES="Meow, OS"` de fábrica, um `doctor --consertar` numa máquina
  #   de outra pessoa renomearia as áreas dela e criaria uma segunda. Renomear
  #   área de trabalho é decisão de quem usa, e decisão de quem usa não se toma
  #   por timer.
  carregar_conf || return "$MEOW_ERRO"
  case "${1:-estado}" in
    estado|conferir) "$RAIZ/scripts/areas.sh" "${1:-estado}"; return $? ;;
    aplicar)
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/areas.sh" aplicar; return $? ;;
    # O PRIMEIRO ALFINETE — 22/09/2026, sprint P2. Ele é o que destrava o
    # `aplicar` numa máquina que nunca alfinetou nada: sem nenhuma área, o
    # `aplicar` não tem bloco `output:` de onde herdar o monitor, e até hoje
    # respondia mandando alfinetar à mão pelo COSMIC. Entra aqui, e não em
    # `VERIFICAVEIS`, pelo mesmo motivo que o `aplicar`: criar área de trabalho
    # é decisão de quem usa, e decisão de quem usa não se toma por timer.
    alfinetar-primeira)
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/areas.sh" alfinetar-primeira; return $? ;;
    reverter)
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/areas.sh" reverter; return $? ;;
    desalfinetar)
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow areas desalfinetar <nome>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/areas.sh" desalfinetar "$1"; return $? ;;
    *) meow_erro "uso: meow areas [estado|conferir|aplicar|alfinetar-primeira|reverter|desalfinetar <nome>]"
       return "$MEOW_ERRO" ;;
  esac
}

cmd_cursor() {
  # O PONTEIRO GANHOU LISTA E PORTA DE ENTRADA — 06/09/2026
  #   Ela mediu pela tela: "Temas do Ponteiro só aparece um e não aparece botão
  #   pra adicionar tema". A primeira metade não era defeito — há um só
  #   instalado que a chave `CURSOR` alcança, porque a regra exige o sufixo
  #   `-cursors` no nome da pasta. A segunda era: não existia porta nenhuma.
  #
  #   `listar` imprime o VALOR que a chave aceita, sem o sufixo. Imprimir o nome
  #   da pasta faria a página gravar `…-cursors` na chave, e o `aplicar` sairia
  #   procurando um pacote que não existe — o mesmo defeito que o painel já
  #   consertou uma vez, em 01/09.
  carregar_conf || return "$MEOW_ERRO"
  local acao="${1:-estado}"
  case "$acao" in
    estado|conferir) "$RAIZ/scripts/cursor.sh" conferir; return $? ;;
    aplicar)
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/cursor.sh" aplicar; return $? ;;
    listar) "$RAIZ/scripts/cursor.sh" listar; return $? ;;
    adicionar)
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow cursor adicionar <url-ou-arquivo>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/cursor.sh" adicionar "$1"; return $? ;;
    remover)
      shift
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/cursor.sh" remover ${1:+"$1"}; return $? ;;
    *) meow_erro "uso: meow cursor [estado|aplicar|listar|adicionar <url-ou-arquivo>|remover [tema]]"
       return "$MEOW_ERRO" ;;
  esac
}

cmd_fontes() {
  # INSTALAR UMA FONTE SEM SAIR DO PAINEL — 06/09/2026
  #   Pedido dela: "não aparece a opção pra adicionar novas fontes ao
  #   computador (Forma de Instalar as fontes)".
  #
  #   A armadilha que o `instalar_fontes.sh` documenta e que este comando herda:
  #   copiar a fonte só para `~/.local/share/fonts` a faria sumir na próxima
  #   passagem do instalador, calada, porque aquele script apaga do destino tudo
  #   que não esteja no acervo do projeto. O `adicionar` escreve nos dois — e é
  #   por isso que ele é um comando, e não um arrastar de arquivo.
  carregar_conf || return "$MEOW_ERRO"
  local acao="${1:-estado}"
  case "$acao" in
    estado|conferir) "$RAIZ/scripts/instalar_fontes.sh" --conferir; return $? ;;
    aplicar)
      # O script aplica quando é chamado SEM argumento — o `--conferir` é que é
      # a exceção. Um `aplicar` literal cairia no "argumento desconhecido", e o
      # botão do painel morreria com uma mensagem de uso.
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/instalar_fontes.sh"; return $? ;;
    adicionar)
      shift
      [ -n "${1:-}" ] || { meow_erro "uso: meow fontes adicionar <arquivo.zip|.ttf|.otf>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      "$RAIZ/scripts/instalar_fontes.sh" adicionar "$1"; return $? ;;
    *) meow_erro "uso: meow fontes [estado|aplicar|adicionar <arquivo>]"; return "$MEOW_ERRO" ;;
  esac
}

cmd_wallpaper() {
  carregar_conf || return "$MEOW_ERRO"
  local acao="${1:-estado}"
  case "$acao" in
    estado|aplicar|usar|adicionar|banir|desbanir|semear|permitir|proximo|anterior|carrossel|lado)
      # Só passa adiante o que o scripts/wallpaper.sh tem de verdade. O `usar`
      # faltava até 24/09/2026: o «Usar» da galeria do painel saía 2 com a
      # mensagem de uso, e o script o tinha desde a 28173e2 (achado da P46). Os
      # comandos `fixar`, `favoritar` e `recolorir` do contrato NÃO existem ainda.
      #
      # O ENCAMINHAMENTO PASSA `"$@"`, E NÃO UM ARGUMENTO SÓ — 06/09/2026
      #   Era `${1:+"$1"}`, e funcionou enquanto todo subcomando daqui tinha no
      #   máximo um argumento. O `lado <imagem> dia|noite|auto` tem dois, e o
      #   segundo — justamente o LADO, que é a decisão inteira — seria comido
      #   em silêncio: o script receberia só o nome da imagem e responderia com
      #   a mensagem de uso. Um defeito mudo, e do tipo que só aparece no
      #   primeiro subcomando de dois argumentos.
      #
      # O `proximo` E O `anterior` ENTRARAM EM 01/09/2026, e o parágrafo que
      # estava aqui — "`proximo` não é implementável na rotação nativa" — ficou
      # meio certo e meio velho, do jeito que envelhece uma lista de coisas que
      # não existem. O que continua verdadeiro: o `cosmic-bg` não fala D-Bus, e
      # reescrever a configuração REINICIA a rotação em vez de avançar. O que
      # mudou: avançar deixou de significar "empurrar a rotação" e passou a
      # significar FIXAR a imagem seguinte da lista do grupo, com prazo
      # (`WALLPAPER_FIXO_TTL`, padrão 30m) para o carrossel voltar sozinho. A
      # âncora de "onde estamos" é o estado do próprio cosmic-bg,
      # `~/.local/state/cosmic/…/v1/wallpapers`. Ver o bloco "AVANÇAR E VOLTAR"
      # no wallpaper.sh.
      #
      # O `semear` ESTAVA nessa lista de inexistentes e não está mais: ele foi
      # implementado no wallpaper.sh (baixa a coleção Catppuccin do commit
      # pinado) DEPOIS que esta lista foi escrita, e a CLI seguia recusando um
      # comando que funciona. Lista de coisas-que-não-existem envelhece sozinha;
      # esta agora é conferida contra o `case` do fim do wallpaper.sh.
      #
      # O `permitir` entrou em 11/08/2026 (Sprint M) e TAMBÉM toma o lock: ele é
      # o único desta lista que escreve no meow.conf, e o `meow configurar` —
      # que escreve no mesmo arquivo — já roda sob a mesma trava.
      # `proximo`/`anterior`/`carrossel` também tomam o lock: os três chamam o
      # `cmd_aplicar`, que escreve a configuração do cosmic-bg — o mesmo arquivo
      # que o timer de 15 min reescreve. Sem a trava, um clique no menu de
      # contexto no instante do tique dá duas escritas concorrentes na mesma
      # configuração, e o cosmic-bg lê a que chegar por último.
      # O `desbanir` entra nas duas listas junto com o `banir`, e no lock pelo
      # mesmo motivo dele: ele copia para `ativos/`, reescreve o `BANIDOS.txt` e
      # chama o `cmd_aplicar`, que escreve a configuração do cosmic-bg — o mesmo
      # arquivo que o timer de 15 min reescreve.
      case "$acao" in aplicar|adicionar|banir|desbanir|semear|permitir|proximo|anterior|carrossel|lado) meow_travar || return "$MEOW_ERRO" ;; esac
      shift || true
      WALLPAPER_BASE="${WALLPAPER_BASE:-}" WALLPAPER_INTERVALO="${WALLPAPER_INTERVALO:-5m}" \
        WALLPAPER_ORDEM="${WALLPAPER_ORDEM:-aleatoria}" \
        WALLPAPER_FONTES_DELA="${WALLPAPER_FONTES_DELA:-}" \
        WALLPAPER_AJUSTE="${WALLPAPER_AJUSTE:-preencher}" \
        WALLPAPER_NOITE="${WALLPAPER_NOITE:-}" WALLPAPER_NOITE_INICIO="${WALLPAPER_NOITE_INICIO:-}" \
        WALLPAPER_NOITE_FIM="${WALLPAPER_NOITE_FIM:-}" WALLPAPER_LIMIAR_LUZ="${WALLPAPER_LIMIAR_LUZ:-}" \
        "$RAIZ/scripts/wallpaper.sh" "$acao" "$@"
      return $? ;;
    fixar|favoritar|recolorir|intervalo|ordem)
      meow_erro "'$acao' ainda não existe"
      meow_info "o que existe hoje: estado, aplicar, proximo, anterior, carrossel, adicionar <img|pasta>, banir <img>, semear, permitir <caminho>"
      meow_info "intervalo e ordem se mudam no $CONF (WALLPAPER_INTERVALO / WALLPAPER_ORDEM)"
      return "$MEOW_SEM_DEPENDENCIA" ;;
    *) meow_erro "uso: meow wallpaper [estado|aplicar|proximo|anterior|carrossel|adicionar <alvo>|banir <img>|semear|permitir <caminho>]"
       return "$MEOW_ERRO" ;;
  esac
}

cmd_apps() {
  carregar_conf || return "$MEOW_ERRO"
  case "${1:-tabela}" in
    tabela)
      meow_titulo "Aplicativos"
      printf '  %s%s %s %s %s%s\n' "$C_DIM" "$(pad "programa" 18)" "$(pad "instalado" 10)" "$(pad "tema" 10)" "nomes no meow.conf" "$C_ZERO"
      local pasta slugs det conf rc_geral=0
      local t_inst c_inst t_tema c_tema
      while IFS=$'\t' read -r pasta slugs det conf; do
        [ -n "$pasta" ] || continue
        case "$det" in
          0) t_inst="sim"; c_inst="$C_VERDE" ;;
          *) t_inst="não"; c_inst="$C_DIM" ;;
        esac
        case "$conf" in
          0) t_tema="aplicado"; c_tema="$C_VERDE" ;;
          1) t_tema="pendente"; c_tema="$C_AMARELO"; rc_geral=1 ;;
          3) t_tema="--";       c_tema="$C_DIM" ;;
          *) t_tema="erro";     c_tema="$C_VERM"; rc_geral=2 ;;
        esac
        # A cor entra FORA do %-10s: os bytes de escape são invisíveis na tela
        # mas contam no padding, e a tabela sairia torta com um campo colorido.
        printf '  %s %s%s%s %s%s%s %s\n' \
               "$(pad "$pasta" 18)" "$c_inst" "$(pad "$t_inst" 10)" "$C_ZERO" \
               "$c_tema" "$(pad "$t_tema" 10)" "$C_ZERO" "$slugs"
      done < <(APPS_ATIVOS="${APPS_ATIVOS:-}" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" tabela 2>/dev/null)
      printf '\n  %snome sem programa ainda não é falha: aparece só quando alguém escrever o manifesto.%s\n' \
             "$C_DIM" "$C_ZERO"
      printf '  %smeow apps aplicar [nome] tematiza; sem nome, todos.%s\n\n' "$C_DIM" "$C_ZERO"
      return "$rc_geral" ;;
    conferir)
      APPS_ATIVOS="${APPS_ATIVOS:-}" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" conferir; return $? ;;
    aplicar)
      shift
      meow_travar || return "$MEOW_ERRO"
      local lista="${APPS_ATIVOS:-}"
      [ -n "${1:-}" ] && lista="$1"
      APPS_ATIVOS="$lista" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" aplicar; local rc=$?
      [ "$rc" = "1" ] && registrar "apps aplicar ${1:-todos}"
      return "$rc" ;;
    reverter)
      shift
      # SEM SLUG NÃO REVERTE NADA — e é a única ação daqui que não aceita o
      # "todos" implícito do `aplicar`. `meow apps reverter` digitado por engano
      # não pode desfazer a máquina inteira; um comando destrutivo não se
      # oferece de graça, ele se pede pelo nome.
      [ -n "${1:-}" ] || { meow_erro "uso: meow apps reverter <nome>"; return "$MEOW_ERRO"; }
      meow_travar || return "$MEOW_ERRO"
      APPS_ATIVOS="$1" FLAVOR="${FLAVOR:-}" ACCENT="${ACCENT:-}" \
        SPOTIFY_MARKETPLACE="${SPOTIFY_MARKETPLACE:-}" "$RAIZ/scripts/aplicar_apps.sh" reverter; local rc=$?
      [ "$rc" = "1" ] && registrar "apps reverter $1"
      return "$rc" ;;
    *) meow_erro "uso: meow apps [tabela|conferir|aplicar [nome]|reverter <nome>]"; return "$MEOW_ERRO" ;;
  esac
}

# --- 7b. o wizard -----------------------------------------------------------
# `meow configurar` — pedido dela: "o install faz dele wizard pra eu ir
# modificando e afins."
#
# ELE É UM JEITO DE EDITAR O meow.conf, NÃO UM SEGUNDO LUGAR ONDE AS DECISÕES
# MORAM
#   O cabeçalho do `install.sh` diz que quem decide é o `meow.conf`, não a linha
#   de comando. O wizard não contradiz isso: ele PERGUNTA, grava no `meow.conf` e
#   sai. Nada do que ele pergunta existe fora do arquivo, e nada do que ele
#   responde fica em outro lugar. Duas fontes de verdade seria o mesmo defeito de
#   "dois donos" que mais custou a este projeto.
#
# A LISTA DE CHAVES SAI DO meow.conf.exemplo, E ISSO NÃO É PREGUIÇA
#   Uma lista de perguntas escrita aqui dentro seria a segunda cópia da lista de
#   chaves — e a segunda cópia é sempre a que ninguém atualiza. É o mesmo motivo
#   pelo qual a completion do zsh lê as capturas do disco e o `migrar_conf.py` lê
#   as chaves novas do exemplo. Chave nova no exemplo vira pergunta nova sozinha;
#   chave que sair de lá para de ser perguntada sozinha.
#
#   Do exemplo saem três coisas: a ORDEM das perguntas, a SEÇÃO (`# --- Ícones`)
#   que vira o cabeçalho na tela, e o COMENTÁRIO colado acima da chave, que é a
#   ajuda. O comentário é a documentação dela — escrito para ser lido na hora de
#   decidir, que é exatamente a hora em que o wizard o mostra.
#
# NUNCA PERGUNTA SEM TERMINAL INTERATIVO
#   `[ -t 0 ]`, como o `desfazer` e o menu numerado já fazem. Sem tty ele imprime
#   os valores e sai 0 — nunca pendura um timer, um hook ou um `| meow`.
#
# AS OPÇÕES SÃO SUGESTÃO, NÃO REGRA
#   Onde o comentário do exemplo declara `a | b | c`, o wizard mostra a lista.
#   Mas ele NÃO recusa um valor de fora dela: `WALLPAPER_INTERVALO` documenta
#   `30s | 5m | 2h` e aceita qualquer duração do systemd — recusar `10m` seria o
#   wizard proibindo o que o `meow.conf` permite. O que ele faz é pedir
#   confirmação, que pega o erro de digitação sem inventar uma regra nova.
declare -a WIZ_CHAVES=()
declare -A WIZ_AJUDA=() WIZ_SECAO=() WIZ_NOVO=() WIZ_ANTES=()
# `[essencial]` no comentário de uma chave a põe no wizard CURTO. O esquema
# continua saindo do meow.conf.exemplo — chave nova nunca é esquecida, ela só
# não entra no caminho de ENTRADA até alguém decidir que ela é de entrada.
declare -A WIZ_ESSENCIAL=()

# Lê o esquema do meow.conf.exemplo: ordem, seção e o comentário de cada chave.
# "Colado" importa, e a regra é a mesma do migrar_conf.py: linha em branco ou
# cabeçalho de seção encerram o bloco, senão a primeira chave de cada seção
# arrastaria o cabeçalho inteiro como se fosse ajuda dela.
wiz_ler_esquema() {
  local linha chave bloco="" secao=""
  WIZ_CHAVES=(); WIZ_AJUDA=(); WIZ_SECAO=(); WIZ_ESSENCIAL=()
  [ -f "$CONF_PADRAO" ] || return "$MEOW_SEM_DEPENDENCIA"
  while IFS= read -r linha || [ -n "$linha" ]; do
    case "$linha" in
      '# --- '*)
        secao="${linha#\# --- }"; secao="${secao%%-*}"
        secao="${secao%"${secao##*[![:space:]]}"}"
        bloco=""; continue ;;
      '# @ '*|'# > '*)
        # AS DUAS MARCAS DO PAINEL NÃO ENTRAM NA AJUDA DO WIZARD.
        #   `# @ ` é o título do cartão e `# > ` é a frase de baixo — as duas
        #   existem para a PÁGINA, que tem de decidir o rótulo de um controle
        #   sem a pessoa abrir nada. Aqui a pergunta vem uma por vez, com o nome
        #   da chave na frente, e o bloco inteiro logo abaixo: o título seria
        #   uma repetição e a frase, a primeira linha do que já vem depois.
        #
        #   Deixá-las fora também é o que mantém os dois leitores de acordo — o
        #   `tests/app.sh` compara chave, padrão e opções dos dois lados, e um
        #   bloco diferente aqui é uma divergência esperando um `|` no título.
        continue ;;
      '#'*)  bloco="$bloco$linha"$'\n'; continue ;;
      '')    bloco=""; continue ;;
    esac
    case "$linha" in
      [A-Za-z_]*=*)
        chave="${linha%%=*}"
        case "$chave" in *[!A-Za-z0-9_]*) bloco=""; continue ;; esac
        # Chave repetida entra na fila UMA vez: perguntar duas vezes a mesma
        # coisa é oferecer à pessoa a chance de se contradizer.
        [ -n "${WIZ_SECAO[$chave]+x}" ] || WIZ_CHAVES+=("$chave")
        WIZ_AJUDA[$chave]="$bloco"; WIZ_SECAO[$chave]="$secao"
        case "$bloco" in *'[essencial]'*) WIZ_ESSENCIAL[$chave]=1 ;; esac
        ;;
    esac
    bloco=""
  done < "$CONF_PADRAO"
  [ "${#WIZ_CHAVES[@]}" -gt 0 ]
}

# A ÚLTIMA linha que atribui a chave — é a que o `.` do shell obedece.
wiz_linha_da_chave() {
  grep -E -- "^[[:space:]]*(export[[:space:]]+)?$1=" "$2" 2>/dev/null | tail -n1
}

# O valor CRU, como está escrito no arquivo. Não é o mesmo que o valor expandido:
# `WALLPAPER_DIR="$HOME/..."` e `ICONES_PASTAS="cat-${FLAVOR}-${ACCENT}"` valem
# justamente por não estarem expandidos, e gravar a expansão congelaria os dois.
wiz_valor_da_linha() {
  local resto="${1#*=}"
  case "$resto" in
    '"'*) resto="${resto#\"}"; printf '%s' "${resto%%\"*}" ;;
    "'"*) resto="${resto#\'}"; printf '%s' "${resto%%\'*}" ;;
    *)    printf '%s' "${resto%%[[:space:]#]*}" ;;
  esac
}

# O comentário que mora na MESMA linha da chave (`RAIO="8"  # corner_radii`).
# Para várias chaves ele é a única ajuda que existe.
wiz_comentario_da_linha() {
  local linha="$1" resto="${1#*=}" cauda
  case "$resto" in
    '"'*) cauda="${resto#\"}"; cauda="${cauda#*\"}" ;;
    "'"*) cauda="${resto#\'}"; cauda="${cauda#*\'}" ;;
    *)    cauda="$linha" ;;
  esac
  case "$cauda" in *'#'*) printf '%s' "$(printf '%s' "${cauda#*#}" | sed 's/^ *//')" ;; esac
}

# Uma opção por linha, ou nada. Só reconhece o formato `a | b | c` que este conf
# usa desde a primeira versão, e desiste da linha inteira se qualquer pedaço não
# parecer um valor — uma frase em prosa com uma barra no meio não é uma lista.
wiz_opcoes() {
  local chave="$1" ajuda="$2" inline="$3" l tok saida=""
  # LOGO é a única lida do DISCO: as variantes são arquivos, e uma lista escrita
  # aqui ficaria velha no dia em que alguém desenhasse outro gato de painel.
  if [ "$chave" = "LOGO" ]; then logos_disponiveis; return 0; fi
  while IFS= read -r l; do
    case "$l" in *'|'*) ;; *) continue ;; esac
    l="${l#\#}"; l="${l%%(*}"
    saida=""
    # `|| [ -n "$tok" ]`: a última opção da lista não tem `\n` depois, e sem isto
    # o `read` a descarta — `silencioso | info | debug` virava `silencioso, info`.
    while IFS= read -r tok || [ -n "$tok" ]; do
      tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"
      case "$tok" in
        ''|*[!A-Za-z0-9_.:+-]*) saida=""; break ;;
      esac
      saida="$saida$tok"$'\n'
    done < <(printf '%s' "$l" | tr '|' '\n')
    [ -n "$saida" ] && { printf '%s' "$saida"; return 0; }
  done <<< "$ajuda"$'\n'"$inline"

  # A SEGUNDA FORMA DE LISTAR OPÇÕES NESTE ARQUIVO — 01/09/2026.
  #   Nem toda chave escreve `a | b | c`. Várias listam em TABELA INDENTADA:
  #
  #     #   hora     (padrão) LOGO_NOITE de noite, LOGO_DIA de dia...
  #     #   rotacao  gira pelo acervo ao encerrar a sessão...
  #     #   fixo     LOGO= vence sempre.
  #
  #   Só a forma com barras era reconhecida, então o `LOGO_MODO` chegava aqui
  #   sem opção nenhuma e o wizard pedia para DIGITAR `hora`. Palavras dela, ao
  #   ver o mesmo defeito na página: "era pra ter o que de opção ali? Se era pra
  #   ter opção pq não tem botões de escolha?".
  #
  #   A GUARDA É O VALOR DE FÁBRICA. Duas chaves logo abaixo de uma tabela
  #   herdam o comentário do bloco (`FASTFETCH_LOGO_DIA` e `_NOITE`, que querem
  #   um NOME DE GATO) — e ganhariam três botões de modo. Se o valor de fábrica
  #   da chave não está na tabela, a tabela não é dela. O `app/servidor.py` usa
  #   exatamente este critério, e o `tests/app.sh` compara os dois.
  #   `grep -P` e não `awk`: o `match($0, //, m)` com terceiro argumento é
  #   extensão do gawk, e num sistema com mawk ele falha CALADO — o wizard
  #   voltaria a não achar tabela nenhuma e o `tests/app.sh` acusaria a
  #   divergência sem dizer por quê. Pego assim mesmo, na primeira rodada.
  local tabela padrao_bruto
  tabela="$(printf '%s\n' "$ajuda" \
    | grep -oP '^#\s{2,}\K[a-z][a-z0-9_-]{1,14}(?=\s{2,}\S)' 2>/dev/null || true)"
  [ "$(printf '%s' "$tabela" | grep -c .)" -ge 3 ] || return 0
  padrao_bruto="$(wiz_valor_da_linha "$(wiz_linha_da_chave "$chave" "$CONF_PADRAO")")"
  printf '%s\n' "$tabela" | grep -qxF -- "$padrao_bruto" || return 0
  printf '%s' "$tabela"
  return 0
}

# `+slug` / `-slug` numa chave que é lista separada por vírgula. Sem isto, mexer
# em APPS_ATIVOS pelo wizard seria redigitar 23 slugs para tirar um — e uma
# pergunta que ninguém consegue responder é uma pergunta que não existe.
wiz_lista_editar() {
  local valor="$1"; shift
  local -a itens=() novos=()
  local op alvo item achou
  IFS=',' read -r -a itens <<< "$valor"
  for op in "$@"; do
    alvo="${op#[+-]}"
    [ -n "$alvo" ] || continue
    case "$op" in
      +*) achou=0
          for item in "${itens[@]}"; do [ "$item" = "$alvo" ] && achou=1; done
          [ "$achou" = "0" ] && itens+=("$alvo") ;;
      -*) novos=()
          for item in "${itens[@]}"; do [ "$item" = "$alvo" ] || novos+=("$item"); done
          itens=("${novos[@]}") ;;
    esac
  done
  local fora; fora="$(IFS=','; printf '%s' "${itens[*]}")"
  printf '%s' "$fora"
}

wiz_ajuda_linhas() {
  printf '%s' "$1" | sed 's/^# \{0,1\}//'
}

# O valor cru da chave no arquivo dela, caindo no exemplo quando ela ainda não
# tem a chave — que é o mesmo que o `migrar_conf.py` vai acrescentar depois.
wiz_bruto() {
  local linha; linha="$(wiz_linha_da_chave "$1" "$2")"
  [ -n "$linha" ] || linha="$(wiz_linha_da_chave "$1" "$CONF_PADRAO")"
  wiz_valor_da_linha "$linha"
}

# Pergunta UMA chave. 0 = seguiu adiante · 1 = ela quis sair (nada é gravado).
wiz_perguntar() {
  local chave="$1" arq="$2"
  local linha bruto inline ajuda opcoes resp mostrado expandido n_ajuda
  linha="$(wiz_linha_da_chave "$chave" "$arq")"
  [ -n "$linha" ] || linha="$(wiz_linha_da_chave "$chave" "$CONF_PADRAO")"
  bruto="$(wiz_valor_da_linha "$linha")"
  inline="$(wiz_comentario_da_linha "$linha")"
  ajuda="${WIZ_AJUDA[$chave]:-}"
  # `[essencial]` é marcador para o wizard, não texto para quem lê a pergunta.
  # Ele sai da ajuda mostrada, e a linha que ficaria só com o marcador some.
  ajuda="${ajuda//\[essencial\] /}"
  ajuda="$(printf '%s' "$ajuda" | grep -v '^#[[:space:]]*\[essencial\][[:space:]]*$' || true)"
  opcoes="$(wiz_opcoes "$chave" "$ajuda" "$inline")"
  # sim/nao não está escrito em lugar nenhum como lista, e não precisa estar: o
  # próprio valor diz que a chave é um interruptor.
  [ -z "$opcoes" ] && case "$bruto" in sim|nao) opcoes=$'sim\nnao' ;; esac
  n_ajuda="$(printf '%s' "$ajuda" | grep -c '^#' || true)"

  expandido="${!chave:-}"
  mostrado="$bruto"
  case "$bruto" in
    *'$'*) [ -n "$expandido" ] && [ "$expandido" != "$bruto" ] \
             && mostrado="$bruto  ->  $expandido" ;;
  esac

  # As 3 primeiras linhas do comentário, que é onde ele diz o que a chave faz. O
  # resto sai no `?` — blocos de 15 linhas (VIDRO_OPACIDADE_*, ASSETS_VIGIA)
  # empurrariam a pergunta para fora da tela, e uma pergunta que rolou para cima
  # é uma pergunta respondida no escuro.
  local visivel=""
  [ -n "$ajuda" ] && visivel="$(wiz_ajuda_linhas "$ajuda" | grep -v '^[[:space:]]*$' | head -n 3)"

  printf '\n  %s%s%s\n' "$C_MAUVE$C_FORTE" "$chave" "$C_ZERO"
  [ -n "$inline" ] && printf '    %s%s%s\n' "$C_DIM" "$inline" "$C_ZERO"
  if [ -n "$visivel" ]; then
    printf '%s\n' "$visivel" | while IFS= read -r l; do
      printf '    %s%s%s\n' "$C_DIM" "$l" "$C_ZERO"
    done
    [ "${n_ajuda:-0}" -gt 3 ] && printf '    %s(? mostra o comentário inteiro)%s\n' "$C_DIM" "$C_ZERO"
  fi
  # A lista só é repetida quando ela NÃO está no comentário que acabou de sair na
  # tela — senão a mesma frase apareceria duas vezes seguidas, uma com `|` e
  # outra com vírgula, como se fossem coisas diferentes.
  if [ -n "$opcoes" ]; then
    case "$visivel$inline" in
      *'|'*) ;;
      *) printf '    %s%s%s\n' "$C_AZUL" "$(printf '%s' "$opcoes" | em_linha)" "$C_ZERO" ;;
    esac
  fi
  case "$bruto" in
    *,*) printf '    %s+slug acrescenta · -slug remove · ou digite a lista inteira%s\n' "$C_DIM" "$C_ZERO" ;;
  esac

  while :; do
    printf '  %s[%s]%s %s>%s ' "$C_DIM" "$mostrado" "$C_ZERO" "$C_MAUVE" "$C_ZERO"
    resp=""
    read -r -t "${MEOW_TIMEOUT:-300}" resp || {
      printf '\n'; meow_info "sem resposta — nada foi gravado"; return 1; }
    case "$resp" in
      '')      return 0 ;;
      q|Q|sair) meow_info "saindo — nada foi gravado"; return 1 ;;
      '?')     printf '\n'; wiz_ajuda_linhas "$ajuda" | sed "s/^/    /"; printf '\n'; continue ;;
    esac
    # `"` e `#` quebrariam a linha do conf: um fecha a aspa, o outro vira
    # comentário. Ver o cabeçalho do conf_texto_definir.
    case "$resp" in
      *'"'*|*'#'*) meow_erro 'sem aspas duplas nem # no valor — eles quebram a linha do conf'; continue ;;
    esac
    case "$resp" in
      [+-]*) local -a ops=(); read -r -a ops <<< "${resp//,/ }"
             resp="$(wiz_lista_editar "$bruto" "${ops[@]}")" ;;
    esac
    [ "$resp" = "$bruto" ] && return 0
    if [ -n "$opcoes" ] && ! grep -qxF -- "$resp" <<< "$opcoes"; then
      printf '    %s"%s" não está na lista.%s usar assim mesmo? (s/N) ' "$C_AMARELO" "$resp" "$C_ZERO"
      local ok=""
      read -r -t "${MEOW_TIMEOUT:-300}" ok || { printf '\n'; return 1; }
      case "$ok" in s|S|sim|Sim) ;; *) continue ;; esac
    fi
    WIZ_ANTES[$chave]="$bruto"; WIZ_NOVO[$chave]="$resp"
    return 0
  done
}

cmd_configurar() {
  carregar_conf || return "$MEOW_ERRO"
  # PADRÃO: só o essencial. Perguntar as 25 chaves transformava "configurar" em
  # "responder o arquivo inteiro", com VIDRO_OPACIDADE_PAINEL=0.1 e
  # ICONES_PASTAS=cat-${FLAVOR}-${ACCENT} no meio — impossíveis de responder sem
  # ler o código, e cada pergunta a mais no caminho de entrada custa desistência.
  # O resto continua a UM comando de distância, chave a chave.
  local todas=0
  case "${1:-}" in --tudo|-a) todas=1; shift ;; esac
  local so_uma=""
  case "${1:-}" in
    "") ;;
    -h|--help)
      printf 'uso: meow configurar [--tudo] [CHAVE]\n'
      printf '     sem nada, pergunta só as chaves essenciais.\n'
      printf '     --tudo pergunta o meow.conf inteiro, na ordem do arquivo.\n'
      return 0 ;;
    *) so_uma="$1" ;;
  esac
  wiz_ler_esquema || { meow_erro "não consegui ler as chaves de $CONF_PADRAO"; return "$MEOW_ERRO"; }

  local fonte="$CONF"; [ -f "$fonte" ] || fonte="$CONF_PADRAO"
  local chave achou=0
  if [ -n "$so_uma" ]; then
    for chave in "${WIZ_CHAVES[@]}"; do [ "$chave" = "$so_uma" ] && achou=1; done
    [ "$achou" = "1" ] || {
      meow_erro "não existe a chave '$so_uma' no meow.conf"
      meow_info "as que existem: $(printf '%s\n' "${WIZ_CHAVES[@]}" | em_linha)"
      return "$MEOW_SEM_DEPENDENCIA"; }
  fi

  meow_titulo "MeowSystem — configurar"
  campo "arquivo" "$CONF"
  [ "$fonte" = "$CONF_PADRAO" ] && meow_info "ainda não há $CONF — os padrões vêm de $CONF_PADRAO"

  # Sem tty não há a quem perguntar. Imprimir o que está lá e sair 0 é o mesmo
  # que o menu numerado faz — e é o que impede um timer ou um `| meow` de ficar
  # pendurado num prompt que ninguém vai responder.
  if [ ! -t 0 ]; then
    printf '\n'
    for chave in "${WIZ_CHAVES[@]}"; do
      [ -n "$so_uma" ] && [ "$chave" != "$so_uma" ] && continue
      campo "$chave" "$(wiz_bruto "$chave" "$fonte")"
    done
    printf '\n'
    meow_info "sem terminal interativo — nada foi perguntado e nada foi escrito"
    meow_info "num terminal: meow configurar    ·    ou edite $CONF na mão"
    printf '\n'
    return 0
  fi

  printf '\n  %sENTER mantém o valor · ? mostra a ajuda inteira · q sai sem gravar%s\n' \
         "$C_DIM" "$C_ZERO"
  WIZ_NOVO=(); WIZ_ANTES=()
  local secao_atual="" saiu=0
  for chave in "${WIZ_CHAVES[@]}"; do
    [ -n "$so_uma" ] && [ "$chave" != "$so_uma" ] && continue
    [ -z "$so_uma" ] && [ "$todas" = "0" ] && [ -z "${WIZ_ESSENCIAL[$chave]:-}" ] && continue
    if [ -z "$so_uma" ] && [ "${WIZ_SECAO[$chave]}" != "$secao_atual" ]; then
      secao_atual="${WIZ_SECAO[$chave]}"
      meow_passo "${secao_atual:-Configuração}"
    fi
    wiz_perguntar "$chave" "$fonte" || { saiu=1; break; }
  done

  # O PAR ESCOLHIDO EXISTE NO DISCO? — 21/09/2026
  #   MEDIDO: o comentário do `FLAVOR` oferece 5 variantes e o do `ACCENT`
  #   oferece 12. São 60 pares apresentados como escolha, e os packs de fábrica
  #   trazem QUATRO capturas (dracula-mauve no pack Dracula; latte-mauve,
  #   mocha-mauve e mocha-pink no Catppuccin — desde 22/09/2026 cada uma mora
  #   dentro do pack dono). Quem respondesse "macchiato" + "teal" — duas
  #   opções que a própria pergunta ofereceu — via a etapa `tema` do install.sh
  #   se pular e não entendia por quê.
  #
  #   POR QUE A LISTA NÃO ENCOLHEU PARA QUATRO. Encolher fecharia 56 pares que
  #   FUNCIONAM: o tema sai por derivação da paleta (`scripts/gerar_temas.py`
  #   escreve o `.ron` de qualquer par), e a captura é refinamento — ela fixa o
  #   que o COSMIC desenhou na tela, não autoriza o par a existir. Trocar uma
  #   promessa falsa por uma porta fechada seria trocar um defeito por outro.
  #   O que faltava era a frase, e ela vem aqui: depois das respostas, uma vez,
  #   sem cinza e sem opção escondida.
  #
  #   A LISTA VEM DO DISCO, e não daqui: uma captura nova entra na frase no dia
  #   em que alguém a tirar, sem ninguém editar esta função.
  if [ -z "$so_uma" ] && [ "$saiu" = "0" ]; then
    local _fl _ac _par _caps="" _c
    _fl="${WIZ_NOVO[FLAVOR]:-$(wiz_bruto FLAVOR "$fonte")}"
    _ac="${WIZ_NOVO[ACCENT]:-$(wiz_bruto ACCENT "$fonte")}"
    _par="$_fl-$_ac"
    # O PAR QUE SE DERIVA NÃO GANHA A RECEITA DA GUI — 24/09/2026, sprint P48.
    #   Desde a P48 o `derivar_acento.py` escreve a captura do acento a partir
    #   da do mesmo flavor, e o instalador a aplica sozinho. Mandar importar o
    #   `.ron` na GUI para esse par seria o passo manual do achado 31, dito
    #   agora por outra porta. O `--conferir` sai 1 quando derivaria; a frase
    #   abaixo fica para o flavor que nunca foi fotografado (saída 3).
    if [ -n "$_fl" ] && [ -n "$_ac" ] && [ -z "$(meow_captura "$_par")" ] \
       && { python3 "$RAIZ/scripts/derivar_acento.py" --conferir "$_par" >/dev/null 2>&1
            [ "$?" != "1" ]; }; then
      while IFS= read -r _c; do
        [ -n "$_c" ] || continue
        # A `original` é a captura de referência do projeto, tirada de uma
        # máquina só — não é um par que alguém escolheria aqui. Mesma exclusão
        # que o `lib/preflight.sh` faz, pelo mesmo motivo.
        [ "$_c" = "original" ] && continue
        _caps="$_caps$_c "
      done < <(meow_capturas)
      # O acumulador acima deixa um espaço no fim, e ele ia para a tela: a linha
      # saía "... mocha-pink " e o branco sobrando aparece em qualquer terminal
      # que sublinhe ou selecione a linha. Cortado aqui, uma vez, para o
      # `:-nenhuma` continuar respondendo à lista vazia sem ter de saber disso.
      _caps="${_caps% }"
      printf '\n'
      meow_info "o par \"$_par\" não tem captura de referência no repositório"
      meow_info "  as que há: ${_caps:-nenhuma}"
      meow_info "  isto NÃO fecha a porta: o tema deste par sai por DERIVAÇÃO da"
      meow_info "  paleta, e a captura é refinamento, não requisito."
      meow_info "  o que muda: a etapa \"tema\" do install.sh se pula e o COSMIC fica"
      meow_info "  com as cores que já estava usando. O backup de \"voltar ao tema de"
      meow_info "  antes\" é feito de qualquer jeito, na primeira passagem."
      meow_info "  para fixar este par na tela, uma vez:"
      meow_info "      importe $MEOW_ESTADO/temas/meowsystem-$_par.ron em"
      meow_info "      Configurações > Aparência > Importar, e depois:"
      meow_info "      meow tema capturar $_par"
    fi
  fi

  # A porta que fica aberta. Sem esta frase, o wizard curto vira um wizard que
  # ESCONDE — e a pessoa não tem como saber que as outras chaves existem.
  if [ -z "$so_uma" ] && [ "$todas" = "0" ] && [ "$saiu" = "0" ]; then
    # Contar de verdade: cravar o número faz a frase mentir na primeira chave
    # essencial que alguém marcar a mais.
    local n_ess="${#WIZ_ESSENCIAL[@]}"
    meow_info "as outras $(( ${#WIZ_CHAVES[@]} - n_ess )) chaves ficaram no padrão"
    meow_info "  ver todas:  meow configurar --tudo   ·   uma só:  meow configurar PASTAS_XDG"
    meow_info "  ou abra o arquivo:  \$EDITOR $CONF"
  fi

  if [ "${#WIZ_NOVO[@]}" = "0" ]; then
    printf '\n'
    [ "$saiu" = "1" ] || meow_ok "nada mudou — $CONF não foi tocado"
    printf '\n'
    return 0
  fi
  if [ "$saiu" = "1" ]; then
    printf '\n'
    meow_aviso "saiu no meio — as ${#WIZ_NOVO[@]} respostas anteriores foram descartadas"
    printf '\n'
    return 0
  fi

  meow_passo "O que muda no meow.conf"
  local texto
  texto="$(cat "$fonte")"
  for chave in "${WIZ_CHAVES[@]}"; do
    [ -n "${WIZ_NOVO[$chave]+x}" ] || continue
    printf '    %s- %s="%s"%s\n' "$C_VERM"  "$chave" "${WIZ_ANTES[$chave]}" "$C_ZERO"
    printf '    %s+ %s="%s"%s\n' "$C_VERDE" "$chave" "${WIZ_NOVO[$chave]}"  "$C_ZERO"
    texto="$(conf_texto_definir "$texto" "$chave" "${WIZ_NOVO[$chave]}")"
  done
  printf '\n'

  meow_escrever "$CONF" "$texto" 644
  local rc=$?
  case "$rc" in
    0) meow_ok "$CONF já estava assim — nada foi escrito"; printf '\n'; return 0 ;;
    1) if meow_seco; then
         meow_muda "MEOW_DRY_RUN=1 — o meow.conf NÃO foi escrito"
         printf '\n'
         return "$MEOW_DIVERGENTE"
       fi
       meow_ok "gravado em $CONF"
       registrar "configurar: $(printf '%s\n' "${!WIZ_NOVO[@]}" | sort | em_linha)" ;;
    *) meow_erro "não consegui gravar $CONF"; return "$MEOW_ERRO" ;;
  esac

  # Quem chamou foi o `install.sh --wizard`: ele já vai instalar em seguida, e
  # perguntar aqui seria perguntar duas vezes a mesma coisa.
  if [ "${MEOW_WIZARD_SEM_APLICAR:-0}" = "1" ]; then
    meow_info "o install.sh segue daqui com os valores novos"
    printf '\n'
    return "$MEOW_DIVERGENTE"
  fi

  printf '\n  aplicar agora? (S/n) '
  local resp=""
  if [ "${MEOW_SIM:-0}" = "1" ]; then
    resp="s"; printf 's\n'
  else
    read -r -t "${MEOW_TIMEOUT:-300}" resp || resp="n"
  fi
  case "$resp" in
    n|N|nao|não|Nao|Não)
      printf '\n'
      meow_info "não apliquei. Quando quiser: meow aplicar"
      printf '\n'
      return "$MEOW_DIVERGENTE" ;;
  esac
  printf '\n'
  cmd_aplicar
}

cmd_aplicar() {
  # NÃO pega o lock: quem pega é o próprio install.sh. Dois flock no mesmo
  # arquivo, um do pai e outro do filho, dariam "outro meow está rodando" —
  # e o culpado seria este processo.
  local seco="${MEOW_DRY_RUN:-0}"
  case "${1:-}" in
    --seco|--dry-run) seco=1 ;;
    "") ;;
    *) meow_erro "uso: meow aplicar [--seco]"; return "$MEOW_ERRO" ;;
  esac
  MEOW_DRY_RUN="$seco" "$RAIZ/install.sh"
}

# --lancador: devolve os .desktop de /usr/share que as três etapas do lançador
# marcaram. Percorre os backups do mais VELHO para o mais NOVO e restaura a
# PRIMEIRA cópia de cada arquivo — que é a que veio do apt; as seguintes já são
# versões nossas de rodadas anteriores.
desfazer_lancador() {
  local d arq alvo n=0
  local -A visto=()
  for d in "$MEOW_ESTADO"/backups/*-sistema; do
    [ -d "$d" ] || continue
    while IFS= read -r arq; do
      alvo="${arq#"$d"}"
      [ -n "${visto[$alvo]:-}" ] && continue     # a cópia mais antiga vence
      visto[$alvo]=1
      if meow_seco; then meow_muda "devolveria $alvo"; n=$((n+1)); continue; fi
      if meow_desktop_escrever "$alvo" "$arq"; then n=$((n+1))
      else meow_aviso "não consegui devolver $alvo"; fi
    done < <(find "$d" -type f 2>/dev/null | sort)
  done
  if [ "$n" = "0" ]; then
    meow_aviso "não há backup de .desktop do sistema em $MEOW_ESTADO/backups"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  meow_seco || meow_desktop_banco /usr/share/applications
  meow_ok "$n arquivo(s) devolvidos ao estado do apt"
  return "$MEOW_DIVERGENTE"
}

# --- A CAPTURA 'original' SÓ SE APLICA NA MÁQUINA DE ONDE ELA SAIU ---------
# UMA GUARDA, DUAS PORTAS — 24/09/2026, sprint P48 (achado 30)
#   A guarda nasceu dentro do `cmd_desfazer` (ver o bloco "`MEOW_SIM` NÃO
#   DESLIGA ESTA GUARDA", lá embaixo) e só ele a tinha. O `meow tema original`
#   chegava ao MESMO `aplicar_tema.sh original` por outra porta, sem pergunta
#   nenhuma: medido numa casa de brinquedo com o Dracula no ar, o ensaio dele
#   dizia "53 de 121 arquivos divergentes e 68 sobrando" — 68 chaves que o
#   script apagaria, porque ele remove o que a captura não tem. E o painel
#   oferecia essa porta num clique («Trocar de tema» › `original` › Executar).
#   Agora as duas portas perguntam a esta função, e a regra é uma só: a linha
#   `origem:` do captura.txt diz de qual COSMIC ela saiu (o capturar_tema.sh a
#   grava por extenso para a `original`, e só para ela), e ela tem de ser o
#   COSMIC daqui. A porta de fuga continua tendo nome próprio.
#   $1 = o comando que a pessoa digitaria; $2 e $3 = o caminho de volta DESTA
#   máquina, que cada porta conhece do seu jeito. 0 = pode seguir.
guarda_original() {
  local origem_cap
  origem_cap="$(sed -n 's/^origem: //p' "$RAIZ/assets/temas/capturados/original/captura.txt" 2>/dev/null | head -n1)"
  if [ -n "$origem_cap" ] && [ "$origem_cap" != "$COSMIC" ] \
     && [ "${MEOW_TEMA_DE_OUTRA_MAQUINA:-0}" != "1" ]; then
    meow_erro "a captura 'original' foi tirada de OUTRA máquina ($origem_cap)"
    meow_info "  aplicá-la aqui instalaria o tema de fábrica de outra pessoa e"
    meow_info "  apagaria as chaves que ela não tem."
    meow_info "  $2"
    [ -n "${3:-}" ] && meow_info "  $3"
    meow_info "  se é mesmo o tema de fábrica de outra máquina que você quer:"
    meow_info "      MEOW_TEMA_DE_OUTRA_MAQUINA=1 $1"
    return 1
  fi
  return 0
}

cmd_desfazer() {
  case "${1:-}" in --lancador) shift; desfazer_lancador; return $? ;; esac
  carregar_conf --ponte-opcional || return "$MEOW_ERRO"

  # O TEMA ANTERIOR DE QUEM INSTALOU NÃO É A CAPTURA 'original'
  #   `assets/temas/capturados/original/captura.txt` diz, na terceira linha, de qual home ela
  #   saiu — e está no git. Numa máquina estranha, aplicá-la instala o tema de
  #   fábrica DE OUTRA PESSOA e apaga toda chave que a captura não tenha, porque
  #   o `aplicar_tema.sh` remove o que sobra, de propósito.
  #   O tema de quem instalou está no PRIMEIRO backup que o `aplicar_tema.sh`
  #   guardou — e esse a poda não apaga.
  local primeiro="" d
  for d in "$MEOW_ESTADO"/backups/*-tema-PRIMEIRO-*; do
    [ -d "$d" ] && { primeiro="$d"; break; }
  done
  if [ -n "$primeiro" ]; then
    # O BACKUP DE ANTES PODE NÃO TER TEMA NENHUM — 24/09/2026, achado da P46.
    #   Numa máquina que nunca gravou tema do COSMIC, o primeiro backup nasce sem
    #   `com.system76.CosmicTheme.*`, e o `cp` de um glob vazio saía 2 com
    #   "Arquivo ou diretório inexistente". Antes do MeowSystem, aqui valia o
    #   tema de fábrica, sem nada gravado — é isso que se diz.
    local tem_tema=0 f
    for f in "$primeiro"/com.system76.CosmicTheme.*; do [ -e "$f" ] && { tem_tema=1; break; }; done
    if [ "$tem_tema" = "0" ]; then
      meow_info "o backup de antes ($(basename "$primeiro" | cut -c1-19)) não tem tema do COSMIC:"
      meow_info "  antes do MeowSystem esta máquina usava o tema de fábrica, sem nada gravado"
      return "$MEOW_OK"
    fi
    meow_info "devolvendo o COSMIC ao estado de $(basename "$primeiro" | cut -c1-19)"
    if [ -t 0 ] && [ "${MEOW_SIM:-0}" != "1" ]; then
      printf '  %sisto devolve o tema do COSMIC para antes do MeowSystem.%s\n' "$C_AMARELO" "$C_ZERO"
      printf '  continuar? (s/N) '
      local r=""
      read -r -t "${MEOW_TIMEOUT:-30}" r || true
      case "$r" in s|S|sim|Sim) ;; *) printf '\n  cancelado.\n'; return 0 ;; esac
    fi
    meow_travar || return "$MEOW_ERRO"
    if meow_seco; then
      meow_muda "copiaria $primeiro/com.system76.CosmicTheme.* para $COSMIC/"
      return "$MEOW_DIVERGENTE"
    fi
    cp -a "$primeiro"/com.system76.CosmicTheme.* "$COSMIC/" || return "$MEOW_ERRO"
    registrar "desfazer -> $primeiro"
    notificar "MeowSystem" "Tema devolvido ao estado de antes da instalação."
    meow_ok "pronto — o COSMIC relê por inotify, sem relogar"
    return "$MEOW_OK"
  fi

  # Sem backup, a captura 'original' é o último recurso — e só se ela for DESTA
  # máquina. Recusar é mais barato do que explicar depois de sobrescrever.
  if [ ! -d "$RAIZ/assets/temas/capturados/original" ]; then
    meow_erro "não há backup pré-instalação nem captura 'original'"
    meow_info "  isso quer dizer que o MeowSystem nunca escreveu tema aqui — nada a desfazer"
    return "$MEOW_SEM_DEPENDENCIA"
  fi
  # `MEOW_SIM` NÃO DESLIGA ESTA GUARDA — E DESLIGAVA, ATÉ 21/09/2026
  #   `MEOW_SIM=1` quer dizer "não pergunte", e era o que a condição abaixo lia
  #   como "pode aplicar o tema de outra pessoa". Os dois sentidos vinham
  #   colados, e quem os separava era o acaso de ninguém usar a variável — até
  #   que o painel passou a usar: `app/servidor.py` dispara o botão «Voltar ao
  #   tema de antes» com `ambiente: {"MEOW_SIM": "1"}`, porque a página já
  #   perguntou e o `read` daqui ficaria pendurado sem tty. O efeito colateral
  #   era o botão restaurar, sem avisar nada, o desktop de fábrica de
  #   `/home/<usuário>` — que é o que a captura versionada tem gravado.
  #
  #   A guarda passa a ser incondicional, e a porta de fuga ganha nome próprio:
  #   quem quer mesmo o tema de fábrica de outra máquina tem de dizer isso, e
  #   não "não me pergunte". Nenhum caminho automático a digita por engano.
  guarda_original "meow desfazer" \
    "o ponto de volta DESTA máquina nasce na primeira passagem do" \
    "./install.sh (etapa 'backup_tema') — rode-o uma vez e tente de novo." \
    || return "$MEOW_SEM_DEPENDENCIA"
  # Pergunta só quando há alguém para responder. Em automação (`| meow`, timer,
  # hook) segue sem perguntar — é a regra "zero pergunta em modo automático".
  if [ -t 0 ] && [ "${MEOW_SIM:-0}" != "1" ]; then
    printf '  %sisto devolve o tema do COSMIC para o tema "original".%s\n' "$C_AMARELO" "$C_ZERO"
    printf '  continuar? (s/N) '
    local resp=""
    read -r -t "${MEOW_TIMEOUT:-30}" resp || true
    case "$resp" in s|S|sim|Sim) ;; *) printf '\n  cancelado.\n'; return 0 ;; esac
  fi
  meow_travar || return "$MEOW_ERRO"
  "$RAIZ/scripts/aplicar_tema.sh" original; local rc=$?
  if [ "$rc" = "0" ] && ! meow_seco; then
    registrar "desfazer -> original"
    notificar "MeowSystem" "Tema devolvido para a captura original."
  fi
  return "$rc"
}

cmd_log() {
  local arq="$MEOW_ESTADO/meow.log"
  [ -f "$arq" ] || { meow_aviso "ainda não há log em $arq"; return "$MEOW_SEM_DEPENDENCIA"; }
  meow_titulo "Últimas 50 linhas — $arq"
  local l quando resto
  while IFS= read -r l; do
    quando="${l%% *}"; resto="${l#* }"
    case "$resto" in
      *falhou*|*erro*|*falhos=[1-9]*)
        printf '  %s%s%s %s%s%s\n' "$C_DIM" "$quando" "$C_ZERO" "$C_VERM" "$resto" "$C_ZERO" ;;
      *aplicad*|*consertou*|*mexeu=1*)
        printf '  %s%s%s %s%s%s\n' "$C_DIM" "$quando" "$C_ZERO" "$C_VERDE" "$resto" "$C_ZERO" ;;
      *)
        printf '  %s%s%s %s\n' "$C_DIM" "$quando" "$C_ZERO" "$resto" ;;
    esac
  done < <(tail -n 50 "$arq")
  printf '\n'
  return 0
}

# --- 8. o menu sem argumento ------------------------------------------------
# Itens montados a partir do estado REAL: as capturas que existem viram
# "tema <nome>", as variantes de logo viram "logo <nome>". Assim nenhum item do
# menu pede argumento — não há prompt para digitar, e não há como escolher um
# nome que não existe.
menu_itens() {
  printf 'status\tPainel de estado: flavor, accent, tema, ícones, papel de parede e o que está divergente.\n'
  printf 'doctor\tRoda todas as conferências em ensaio e lista as divergências. Não escreve nada.\n'
  printf 'doctor --consertar\tConfere e aplica só o que falhou. Não usa sudo e não baixa nada.\n'
  printf 'tema\tMostra o tema escolhido, o que está no ar, e os temas prontos.\n'
  local n
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf 'tema %s\tAplica o tema "%s" por cópia, sem passar pela GUI.\n' "$n" "$n"
  done < <(capturas)
  printf 'tema claro\tEscreve is_dark=false. Claro e escuro são o MESMO tema, com um interruptor.\n'
  printf 'tema escuro\tEscreve is_dark=true.\n'
  printf 'tema auto\tDeixa o horário decidir (claro das 7h às 18h, por padrão).\n'
  printf 'logo\tLista as variantes de logo do painel.\n'
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf 'logo %s\tTroca a logo do painel e o botão do dock para a variante %s.\n' "$n" "$n"
  done < <(logos_disponiveis)
  printf 'icones\tEstado do tema de ícones: qual está selecionado e quantos arquivos tem.\n'
  printf 'icones reconstruir\tRemonta MeowSystem-Icons e as pastas coloridas.\n'
  printf 'wallpaper\tEstado do carrossel: pasta, quantas imagens, intervalo e ordem.\n'
  printf 'apps\tTabela: módulo, app instalado, tema aplicado ou pendente.\n'
  printf 'leitura\tModo de leitura: que degrau o relógio pede AGORA, o que a tela mostra, e se o compositor já sabe ler os dois números.\n'
  printf 'leitura remover\tZera temperatura e textura e desarma o relógio do modo de leitura.\n'
  printf 'abrir\tAbre o painel de configuração visual no navegador: as chaves e as ações, com a saída ao vivo.\n'
  printf 'configurar\tPergunta chave por chave o que está no meow.conf. ENTER mantém; no fim grava e oferece aplicar.\n'
  printf 'aplicar\tRoda o install.sh inteiro. Idempotente: nada é escrito duas vezes.\n'
  printf 'log\tÚltimas 50 linhas do log do MeowSystem.\n'
  printf 'desfazer\tDevolve o tema do COSMIC para a captura "original".\n'
}

menu_numerado() {
  local -a cmds=() descs=()
  local linha desc
  while IFS=$'\t' read -r linha desc; do
    cmds+=("$linha"); descs+=("$desc")
  done < <(menu_itens)

  meow_titulo "meow"
  local i
  for i in "${!cmds[@]}"; do
    printf '  %s%2d%s  %-22s %s%s%s\n' "$C_MAUVE" "$((i+1))" "$C_ZERO" \
           "${cmds[$i]}" "$C_DIM" "${descs[$i]}" "$C_ZERO"
  done
  printf '\n'

  # Sem terminal não há escolha a fazer: listar e sair 0 é melhor do que
  # pendurar um hook ou um timer esperando um ENTER que nunca vem.
  if [ ! -t 0 ]; then
    meow_info "sem terminal interativo — rode 'meow <comando>' direto"
    return 0
  fi
  printf '  %sescolha (ENTER cancela):%s ' "$C_MAUVE" "$C_ZERO"
  local escolha=""
  read -r -t "${MEOW_TIMEOUT:-60}" escolha || { printf '\n'; return 0; }
  [ -n "$escolha" ] || { printf '  cancelado.\n'; return 0; }
  case "$escolha" in
    ''|*[!0-9]*) meow_erro "não é um número: $escolha"; return "$MEOW_ERRO" ;;
  esac
  [ "$escolha" -ge 1 ] && [ "$escolha" -le "${#cmds[@]}" ] || {
    meow_erro "fora da lista: $escolha"; return "$MEOW_ERRO"; }
  local -a partes=()
  read -r -a partes <<< "${cmds[$((escolha-1))]}"
  printf '\n  %s>>>%s meow %s\n\n' "$C_MAUVE" "$C_ZERO" "${partes[*]}"
  despachar "${partes[@]}"
}

cmd_menu() {
  carregar_conf || return "$MEOW_ERRO"
  # Sem terminal o fzf não roda — ele precisa de um tty para desenhar, e sem um
  # morre com "inappropriate ioctl for device" antes de mostrar coisa alguma.
  # Quem chama `meow` de um hook, de um timer ou dentro de um pipe cai no menu
  # numerado, que nesse caso só imprime a lista e sai 0.
  if ! meow_tem fzf || [ ! -t 0 ]; then
    menu_numerado
    return $?
  fi

  local selecao rc itens
  # Here-string em vez de `menu_itens | fzf`: com `pipefail`, um fzf que saia
  # antes de consumir a lista inteira (ENTER rápido) daria SIGPIPE no
  # menu_itens, a pipeline devolveria 141 e a escolha VÁLIDA dela seria
  # descartada como se fosse um ESC. É a mesma armadilha do conf_definir, e
  # neste caminho ela falharia de vez em quando — o pior jeito de falhar.
  itens="$(menu_itens)"
  # Mesmas medidas do conjurar.zsh (altura, borda, margem, cabeçalho, preview à
  # direita, --with-nth=1 sobre `comando<TAB>descrição`); a paleta é a nossa.
  selecao="$(fzf \
      --height=60% --layout=reverse --border=rounded \
      --margin=1 --padding=1 \
      --prompt="  Meow > " \
      --header="  ENTER executar | ESC sair" \
      --color="bg+:#313244,fg+:#cdd6f4,hl:#cba6f7,hl+:#f5c2e7,pointer:#a6e3a1,marker:#a6e3a1,prompt:#cba6f7,header:#6c7086,border:#6c7086" \
      --preview-window="right:50%:wrap" \
      --delimiter=$'\t' --with-nth=1 \
      --preview='printf "%s\n" {2}' <<< "$itens")"
  rc=$?
  # 130 = ESC/Ctrl-C. Cancelar não é erro.
  if [ "$rc" = "130" ]; then printf '  %scancelado.%s\n' "$C_DIM" "$C_ZERO"; return 0; fi
  if [ "$rc" != "0" ] || [ -z "$selecao" ]; then return 0; fi

  local cmd="${selecao%%$'\t'*}"
  local -a partes=()
  read -r -a partes <<< "$cmd"
  printf '\n  %s>>>%s meow %s\n' "$C_MAUVE" "$C_ZERO" "${partes[*]}"
  despachar "${partes[@]}"
}

# --- 9. ajuda e despacho ----------------------------------------------------
cmd_ajuda() {
  cat <<'FIM'

meow — Catppuccin para o COSMIC

  meow                         menu interativo (fzf; sem ele, menu numerado)
  meow status                  painel de estado e o que está divergente
  meow doctor                  confere tudo em seco. Sai 1 se houver divergência
  meow doctor --consertar      confere e aplica só o que falhou

  meow tema                    tema alvo, tema ativo e capturas disponíveis
  meow tema <captura>          aplica a captura por cópia (sem GUI)
  meow tema claro|escuro|auto  troca o modo e grava MODO no meow.conf
  meow tema capturar <nome>    fotografa o estado atual como captura <nome>
  meow tema desfazer           o mesmo que meow desfazer

  meow logo                    variantes de logo do painel
  meow logo <variante>         troca a logo do painel e o botão do dock
  meow logo listar             o acervo, quem está no ar e POR QUÊ (fase e janela)
  meow logo girar              passa ao próximo gato — só no modo LOGO_MODO="rotacao";
                               no padrão ("hora") quem manda é o relógio, e o
                               comando diz isso em vez de fingir efeito

  meow icones                  estado do tema de ícones
  meow icones reconstruir      remonta o tema e as pastas coloridas
  meow icones fonte <nome>     de onde sai aquele ícone, e o que deriva dele

  meow wallpaper               estado do carrossel
  meow wallpaper aplicar       liga/reafirma a rotação nativa do COSMIC
  meow wallpaper proximo       avança para a próxima imagem do grupo (fixa por 30m)
  meow wallpaper anterior      volta para a anterior
  meow wallpaper carrossel     solta a fixação e devolve a rotação agora
  meow files-menu              estado dos 2 itens de papel de parede no menu da área de trabalho
  meow files-menu build        compila o cosmic-files patchado da versão instalada
  meow wallpaper adicionar <alvo>   copia imagem ou pasta para ativos/
  meow wallpaper banir <img>   move para banidos/ (nunca apaga)
  meow wallpaper desbanir <nome>  devolve de banidos/ para ativos/ E tira do BANIDOS.txt
  meow wallpaper semear        baixa a coleção Catppuccin (commit pinado; usa rede)

  meow apps                    tabela: módulo, instalado, tema
  meow apps aplicar [slug]     tematiza um app, ou todos
  meow apps reverter <slug>    desfaz num app (só o spotify sabe hoje; slug obrigatório)

  meow pack                    os theme packs instalados, e se cada um valida
  meow pack info <id>          o que é próprio e o que é herdado no pack
  meow pack construir <id>     refaz o que o pack deriva, dentro do próprio pack
  meow pack sincronizar <id>   compara a arte copiada com a origem; só lê
                               (o --help do subcomando tem a lista inteira)

  meow leitura                 que degrau o modo de leitura pede agora
  meow leitura aplicar         põe o degrau da hora (o timer já faz sozinho)
  meow leitura remover         zera temperatura e textura, e desarma o timer

  meow compositor [--seco]     recompila o cosmic-comp com os patches de patches/ e
                               instala (sudo só no fim; vale no próximo login)
  meow compositor validar      confere se a série entra na versão instalada

  meow abrir                   abre o painel de configuração no navegador
                               (127.0.0.1, porta efêmera, token de sessão) — é a
                               mesma coisa que o ícone "MeowSystem" do lançador

  meow configurar              wizard curto: só as chaves essenciais
  meow configurar --tudo       pergunta o meow.conf inteiro, chave por chave
  meow configurar <CHAVE>      pergunta uma chave só (ex.: meow configurar ACCENT)
  meow ativar [--seco]         roda o install.sh inteiro (o mesmo que 'aplicar')
  meow aplicar [--seco]        idem — os dois nomes valem
  meow desfazer                volta o tema do COSMIC para antes do MeowSystem
  meow desfazer --lancador     devolve os .desktop de /usr/share ao estado do apt
  meow log                     últimas 50 linhas do log

Variáveis:
  MEOW_DRY_RUN=1    não escreve nada
  MEOW_RAIZ         onde está o clone do MeowSystem
  MEOW_RAIZ_EXTRA   um lugar a mais onde procurar o clone (ex.: outro disco)
  MEOW_CONF         outro meow.conf
  MEOW_SIM=1        não pergunta nada (o desfazer, e o "aplicar agora?" do wizard)
  MEOW_TEMA_DE_OUTRA_MAQUINA=1
                    deixa o desfazer aplicar uma captura tirada de outro home
  MEOW_TIMEOUT      segundos de espera em cada pergunta (300 no wizard)

Códigos de saída: 0 certo · 1 divergente · 2 erro · 3 falta dependência.

FIM
  return 0
}

# `meow painel` — a porta única para a barra. Ver scripts/painel.sh para o
# porquê de cada verbo; aqui só repassamos, para que exista UM nome a lembrar.
cmd_painel() {
  case "${1:-estado}" in
    conferir|teto|estado|reciclar|laco) "$RAIZ/scripts/painel.sh" "$1" ;;
    -h|--help)
      meow_titulo "meow painel"
      printf '  meow painel estado     diagnóstico de uma tela\n'
      printf '  meow painel teto       a conta do raio (altura, teto, compositor)\n'
      printf '  meow painel conferir   corta o raio no que cabe, se for preciso\n'
      printf '  meow painel reciclar   SIGTERM no painel, pela porta única\n\n'
      printf '  O supervisor roda como meow-painel.service; ele repõe a barra em\n'
      printf '  segundos quando ela cai, porque o cosmic-session desiste depois de\n'
      printf '  ~20 mortes na mesma sessão (o backoff dele não tem teto e nunca zera).\n'
      ;;
    *) meow_erro "verbo desconhecido: $1"; meow_info "veja: meow painel --help"; return "$MEOW_ERRO" ;;
  esac
}

# `meow leitura` — a porta única para o modo de leitura. Ver scripts/leitura.sh
# para o porquê de cada verbo; aqui só repassamos, para que exista UM nome a
# lembrar. `estado` é o padrão de propósito: quem digita `meow leitura` sem verbo
# está perguntando, não mandando.
cmd_leitura() {
  # O verbo vai para uma variável ANTES do `case`, e não é preciosismo: com
  # `set -u`, um `case "${1:-estado}"` que despacha `"$1"` morre em "variável não
  # associada" justamente no caminho sem argumento — que é o mais usado. O
  # `cmd_painel` logo acima tem esse defeito hoje (`meow painel` sozinho falha);
  # não é consertado aqui para não disputar o arquivo com outra frente, mas fica
  # dito, porque copiar o padrão dele seria herdar o bug.
  local verbo="${1:-estado}"

  # O `carregar_conf` NAO E OPCIONAL AQUI, e a falta dele mentia na tela.
  #   MEDIDO em 30/08/2026, com o timer JA armado e escrevendo de minuto em
  #   minuto: `meow leitura estado` imprimia `LEITURA_AGENDA=""` e a linha
  #   "o MeowSystem nao agenda nada" — enquanto o `meow.conf` dela dizia "sim" e
  #   o `meow-leitura.service` reconciliava a cada 60 s. O `chk_leitura` do
  #   doctor acertava, porque o `cmd_doctor` carrega o conf antes; este caminho
  #   nao carregava, e o `leitura.sh` caia no padrao vazio de `${LEITURA_AGENDA:-}`.
  #   Uma frase falsa na tela e pior que silencio: manda a pessoa procurar no
  #   lugar errado. O `cmd_painel` logo acima nao precisa disto (o `painel.sh`
  #   le o proprio estado em disco); este precisa, e todo comando que delegue a
  #   um script que le o meow.conf precisa.
  carregar_conf || return "$MEOW_ERRO"

  case "$verbo" in
    aplicar|conferir|estado|remover) "$RAIZ/scripts/leitura.sh" "$verbo" ;;
    -h|--help)
      meow_titulo "meow leitura"
      printf '  meow leitura estado     que degrau o relógio pede AGORA e o que a tela mostra\n'
      printf '  meow leitura conferir   0 conforme · 1 divergente · 4 escolha sua\n'
      printf '  meow leitura aplicar    põe o degrau da hora (o timer faz isto sozinho)\n'
      printf '  meow leitura remover    zera os dois números e desarma o timer\n\n'
      printf '  O horário mora no APPLET da topbar, não no meow.conf: as chaves\n'
      printf '  leitura_hora_inicio/fim de com.system76.CosmicComp. O applet só as\n'
      printf '  escreve quando você mexe nele; até lá vale o padrão do meow.conf —\n'
      printf '  e o estado diz na cara qual das duas fontes está mandando.\n\n'
      printf '  Quem PINTA é o cosmic-comp recompilado (etapa 1). Até ela deslogar\n'
      printf '  depois desse build, escrever aqui é inofensivo e não muda um pixel.\n'
      ;;
    *) meow_erro "verbo desconhecido: $verbo"; meow_info "veja: meow leitura --help"; return "$MEOW_ERRO" ;;
  esac
}

# `meow compositor` — a porta única para os patches do cosmic-comp. Nasceu em
# 24/09/2026 (P39), quando o build saiu do Ritual da Aurora e veio para o
# `scripts/compositor_patches.sh`; o porquê de cada passo mora lá. Aqui só se
# repassa, para que exista UM nome a lembrar.
#
# SEM VERBO, ELE COMPILA — ao contrário do `meow leitura` e do `meow painel`,
# que sem verbo mostram estado, e de propósito. É o
# comando que o doctor manda rodar quando a linha `patches` fica vermelha, e o
# que a pessoa lê ali é "rode: meow compositor". Um sem-verbo que só mostrasse
# estado mandaria digitar duas vezes para fazer a única coisa que a linha pede.
# O `--seco` diz o que faria sem baixar, compilar ou pedir senha.
#
# O LOCK SÓ ENTRA QUANDO ESCREVE: compilar de verdade leva minutos, e um
# `install.sh` do timer caindo no meio não tem o que fazer com um compositor
# pela metade na árvore de fonte. No seco e no `conferir` não há o que proteger.
cmd_compositor() {
  local verbo="compilar" seco="${MEOW_DRY_RUN:-0}"
  local -a resto=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seco|--dry-run) seco=1 ;;
      *) resto+=("$1") ;;
    esac
    shift
  done
  [ "${#resto[@]}" -gt 0 ] && verbo="${resto[0]}"

  case "$verbo" in
    compilar|validar)
      [ "$seco" = "1" ] || meow_travar || return "$MEOW_ERRO"
      MEOW_DRY_RUN="$seco" "$RAIZ/scripts/compositor_patches.sh" "$verbo" ;;
    conferir|reverter)
      MEOW_DRY_RUN="$seco" "$RAIZ/scripts/compositor_patches.sh" "$verbo" ;;
    -h|--help|ajuda)
      meow_titulo "meow compositor"
      printf '  meow compositor [--seco]   baixa o fonte da versão instalada, aplica a série de\n'
      printf '                             patches/, compila (~4 min) e instala — sudo só no fim\n'
      printf '  meow compositor validar    baixa o fonte e só roda o dry-run da série nele\n'
      printf '  meow compositor conferir   os marcadores no disco e na sessão (é a linha do doctor)\n'
      printf '  meow compositor reverter   diz como voltar ao binário do pacote\n\n'
      printf '  Ele só compila sobre uma versão que esteja em patches/versao, e diz por quê\n'
      printf '  quando recusa. O binário é também a tela de login: vale no próximo login.\n'
      ;;
    *) meow_erro "verbo desconhecido: $verbo"; meow_info "veja: meow compositor --help"; return "$MEOW_ERRO" ;;
  esac
}

# --- meow pack ---------------------------------------------------------------
#
# O verbo dos THEME PACKS. A especificação está em docs/PACKS.md, e o resolvedor
# é scripts/pack.py — este comando só põe um rosto nele.
#
# POR QUE ELE NÃO FAZ NADA SOZINHO
#   Quem entende o formato é um arquivo só (scripts/pack.py), de propósito: antes
#   da porta única, onze lugares liam a paleta e dez cravavam o nome do arquivo,
#   e o resultado não era erro — era divergência silenciosa. Repetir a leitura do
#   `pack.json` aqui em bash seria criar a segunda fonte de verdade que o formato
#   inteiro existe para não ter.
cmd_pack() {
  local acao="${1:-listar}"; shift 2>/dev/null || true
  case "$acao" in
    validar|--validar)
      local alvo="${1:-${PACK:-}}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        alvo="${PACK:-}"
      fi
      [ -n "$alvo" ] || { meow_erro "diga qual pack: meow pack validar <id-ou-caminho>"; return "$MEOW_ERRO"; }
      python3 "$RAIZ/scripts/pack.py" validar "$alvo"
      ;;
    info|informacao|informação)
      local alvo="${1:-${PACK:-}}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        # Sem PACK no conf, o alvo é o pack PADRÃO — perguntado, não digitado.
        # O nome dele mora em scripts/pack.py:PACK_PADRAO, e só lá. [22/09/2026]
        # SEM PACK, QUEM RESPONDE É A ADOÇÃO — 24/09/2026, sprint P45
        #   O `FLAVOR` também escolhe pack (a regra da P35, `adocao` do
        #   `scripts/pack.py`), e esta linha pulava direto para o padrão: com
        #   `PACK=""` e `FLAVOR="dracula"` a máquina vestia o Dracula e o `info`
        #   mostrava o Catppuccin. O `meow_pack_dir` é a porta do shell para
        #   aquela regra; vazio quer dizer "o padrão", e aí vale a linha de cima.
        alvo="${PACK:-$(meow_pack_dir)}"
        alvo="${alvo:-$(meow_pack_padrao_dir)}"
      fi
      python3 "$RAIZ/scripts/pack.py" info "$alvo"
      ;;
    listar|lista|ls)
      # Um pack é um diretório com pack.json. A lista sai do disco, não de um
      # registro: registro desatualiza e mente, diretório não.
      local achou=0 base d
      meow_titulo "Theme packs"
      while IFS= read -r base; do
        [ -d "$base" ] || continue
        for d in "$base"/*/; do
          [ -f "$d/pack.json" ] || continue
          achou=1
          local id nome
          id="$(basename "${d%/}")"
          nome="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["nome"])' "$d/pack.json" 2>/dev/null || echo "$id")"
          if python3 "$RAIZ/scripts/pack.py" validar "${d%/}" >/dev/null 2>&1; then
            meow_ok "$id — $nome"
          else
            meow_aviso "$id — $nome (não valida: meow pack validar $id)"
          fi
          printf '       %s\n' "${d%/}"
        done
      done < <(python3 "$RAIZ/scripts/pack.py" raizes)
      # A LINHA ESPECIAL SAIU EM 22/09/2026, E A LISTA FICOU MAIS HONESTA
      #   Havia aqui um `meow_info "catppuccin — Catppuccin (embutido, em
      #   assets/paleta/)"`, com um comentário dizendo que "o embutido não tem
      #   pack.json e não aparece na varredura — mas existe, e esconder isso
      #   faria a lista mentir por omissão". Era verdade, e era o sintoma: o
      #   pack padrão precisava de uma linha de código para aparecer numa lista
      #   que sai do DISCO. A P13 lhe deu um `pack.json`; agora ele aparece pela
      #   varredura, como qualquer outro, e a lista deixa de ter dois tipos de
      #   pack. Ver `PACK_PADRAO`, em scripts/pack.py.
      [ "$achou" = 1 ] || meow_pula "nenhum pack instalado"
      ;;
    # `construir` — o verbo que a P29 pediu, 22/09/2026
    #   Ele NÃO pega o `meow_travar`, e isso é escolha: o lock deste projeto
    #   guarda o que escreve na CONFIGURAÇÃO DELA (o ~/.config/cosmic, o tema, o
    #   lançador). `construir` escreve dentro de `packs/<id>/`, que é o
    #   repositório — o mesmo lugar onde um `git checkout` mexe sem pedir
    #   cadeado a ninguém. Segurar o lock aqui faria o timer das 05:00 esbarrar
    #   numa construção de ícone.
    #
    #   O ALVO É OBRIGATÓRIO, sem cair no PACK do conf. `validar` e `info` podem
    #   assumir o pack ativo porque só LEEM; este escreve, e "construí o que
    #   estava no meow.conf" é a surpresa que não se desfaz com um Ctrl+C.
    construir|build)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack construir: meow pack construir <id>"; return "$MEOW_ERRO"; }
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" construir "$alvo" ${seco[@]+"${seco[@]}"}
      ;;
    # `usar` — o verbo que faltava para o formato ser produto, P10, 23/09/2026
    #   Os verbos de cima leem, validam e constroem; nenhum dizia à máquina "use
    #   este". Trocar de pack era editar `PACK=` no meow.conf à mão — e o painel,
    #   que é onde uma pessoa leiga troca de tema, não tinha como fazer isso.
    #
    #   QUEM DECIDE É O `pack.py usar`, QUEM ESCREVE É A `meow_conf_definir`
    #     O id e o flavor saem do `plano_de_uso` (scripts/pack.py), que valida o
    #     pack com a régua do MOTOR antes de qualquer escrita — a mesma que o
    #     `meow_pack_dir` aplica, e que, reprovando, veste a máquina com o padrão
    #     em silêncio. A saída dele é lida com `sed`, e nunca com `eval`.
    #
    #   ELE APLICA, PORQUE "USAR" QUE NÃO VESTE A MÁQUINA É SÓ EDITAR UM ARQUIVO
    #     Depois de gravar, roda o `install.sh` inteiro (o `cmd_aplicar`): quais
    #     etapas rodam é decisão do meow.conf, e trocar de pack mexe em quase
    #     todas. `--sem-aplicar` grava e para — é o que o `tests/pack.sh` usa, e
    #     o que quem quer trocar mais coisas antes de aplicar precisa.
    #
    #   O ENSAIO ENSAIA A TROCA, E NÃO O PACK DE ANTES
    #     Com `MEOW_DRY_RUN=1` o meow.conf não é tocado — e um `install.sh` seco
    #     lendo o conf do disco ensaiaria o pack que JÁ está no ar, com cara de
    #     ensaio da troca. É o defeito que o `_conf_de_ensaio` do painel conta ter
    #     tido. O conserto é o mesmo de lá: as duas chaves vão para uma CÓPIA
    #     descartável do conf, e o instalador seco lê a cópia pelo `MEOW_CONF`.
    #
    #   SEM O CADEADO, E PELA MESMA RAZÃO DO `cmd_aplicar`: quem trava é o
    #     `install.sh`, e um `flock` aqui em cima faria o filho achar "outro meow
    #     rodando" — este processo. A gravação no conf também não o pega, como
    #     não pega no `meow tema claro`.
    usar|use)
      local alvo="" pedido="" aplicar=1 arg
      for arg in "$@"; do
        case "$arg" in
          --sem-aplicar) aplicar=0 ;;
          -h|--help)
            printf 'uso: meow pack usar <id> [flavor] [--sem-aplicar]\n\n'
            printf '  Grava PACK e FLAVOR no meow.conf e aplica. Sem flavor, fica o que\n'
            printf '  está no ar se ele for do pack; senão, o padrão do pack.\n'
            return 0 ;;
          -*) meow_erro "opção desconhecida: $arg"; meow_info "veja: meow pack usar --help"; return "$MEOW_ERRO" ;;
          *)
            if [ -z "$alvo" ]; then alvo="$arg"
            elif [ -z "$pedido" ]; then pedido="$arg"
            else meow_erro "sobrou um argumento: $arg"; return "$MEOW_ERRO"
            fi ;;
        esac
      done
      [ -n "$alvo" ] || {
        meow_erro "diga qual pack usar: meow pack usar <id> [flavor]"
        meow_info "os que existem: meow pack listar"
        return "$MEOW_ERRO"
      }
      # O FLAVOR DE AGORA VEM DO ARQUIVO, e não do `carregar_conf`: ele só serve
      # para decidir se fica, e subir o conf inteiro para dentro deste shell
      # exportaria as chaves de ANTES para o `install.sh` filho — que as
      # sobrescreve ao sourcear o conf novo, mas não sem motivo para desconfiar.
      local agora_pack agora_flavor plano novo_pack novo_flavor porque
      agora_pack="$(meow_conf_valor PACK || true)"
      agora_flavor="$(meow_conf_valor FLAVOR || true)"
      plano="$(FLAVOR="$agora_flavor" python3 "$RAIZ/scripts/pack.py" usar "$alvo" ${pedido:+"$pedido"})" \
        || { meow_info "nada foi gravado — o meow.conf continua como estava"; return "$MEOW_ERRO"; }
      novo_pack="$(sed -n 's/^PACK=//p' <<< "$plano")"
      novo_flavor="$(sed -n 's/^FLAVOR=//p' <<< "$plano")"
      porque="$(sed -n 's/^PORQUE=//p' <<< "$plano")"
      [ -n "$novo_pack" ] && [ -n "$novo_flavor" ] || {
        meow_erro "o scripts/pack.py não disse qual pack e qual flavor gravar"
        return "$MEOW_ERRO"
      }

      meow_titulo "Trocar de pack"
      campo "pack"   "${agora_pack:-(nenhum escrito — valia a adoção pelo FLAVOR)}  ->  $novo_pack"
      campo "flavor" "${agora_flavor:-(nenhum)}  ->  $novo_flavor ($porque)"

      # A TROCA, ESCRITA NUMA CÓPIA DO CONF ANTES DE TUDO. É o conf que a troca
      # vai deixar, e duas perguntas o leem antes de o de verdade ser tocado: o
      # que fica de outro pack (logo abaixo) e, no ensaio, o instalador seco.
      local copia texto
      copia="$(mktemp -d)" || return "$MEOW_ERRO"
      if [ -f "$CONF" ]; then texto="$(cat "$CONF")"; else texto="$(cat "$CONF_PADRAO")"; fi
      texto="$(meow_conf_texto_definir "$texto" PACK "$novo_pack")"
      texto="$(meow_conf_texto_definir "$texto" FLAVOR "$novo_flavor")"
      printf '%s\n' "$texto" > "$copia/meow.conf"

      # O QUE FICA DE OUTRO PACK, DITO ANTES DE APLICAR
      #   O verbo grava PACK e FLAVOR, e só: o meow.conf vence o pack
      #   (docs/PACKS.md, "Quem vence"), e um `ICONES_BASE="Dracula-Icones"`
      #   escrito por ela continua valendo depois da troca. Medido na primeira
      #   passagem desta sprint, num HOME de brinquedo com o conf desta máquina:
      #   `usar catppuccin` e o `btop-bat` foi procurar "Dracula Mocha", porque
      #   `MEOW_FAMILIA_PALETA="dracula"` ficou. Mudar essas chaves por ela seria
      #   decidir o que é gosto dela e o que é resto; calar seria deixar a
      #   máquina metade de cada pack sem uma palavra. Fica a lista.
      #
      #   A LISTA É A DO PAINEL, E NÃO UMA CÓPIA DA REGRA — 23/09/2026
      #     A primeira versão refazia a regra em `awk` ("o valor cita o pack de
      #     antes?") e perdia as duas exceções que o `_vestigio_de_pack`
      #     (app/servidor.py) aprendeu em 22/09. Medido pela revisão, com o conf
      #     de fábrica e o Catppuccin no ar: `usar dracula` imprimia "citando o
      #     pack «catppuccin»: CURSOR" e prometia a marca no painel, enquanto o
      #     painel respondia `None` — o `packs/dracula/pack.json` RECEITA
      #     `"tema": "catppuccin-mocha-light"`, e é o alarme falso que o
      #     `_declarado_pelo_pack` já tinha matado. E no sentido inverso, com
      #     `PACK=""` e um sabor no FLAVOR, o `awk` calava o que o painel marca,
      #     porque o `_pack_do_sabor` só existe lá.
      #     Duas cópias da mesma regra discordam no primeiro caso esquisito,
      #     então esta pergunta vai à função do painel — importada, como os
      #     testes já a importam —, lendo a CÓPIA acima: o painel julga contra o
      #     pack adotado AGORA, e o adotado de depois da troca é o novo.
      #     O painel só tem cartão para as chaves do meow.conf.exemplo; uma
      #     chave fora dele (a `MEOW_FAMILIA_PALETA` de cima é uma) é julgada
      #     pela mesma função, e a frase diz que ela não tem onde aparecer lá.
      local restos="" fora="" linha chave dono onde
      linha="$(MEOW_RAIZ="$RAIZ" MEOW_CONF="$copia/meow.conf" MEOW_CONF_PADRAO="$CONF_PADRAO" \
        python3 - "$RAIZ" 2>/dev/null <<'PY'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "app"))
import servidor
com_cartao = set()
for item in servidor.ler_esquema():
    com_cartao.add(item["chave"])
    if item.get("vestigio_de_pack"):
        print("%s\t%s\tcartao" % (item["chave"], item["vestigio_de_pack"]["pack"]))
for chave in sorted(servidor.valores_brutos()):
    v = None if chave in com_cartao else servidor._vestigio_de_pack(chave)
    if v:
        print("%s\t%s\tfora" % (chave, v["pack"]))
PY
      )" || meow_info "não consegui perguntar ao painel o que fica de outro pack — confira lá, depois da troca"
      while IFS=$'\t' read -r chave dono onde; do
        [ -n "$chave" ] || continue
        restos="${restos:+$restos, }$chave («$dono»)"
        [ "$onde" = "fora" ] && fora="${fora:+$fora, }$chave"
      done <<< "$linha"
      if [ -n "$restos" ]; then
        meow_aviso "continuam valendo, citando outro pack que não o «$novo_pack»: $restos"
        meow_info "  o meow.conf vence o pack, então elas seguem valendo; no painel, cada uma com cartão aparece como «Vestígio do pack»"
        [ -z "$fora" ] || meow_info "  sem cartão no painel, só no meow.conf: $fora"
      fi

      # O TEMA DO COSMIC ENTRA COMO DECISÃO, E NÃO COMO MANUTENÇÃO
      #   O `install.sh` aplica a captura com `--respeitar-gui`: na manutenção,
      #   o que a GUI derivou vence a foto, e é o certo. Numa TROCA DE PACK é o
      #   contrário, e o `aplicar_tema.sh` já diz isso com todas as letras ("numa
      #   DECISÃO dela ... a captura tem de vencer"). Medido na primeira versão
      #   deste verbo, num HOME de brinquedo, trocando Catppuccin por Dracula só
      #   pelo instalador: "tema 'dracula-mauve' aplicado: 103 escritos, 18 já
      #   estavam certos, 68 preservados da sua GUI" — os 68 eram o Catppuccin de
      #   antes, e o `meow status` terminava em "nenhum tema pronto confere".
      #   Aqui a captura do pack novo vai primeiro, sem a flag, como no `meow
      #   tema <nome>`; o instalador vem depois e a encontra aplicada.
      #   O cadeado é pego num SUBSHELL e morre com ele, antes do `install.sh`,
      #   que pega o dele.
      local par
      par="$novo_flavor-$(meow_conf_valor ACCENT || printf 'mauve')"
      aplicar_tema_da_troca() {
        (
          # O PAR NOVO VAI NO AMBIENTE, e não pelo conf: no painel este processo
          # herda o FLAVOR de ANTES (o `conf_exportada` exporta o conf inteiro),
          # a ponte preferiria o que veio no ambiente — e no ensaio o conf do
          # disco nem tem a troca.
          export PACK="$novo_pack" FLAVOR="$novo_flavor"
          meow_seco || meow_travar || exit "$MEOW_ERRO"
          meow_ponte_python >/dev/null || exit "$MEOW_ERRO"
          "$RAIZ/scripts/aplicar_tema.sh" "$par"
        )
        case "$?" in
          0|1) ;;
          3) meow_aviso "o pack «$novo_pack» não tem captura para '$par' — o tema do COSMIC não troca, e o instalador abaixo diz o que falta" ;;
          *) meow_aviso "o tema do COSMIC não trocou para '$par' — o instalador abaixo tenta de novo, do jeito dele" ;;
        esac
      }

      if meow_seco; then
        local rc_ensaio
        meow_muda "gravaria PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\" em $CONF — ensaio: o arquivo não é tocado"
        if [ "$aplicar" = "1" ]; then
          meow_info "o tema '$par' e o ensaio do instalador olham a troca, e não o conf do disco"
          aplicar_tema_da_troca
          MEOW_CONF="$copia/meow.conf" MEOW_DRY_RUN=1 "$RAIZ/install.sh"; rc_ensaio=$?
        else
          rc_ensaio="$MEOW_DIVERGENTE"
        fi
        rm -rf "$copia"
        return "$rc_ensaio"
      fi
      rm -rf "$copia"

      local rc_pack rc_flavor
      conf_definir PACK "$novo_pack"; rc_pack=$?
      conf_definir FLAVOR "$novo_flavor"; rc_flavor=$?
      if [ "$rc_pack" -ge 2 ] || [ "$rc_flavor" -ge 2 ]; then
        meow_erro "não consegui gravar em $CONF"
        return "$MEOW_ERRO"
      fi
      if [ "$rc_pack" = "0" ] && [ "$rc_flavor" = "0" ]; then
        meow_ok "o meow.conf já dizia PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\""
      else
        meow_muda "gravado em $CONF: PACK=\"$novo_pack\" e FLAVOR=\"$novo_flavor\""
        registrar "pack usar $novo_pack flavor=$novo_flavor"
      fi
      if [ "$aplicar" = "0" ]; then
        meow_info "aplicar fica para depois: meow aplicar"
        return 0
      fi
      meow_info "o tema do COSMIC primeiro, como decisão: '$par'"
      aplicar_tema_da_troca
      meow_info "agora o instalador inteiro, porque trocar de pack mexe em quase todas as etapas"
      cmd_aplicar
      ;;
    raizes|raízes)
      meow_info "onde o MeowSystem procura um pack, nesta ordem:"
      python3 "$RAIZ/scripts/pack.py" raizes | sed 's/^/       /'
      ;;
    # `sincronizar` — a regra 8 da P28, 23/09/2026
    #   A arte de terceiro entra no pack por CÓPIA, com a origem no
    #   `PROCEDENCIA.md` dele, e a cópia congela enquanto a origem anda — em
    #   23/09 o `Dracula-Icones` ainda era reconstruído pelo
    #   `rebuild_dracula_theme()` do Spellbook-OS, a partir de outro repositório
    #   (a P37 o desativou lá no mesmo dia). Este verbo relê as origens
    #   declaradas e diz qual lado andou; linha sem origem declarada é só
    #   registro, e é assim que o Dracula ficou desde a P43 (24/09).
    #
    #   ELE NÃO COPIA, e não tem opção que copie. Uma arte retocada aqui depois
    #   da cópia não pode ser apagada por um `git pull` de outro repositório;
    #   escolher entre o retoque e o upstream é decisão de autor. A saída
    #   imprime o `cp` e para ali. Por só LER, ele assume o pack ativo quando
    #   ninguém diz qual, como o `info` — é o `construir`, que escreve, que
    #   exige o nome.
    sincronizar|sync)
      local alvo="${1:-}"
      if [ -z "$alvo" ]; then
        carregar_conf 2>/dev/null || true
        alvo="$(meow_pack_dir)"
        [ -n "$alvo" ] || alvo="$(meow_pack_padrao_dir)"
      fi
      python3 "$RAIZ/scripts/pack.py" sincronizar "$alvo"
      ;;
    # `novo`, `exportar`, `importar` — o pack que viaja, P11, 23/09/2026
    #   A queixa: "que qualquer um possa exportar o próprio tema e importar
    #   outros". Os três moram no `scripts/pack.py`, pelo motivo do topo desta
    #   função; aqui só se põe o rosto e se traduz o `MEOW_DRY_RUN` em `--seco`,
    #   como o `construir` faz.
    #
    #   SÓ O `novo` LÊ O meow.conf, e com a ponte exigida: "o que está no ar" é
    #   o PACK/FLAVOR/ACCENT/SOM_* de lá, e sem a paleta resolvida não há do que
    #   partir. `exportar` e `importar` não dependem da máquina — um pack
    #   exporta igual em qualquer uma, e importar não troca o tema de ninguém.
    #
    #   AS OPÇÕES SEGUEM CRUAS ("$@") para o pack.py: a P16 acrescenta
    #   `novo <id> --de-csv <arquivo>` lá dentro, sem tocar nestas linhas. Com
    #   ele, o conf continua carregado e nada dele é usado — o pack de CSV não
    #   depende da máquina (ver `montar_novo`, no scripts/pack.py); separar os
    #   dois casos aqui seria ler as opções duas vezes, em duas linguagens.
    #
    #   Sem `meow_travar`, pelo motivo do `construir`: nenhum dos três escreve
    #   na configuração dela.
    novo|criar)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga o nome do pack novo: meow pack novo <id>"; return "$MEOW_ERRO"; }
      shift
      carregar_conf || return "$MEOW_ERRO"
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" novo "$alvo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    exportar|export)
      local alvo="${1:-}"
      [ -n "$alvo" ] || { meow_erro "diga qual pack exportar: meow pack exportar <id> [arquivo.meowpack]"; return "$MEOW_ERRO"; }
      shift
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" exportar "$alvo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    importar|import)
      local arquivo="${1:-}"
      [ -n "$arquivo" ] || { meow_erro "diga qual arquivo: meow pack importar <arquivo.meowpack|arquivo.csv>"; return "$MEOW_ERRO"; }
      shift
      local -a seco=()
      meow_seco && seco=(--seco)
      python3 "$RAIZ/scripts/pack.py" importar "$arquivo" "$@" ${seco[@]+"${seco[@]}"}
      ;;
    # `de-csv` — a paleta entra por CSV, 23/09/2026, sprint P16
    #   Imprime o `paleta.json` equivalente a um CSV `slot,flavor,hex`, com o
    #   claro derivado quando o CSV não traz um. SÓ IMPRIME, como o
    #   `logo-gerado`: quem põe o arquivo num pack é a pessoa, com `>`.
    #   Gravar o pack inteiro é o `meow pack novo <id> --de-csv <arquivo>`, ou o
    #   `meow pack importar <arquivo.csv>`, que é por onde a tela chega. Os dois
    #   entraram na segunda metade da P16 [23/09/2026], depois da P11 que trouxe
    #   o `novo` e o `importar`: são ramos DELES, no scripts/pack.py, e passam as
    #   opções cruas pelas linhas acima sem que elas mudassem.
    #
    #   UM ARGUMENTO SÓ, E O SEGUNDO É RECUSADO [revisão da P16, 23/09/2026].
    #   Os outros verbos ignoram o que sobra; este não pode, porque o segundo
    #   argumento de um conversor tem cara de destino: `de-csv cores.csv
    #   paleta.json` imprimia no terminal, e o paleta.json ficava como estava.
    de-csv|csv)
      local arq="${1:-}"
      [ -n "$arq" ] || { meow_erro "diga qual CSV: meow pack de-csv <cores.csv> > paleta.json"; return "$MEOW_ERRO"; }
      [ $# -eq 1 ] || { meow_erro "um CSV só, e o destino vai pelo '>': meow pack de-csv $arq > paleta.json"; return "$MEOW_ERRO"; }
      python3 "$RAIZ/scripts/pack.py" de-csv "$arq"
      ;;
    -h|--help|ajuda)
      printf 'uso: meow pack [listar|usar <id>|validar <id>|info <id>|construir <id>|sincronizar <id>|novo <id>|exportar <id>|importar <arquivo>|de-csv <arq>|raizes]\n\n'
      printf '  listar           os packs instalados, e se cada um valida\n'
      printf '  usar <id> [fl]   troca o pack da máquina: grava PACK e FLAVOR e aplica\n'
      printf '  validar <id>     confere o pack inteiro; 0 = ok\n'
      printf '  info <id>        o que é próprio e o que é herdado, categoria a categoria\n'
      printf '  construir <id>   refaz o que o pack deriva, escrevendo só dentro dele\n'
      printf '  sincronizar <id> compara a arte copiada com a origem; só lê, nunca copia\n'
      printf '  novo <id>        um pack seu, a partir do que está no ar; o resto ele herda\n'
      printf '    --de-csv <arq> a paleta vem do CSV slot,flavor,hex; o resto, do pack padrão\n'
      printf '  exportar <id> [arquivo.meowpack] [--sem-imagens]\n'
      printf '                   o pack num arquivo só, para mandar a alguém\n'
      printf '  importar <arquivo.meowpack|arquivo.csv>\n'
      printf '                   confere, e instala como opção — não troca o seu tema\n'
      printf '  de-csv <arq>     a paleta.json de um CSV slot,flavor,hex; só imprime\n'
      printf '  raizes           onde o MeowSystem procura\n\n'
      printf 'A especificação do formato está em docs/PACKS.md.\n'
      ;;
    *) meow_erro "verbo desconhecido: $acao"; meow_info "veja: meow pack --help"; return "$MEOW_ERRO" ;;
  esac
}

despachar() {
  case "${1:-}" in
    ""|menu)          cmd_menu ;;
    status|estado)    shift; cmd_status "$@" ;;
    doctor|medico)    shift; cmd_doctor "$@" ;;
    tema)             shift; cmd_tema "$@" ;;
    logo)             shift; cmd_logo "$@" ;;
    icones|ícones)    shift; cmd_icones "$@" ;;
    cursor|ponteiro)  shift; cmd_cursor "$@" ;;
    areas|áreas|area) shift; cmd_areas "$@" ;;
    fontes|fonte)     shift; cmd_fontes "$@" ;;
    wallpaper|parede) shift; cmd_wallpaper "$@" ;;
    files-menu|menu-arquivos) shift
      carregar_conf || exit "$MEOW_ERRO"
      case "${1:-estado}" in
        build|aplicar) meow_travar || exit "$MEOW_ERRO" ;;
      esac
      FILES_MENU="${FILES_MENU:-sim}" FILES_MENU_AUTOBUILD="${FILES_MENU_AUTOBUILD:-sim}" \
        "$RAIZ/scripts/files_menu.sh" "${1:-estado}"; exit $? ;;
    apps)             shift; cmd_apps "$@" ;;
    # `configurar` é o wizard. Ele NÃO é o padrão de nada: o `install.sh` sem
    # argumento continua sem perguntar, porque roda em timer e por script.
    configurar|config|wizard) shift; cmd_configurar "$@" ;;
    # `ativar` é o nome que ela procurou quando quis "rodar o install sem flag".
    # Não é comando novo: é o mesmo `aplicar`, com o nome que veio à cabeça
    # primeiro. Um sinônimo custa uma linha; lembrar do verbo certo custa uma
    # busca no --help toda vez.
    painel)           shift; cmd_painel "$@" ;;
    pack|packs)       shift; cmd_pack "$@" ;;
    leitura)          shift; cmd_leitura "$@" ;;
    compositor)       shift; cmd_compositor "$@" ;;
    # `abrir` sobe o painel de configuração visual (a pasta `app/`). É `exec`, e
    # não uma chamada comum, porque o `run.sh` FICA DE PÉ: ele sobe o servidor,
    # abre o navegador e espera. Deixar este processo pendurado por baixo dele
    # daria dois `meow` na árvore para uma coisa só, e um Ctrl+C teria de
    # atravessar os dois para chegar ao servidor.
    #
    # NÃO PEGA O LOCK, e é a mesma razão do `cmd_aplicar`: quem trava é o que o
    # painel dispara (o `install.sh`, o `doctor --consertar`), lá dentro. Um
    # `flock` do lado de cá deixaria a página inteira segurando o cadeado
    # enquanto ela lê a tela — e o timer das 5h esbarraria nele.
    abrir|app)        shift; exec "$RAIZ/app/run.sh" "$@" ;;
    aplicar|ativar)   shift; cmd_aplicar "$@" ;;
    desfazer)         shift; cmd_desfazer "$@" ;;
    log)              shift; cmd_log "$@" ;;
    ajuda|-h|--help|help) cmd_ajuda ;;
    *) meow_erro "comando desconhecido: $1"
       meow_info "veja: meow --help  (ou 'meow' sem argumento para o menu)"
       return "$MEOW_ERRO" ;;
  esac
}

# Mesma guarda do install.sh, pelo mesmo motivo: `sudo meow ativar` chama o
# install.sh, e `sudo meow tema X` escreve em ~/.config/cosmic com dono root —
# a GUI de tema passa a falhar EM SILÊNCIO e o conserto é um chown -R.
if [ "$(id -u)" = "0" ]; then
  meow_erro "não me rode com sudo."
  meow_info "  rode como o seu usuário normal:  meow ${1:-status}"
  exit 2
fi

despachar "$@"
