# As duplicatas do lançador — o par "(Local)"/"(Sistema)" — e os aplicativos que
# são dependência de pacote, não programa que se abre.
#
# ENTROU AQUI PORQUE SE PERDIA CALADO, como o vidro ao maximizar e a tela de
# login. MEDIDO em 08/08/2026: o `google-chrome`, o `syncthing-start` e o
# `syncthing-ui` estavam de volta no lançador dela, e nenhum verificador olhava
# para isso — o `install.sh` tinha a etapa, o `doctor` não tinha a conferência.
# O `NoDisplay=true` precisa morar no arquivo do apt (o cosmic-app-library NÃO
# deduplica por ID: um override no home deixa os DOIS à mostra), e todo upgrade
# do pacote devolve o original — o `google-chrome.desktop` foi reescrito em
# 05/08 17:17. Ou seja: isto volta sozinho, e volta em silêncio.
#
# CONFERE, MAS NÃO CONSERTA — e a omissão é deliberada
#   O conserto escreve em `/usr/share` com sudo, e o cabeçalho deste arquivo diz
#   que o `doctor` NUNCA usa sudo. Um `--consertar` pedindo senha às 5h da manhã,
#   disparado pelo timer, penduraria a unidade num prompt que ninguém responde.
#   Então ele acusa e manda rodar `meow ativar`, que anuncia o comando exato
#   antes de pedir a senha.
chk_ocultar() {
  MEOW_DRY_RUN=1 "$RAIZ/scripts/ocultar_apps.sh" 2>&1
}

# O gatilho que reaplica o `ocultar` depois de todo apt. Confere, e como tudo que
# mora fora do home, não conserta — instalar em `/etc/apt/apt.conf.d` e
# `/usr/local/sbin` usa sudo, e o doctor nunca usa (mesma razão do `ocultar`).
#
# CONFERE OS DOIS ARQUIVOS, E O CONTEÚDO DE AMBOS
#   Só existir não basta: o wrapper carrega o caminho do clone e o nome da dona
#   substituídos no install. Se o repositório mudar de lugar — ou se o wrapper
#   ganhar uma correção aqui — o arquivo em `/usr/local/sbin` fica velho, o hook
#   continua chamando, e o reaplique passa a apontar para um `ocultar_apps.sh`
#   que não existe mais. Um gatilho que dispara para o vazio é pior que gatilho
#   nenhum: ele parece instalado na tabela do doctor.
# A PONTE ROOT — 08/09/2026
#   Pedido dela: *"usar sudo só na instalação e criar um perfil naquele conf.d ...
#   aquele que só preciso uma vez e fica lá registrado pra sempre"*.
#
#   São TRÊS peças, e meia-instalação é o estado que mais engana: a ponte sem a
#   regra pede senha (e o painel, sem terminal, não tem como pedir); a regra sem
#   a ponte aponta para o vazio. Por isso a conferência não pergunta "os arquivos
#   existem?" — ela USA a ponte, com `sudo -n`, que é a única coisa que responde
#   pela verdade do sudo em vez de por uma suposição sobre ele.
chk_ponte() {
  local ponte=/usr/local/lib/meowsystem/ponte_root.sh
  local regra=/etc/sudoers.d/49-meowsystem-ponte
  local origem="$RAIZ/scripts/ponte_root.sh"

  if [ "${PONTE_ROOT:-sim}" != "sim" ]; then
    if [ -e "$ponte" ] || [ -e "$regra" ]; then
      meow_muda 'PONTE_ROOT="nao" mas a ponte root continua instalada'
      return "$MEOW_DIVERGENTE"
    fi
    meow_pula 'PONTE_ROOT="nao" — cada conserto de sistema pede senha no terminal'
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  [ -x "$ponte" ] || { meow_muda "falta $ponte"; return "$MEOW_DIVERGENTE"; }
  [ -f "$regra" ] || { meow_muda "falta $regra — a ponte existe e ainda pede senha"; return "$MEOW_DIVERGENTE"; }

  # O ARQUIVO INSTALADO TEM DE SER O DO REPOSITÓRIO. Uma ponte velha em
  # `/usr/local/lib` com a regra nova é o modo de falha silencioso deste
  # desenho: os verbos que a regra libera podem já não existir lá dentro.
  cmp -s "$origem" "$ponte" 2>/dev/null ||
    { meow_muda "$ponte diverge do repositório"; return "$MEOW_DIVERGENTE"; }

  if ! sudo -n "$ponte" estado >/dev/null 2>&1; then
    meow_muda "a regra existe e o sudo ainda pede senha para a ponte"
    return "$MEOW_DIVERGENTE"
  fi

  local raiz_reg
  raiz_reg="$(sudo -n "$ponte" estado 2>/dev/null | sed -n 's/^raiz=//p')"
  if [ "$raiz_reg" != "$RAIZ" ]; then
    meow_muda "o perfil da ponte aponta para '$raiz_reg', e o clone está em '$RAIZ'"
    return "$MEOW_DIVERGENTE"
  fi

  meow_ok "ponte root no ar — o conserto de sistema não pede senha"
  return 0
}

chk_lancadorapt() {
  local hook=/etc/apt/apt.conf.d/99-meow-lancador
  local wrapper=/usr/local/sbin/meow-lancador-apt.sh

  if [ "${LANCADOR_SISTEMA:-nao}" != "sim" ]; then
    if [ -f "$hook" ] || [ -f "$wrapper" ]; then
      # SÓ É DIVERGÊNCIA SE ELA ESCREVEU "nao". Sem a chave no arquivo, o hook
      # instalado não contradiz nada — e acusar divergência aqui armaria o
      # auto-reparo para apagá-lo todo dia às 5h, que é exatamente o estrago que
      # o `meow_conf_diz` existe para não deixar acontecer.
      if meow_conf_diz LANCADOR_SISTEMA nao; then
        meow_muda 'LANCADOR_SISTEMA="nao" mas o hook de apt continua instalado'
        return "$MEOW_DIVERGENTE"
      fi
      meow_pula "o hook de apt está instalado e o meow.conf não diz nada — fica como está"
      return "$MEOW_SEM_DEPENDENCIA"
    fi
    meow_pula 'LANCADOR_SISTEMA="nao" — sem reaplique após apt'
    return "$MEOW_SEM_DEPENDENCIA"
  fi

  [ -f "$hook" ]    || { meow_muda "falta $hook";    return "$MEOW_DIVERGENTE"; }
  [ -f "$wrapper" ] || { meow_muda "falta $wrapper"; return "$MEOW_DIVERGENTE"; }

  cmp -s "$RAIZ/scripts/99-meow-lancador" "$hook" 2>/dev/null ||
    { meow_muda "$hook diverge do repositório"; return "$MEOW_DIVERGENTE"; }

  local esperado
  esperado="$(sed -e "s|@ACERVO@|$RAIZ|g" \
                  -e "s|@USUARIA@|$(id -un)|g" \
                  -e "s|@LAR@|$HOME|g" "$RAIZ/scripts/meow-lancador-apt.sh")"
  [ "$(cat "$wrapper" 2>/dev/null)" = "$esperado" ] ||
    { meow_muda "$wrapper diverge do repositório (o clone mudou de lugar?)"; return "$MEOW_DIVERGENTE"; }

  meow_ok "o lançador se reaplica sozinho após cada apt"
  return 0
}

# Os nomes compridos que quebravam em duas linhas no lançador. Confere sempre; o
# conserto é PARCIAL de propósito.
#
# POR QUE `--sem-sudo` NO FIX, E POR QUE ISSO NÃO É O CASO DO `ocultar`
#   Metade da lista mora no home dela (os atalhos da Steam, o Hefesto) e nos
#   exports do flatpak (o GIMP, o CosmicTweaks) — e essa metade se perde sozinha:
#   um `flatpak update` recria o symlink de export e o nome comprido volta.
#   Deixá-la sem conserto seria exigir um `meow ativar` na mão por causa de um
#   update de flatpak. Com `--sem-sudo` o script NUNCA invoca sudo: os de
#   `/usr/share` ele nem tenta, só conta e manda rodar `meow ativar`. Sem sudo
#   não há prompt, e sem prompt o timer das 5h não tem como pendurar — que é a
#   única razão pela qual o `ocultar` não tem conserto nenhum.
chk_nomes() {
  "$RAIZ/scripts/nomes_apps.sh" --conferir 2>&1
}

# O vigia de `assets/gatos/` — as unidades `meow-assets.path`/`.service`. Confere
# o TEXTO da unidade (com o `@ACERVO@` já substituído, como o instalador grava) e
# se o gatilho está ligado e não-falho. Não usa `MEOW_DRY_RUN=1`: o `--conferir`
# do script já é a leitura pura, e o seco lá dentro dá no mesmo caminho.
chk_assets() {
  ASSETS_VIGIA="${ASSETS_VIGIA:-sim}" "$RAIZ/scripts/vigia_assets.sh" --conferir 2>&1
}

# O atalho do painel de configuração — o `.desktop` "MeowSystem" do lançador e o
# `~/.local/bin/meow-painel` que ele executa. Confere o TEXTO dos dois e o bit de
# execução do segundo, que é a única divergência que não aparece no conteúdo: um
# lançador sem `+x` é um ícone que abre e fecha na mesma hora, sem nada na tela
# explicando por quê.
#
# NÃO SE CHAMA `chk_app`, E ISSO NÃO É CAPRICHO: `apps` (plural) já é a linha dos
# aplicativos que o projeto tematiza, e `app`/`apps` lado a lado nesta tabela
# seriam duas linhas que ninguém lê duas vezes sem errar qual é qual. O nome é o
# do que a etapa de fato instala — o atalho.
chk_atalho() {
  "$RAIZ/scripts/atalho.sh" --conferir 2>&1
}

# O DESENHO DELA CONTRA O QUE OS RENDERIZADORES SABEM DESENHAR.
#   Nasceu em 01/09/2026: ela pôs dentes nos dois gatos no Boxy SVG, salvou, e
#   toda a pipeline funcionou sem mostrar os dentes em lugar nenhum. A causa era
#   `transform-box: fill-box` + `transform-origin`, SVG 2 que nem o librsvg (o
#   dock, o `.ansi` do terminal) nem o resvg (o ícone de tema do COSMIC)
#   implementam — a peça ia parar fora do viewBox, calada.
#
#   `normalizar_svg.py --conferir` não escreve: devolve 1 quando há o que
#   achatar, e também quando alguma peça cai INTEIRA fora da tela por qualquer
#   outro motivo. A segunda metade é o que faz esta checagem valer para o
#   defeito que ainda não aconteceu.
#
#   As pastas são as que ELA desenha. O resto de `assets/icones/` é acervo de
#   terceiro (25 mil arquivos do Arcticons e do Catppuccin): varrer aquilo aqui
#   custaria segundos a cada rodada do doctor para conferir arte que não é nossa
#   e que ninguém edita.
chk_svg() {
  meow_tem python3 || { echo "python3 não está aqui — nada a conferir"; return 0; }
  local pastas=() p
  for p in assets/gatos assets/icones/autorais assets/icones/overrides; do
    [ -d "$RAIZ/$p" ] && pastas+=("$RAIZ/$p")
  done
  # OS AUTORAIS DE CADA PACK ENTRAM JUNTO — 22/09/2026
  #   A P27 desceu os 55 desenhos de `assets/icones/autorais/` para dentro dos
  #   packs. Sem estas linhas o vigia continuaria verde conferindo só os oito de
  #   `autorais/leitura/` que sobraram — e o `transform-origin` achatado que ele
  #   existe para caçar passaria despercebido justamente nos desenhos dela.
  #   O porquê de ser SÓ `autorais/`, e por glob em vez de lista de nomes, está
  #   no gêmeo desta linha em `install.sh`, na `etapa_svg`.
  for p in "$RAIZ"/packs/*/icones/autorais; do
    [ -d "$p" ] && pastas+=("$p")
  done
  [ "${#pastas[@]}" -gt 0 ] || return 0
  local saida rc
  saida="$(python3 "$RAIZ/scripts/normalizar_svg.py" --conferir "${pastas[@]}" 2>&1)"; rc=$?
  if [ "$rc" = "0" ]; then
    # Uma linha em verde vale a contagem: "ok svg" seco não distingue "conferi
    # e está tudo no lugar" de "não conferi nada", e é a segunda que envelhece
    # calada quando alguém renomeia uma pasta.
    printf '%s desenho(s) nossos conferem com o que o painel sabe desenhar\n' \
      "$(find "${pastas[@]}" -name '*.svg' 2>/dev/null | wc -l)"
    return 0
  fi
  printf '%s\n' "$saida"
  return "$rc"
}

# O gatilho de flatpak — as unidades `meow-flatpak.path`/`.service`. Mesma leitura
# do `assets`: o TEXTO das unidades e se o gatilho está ligado e não-falho. Vão
# por cópia byte a byte (não têm marcador a substituir, ao contrário do
# `meow-assets.path`), então a comparação é direta.
chk_flatpak() {
  FLATPAK_VIGIA="${FLATPAK_VIGIA:-sim}" "$RAIZ/scripts/vigia_flatpak.sh" --conferir 2>&1
}

